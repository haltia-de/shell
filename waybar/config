{
  "layer": "top",
  "position": "left",
  "width": 120,
  "spacing": 4,
  "modules-left": [
    "custom/home",
    "custom/firefox",
    "custom/max"
  ],
  "modules-right": [
    "custom/status",
    "custom/clock",
    "custom/hide"
  ],
  "custom/home": {
    "exec": "/usr/libexec/haltia/haltia-meter home",
    "return-type": "json",
    "format": "{text}",
    "signal": 8,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press home 8; /usr/libexec/haltia/haltia-home toggle",
    "tooltip": false
  },
  "custom/firefox": {
    "exec": "/usr/bin/haltia-launch status firefox",
    "return-type": "json",
    "format": "{text}",
    "signal": 1,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press firefox 1; /usr/bin/haltia-launch tap firefox",
    "tooltip": false
  },
  "custom/calc": {
    "exec": "/usr/bin/haltia-launch status calc",
    "return-type": "json",
    "format": "{text}",
    "signal": 2,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press calc 2; /usr/bin/haltia-launch tap calc",
    "tooltip": false
  },
  "custom/weather": {
    "exec": "/usr/bin/haltia-launch status weather",
    "return-type": "json",
    "format": "{text}",
    "signal": 5,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press weather 5; /usr/bin/haltia-launch tap weather",
    "tooltip": false
  },
  "custom/news": {
    "exec": "/usr/bin/haltia-launch status news",
    "return-type": "json",
    "format": "{text}",
    "signal": 6,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press news 6; /usr/bin/haltia-launch tap news",
    "tooltip": false
  },
  "custom/max": {
    "exec": "/usr/bin/haltia-launch status max",
    "return-type": "json",
    "format": "{text}",
    "signal": 7,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press max 7; /usr/bin/haltia-launch tap max",
    "tooltip": false
  },
  "custom/paint": {
    "exec": "/usr/bin/haltia-launch status paint",
    "return-type": "json",
    "format": "{text}",
    "signal": 4,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press paint 4; /usr/bin/haltia-launch tap paint",
    "tooltip": false
  },
  "custom/cards": {
    "exec": "/usr/bin/haltia-launch status cards",
    "return-type": "json",
    "format": "{text}",
    "signal": 3,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press cards 3; /usr/bin/haltia-launch tap cards",
    "tooltip": false
  },
  "custom/status": {
    "exec": "/usr/libexec/haltia/haltia-meter status",
    "return-type": "json",
    "format": "{text}",
    "interval": 30,
    "exec-on-event": true,
    "on-click-release": "/usr/libexec/haltia/haltia-press status 10; /usr/bin/haltia-ask status",
    "tooltip": false,
    "signal": 10
  },
  "custom/clock": {
    "exec": "/usr/libexec/haltia/haltia-clock",
    "return-type": "json",
    "format": "{text}",
    "interval": 15,
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press clock; /usr/bin/haltia-launch tap calendar",
    "tooltip": false,
    "align": 0.5,
    "justify": "center"
  },
  "custom/hide": {
    "exec": "/usr/libexec/haltia/haltia-meter hide",
    "return-type": "json",
    "format": "{text}",
    "exec-on-event": false,
    "on-click-release": "/usr/libexec/haltia/haltia-press hide 0; /usr/libexec/haltia/haltia-tab",
    "tooltip": false
  }
}
