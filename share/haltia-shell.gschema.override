# haltia-shell's defaults for GTK's file chooser (MAX's «Сохранить как» and
# «Папка для файлов», Firefox): the folder the program names, else the
# last one, not «Недавние»; folders first; no size or type column, so the
# name has the room. Installed as
# /usr/share/glib-2.0/schemas/91-haltia-shell.gschema.override.
[org.gtk.Settings.FileChooser]
startup-mode='cwd'
sort-directories-first=true
show-size-column=false
show-type-column=false
sidebar-width=300

# The shell's GTK theme for every GTK 3 program, however it starts: the
# session exports GTK_THEME=Haltia, but a program started by D-Bus
# activation, from a terminal or by another service may not have it, and
# GTK then takes this key (it said Adwaita: the header's room for «✕» was
# gone).
[org.gnome.desktop.interface]
gtk-theme='Haltia'

# No GTK animations: every frame is drawn by the CPU, and a press, a page
# turn or a revealer cost 8 to 15 frames over about 200 ms instead of one
# (haltia-de/haltia docs/research/2026-10-26-gtk3-performance.md, 2.2). GTK 3
# on Wayland reads gtk-enable-animations from this key. It is only a default:
# a value one set in dconf still wins, and should something start writing it
# there, haltia-launcher would have to reset it as it does the chooser's keys.
enable-animations=false
