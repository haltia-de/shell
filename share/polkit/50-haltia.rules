// Haltia: the person at the tablet sets the date, the time and the time
// zone from Настройки (haltia-settings, through timedated) without an
// administrator's password: the active local session of a member of
// wheel, as the session user is.
polkit.addRule(function(action, subject) {
	if (action.id.indexOf("org.freedesktop.timedate1.") == 0 &&
	    subject.local && subject.active && subject.isInGroup("wheel")) {
		return polkit.Result.YES;
	}
});
