#!/bin/sh
# Waybar status for the home button, the status card (one module: the Wi-Fi
# icon, the volume and the 4-bar battery as classes, which the style
# haltia-apps writes draws as three icons on it) and the hide button.
# Always prints one JSON line and exits 0, so the icon cannot disappear.
set -u

# out ID CLASS...: one JSON line; haltia-press marks a tap for 300 ms, which
# adds the class "pressed".
out() {
	id=$1
	shift
	[ -e "${XDG_RUNTIME_DIR:-/tmp}/haltia/press/$id" ] && set -- "$@" pressed
	list=
	for c in "$@"; do
		list="$list${list:+,}\"$c\""
	done
	printf '{"text":" ","class":[%s]}\n' "$list"
}

wifi_class() {
	# w0 is disconnected. w1..w4 are four signal bars, same idea as the battery.
	# wx: associated, but the gateway does not answer (b8k-netwatch).
	class=w0
	if [ -r /sys/class/net/wlan0/operstate ] && [ -r /sys/class/net/wlan0/carrier ]; then
		op=$(cat /sys/class/net/wlan0/operstate 2>/dev/null || echo down)
		car=$(cat /sys/class/net/wlan0/carrier 2>/dev/null || echo 0)
		if [ "$op" = "up" ] && [ "$car" = "1" ]; then
			bars=1
			sig=$(iw dev wlan0 link 2>/dev/null | awk '/signal:/ { print $2; exit }')
			case $sig in
				''|*[!0-9-]*) ;;
				*)
					if [ "$sig" -ge -55 ]; then
						bars=4
					elif [ "$sig" -ge -67 ]; then
						bars=3
					elif [ "$sig" -ge -75 ]; then
						bars=2
					fi
					;;
			esac
			class=w$bars
			[ "$(cat /run/b8k-net/state 2>/dev/null)" = down ] && class=wx
		fi
	fi
	echo "$class"
}

# battery_info: "PERCENT STATE" of the battery, STATE charging, full or
# discharging; nothing without one. From upower's display device (as GNOME
# and Phosh show it), else the first power supply of type Battery.
battery_info() {
	if command -v upower >/dev/null 2>&1; then
		upower -i /org/freedesktop/UPower/devices/DisplayDevice 2>/dev/null | awk '
			/^ *present:/ { present = ($2 == "yes") }
			/^ *state:/ { state = $2 }
			/^ *percentage:/ { gsub(/[%,]/, "", $2); pct = int($2) }
			END {
				if (!present || state == "" || state == "unknown") exit 1
				if (state == "charging" || state == "pending-charge") state = "charging"
				else if (state == "fully-charged") state = "full"
				else state = "discharging"
				print pct, state
			}' && return 0
	fi
	for d in /sys/class/power_supply/*; do
		[ "$(cat "$d/type" 2>/dev/null)" = Battery ] || continue
		cap=$(cat "$d/capacity" 2>/dev/null)
		case $(cat "$d/status" 2>/dev/null) in
		Charging) state=charging ;;
		Full) state=full ;;
		*) state=discharging ;;
		esac
		case $cap in '' | *[!0-9]*) continue ;; esac
		echo "$cap $state"
		return 0
	done
	return 1
}

battery_class() {
	info=$(battery_info) || { echo none; return; }
	cap=${info%% *} state=${info#* }
	[ "$cap" -gt 100 ] && cap=100
	# 1-25, 26-50, 51-75, 76-100 -> 1..4 bars. 0 stays empty.
	bars=$(( (cap * 4 + 99) / 100 ))
	[ "$bars" -gt 4 ] && bars=4
	# bN is the level. cN is the same level while the supply is charging or
	# full. low: 15 % or less and not charging, the one red battery. none:
	# no battery (a desktop), no icon.
	case $state in
		charging|full) class=c$bars ;;
		*) class=b$bars; [ "$cap" -le 15 ] && class=low ;;
	esac
	echo "$class"
}

volume_class() {
	# v0 is muted or 0%. v1..v4 are four waves, a quarter of the range each,
	# same idea as the Wi-Fi bars.
	vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk -F/ '/Volume/ { gsub(/[ %]/, "", $2); print $2; exit }')
	mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{ print $2 }')
	case $vol in
		''|*[!0-9]*) echo v0; return ;;
	esac
	if [ "$vol" -eq 0 ] || [ "$mute" = yes ] || [ "$mute" = да ]; then
		class=v0
	else
		# 1-25, 26-50, 51-75, 76-100 -> 1..4 waves.
		w=$(( (vol * 4 + 99) / 100 ))
		[ "$w" -gt 4 ] && w=4
		class=v$w
	fi
	echo "$class"
}

case ${1:-} in
	status) out status "$(wifi_class)" "$(volume_class)" "$(battery_class)" ;;
	battery-info) battery_info ;;
	hide) out hide idle ;;
	home)
		# Lit while the home screen is up over the windows (haltia-home).
		if [ -e "${XDG_RUNTIME_DIR:-/tmp}/haltia/home.raised" ]; then
			out home raised
		else
			out home idle
		fi
		;;
	*) printf '{"text":" ","class":["w0","v0","b0"]}\n' ;;
esac
exit 0
