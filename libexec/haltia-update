#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""Updates with a way back, for Haltia (docs/plan-updates.md). Root; the
session user runs it through doas without a password (z-haltia-shell.conf).

    haltia-update check              what can be updated: NAME OLD NEW lines
    haltia-update changes NAME       what is new in it (AppStream releases)
    haltia-update upgrade [--auto] [NAME...]
                                     update all, or these packages (with
                                     what they need), with a snapshot to go
                                     back to; prints "stage S" and
                                     "progress PERCENT" lines as it goes
    haltia-update rollback [ID [NAME...]]
                                     back to a snapshot (the last by
                                     default), or only these packages of it
    haltia-update history            the snapshots, newest first
    haltia-update state              everything the window shows, as JSON
    haltia-update log                the update log's last lines, newest
                                     first (Настройки → «Для помощника»)
    haltia-update news               what happened by itself since last
                                     asked (updated, rolled back): KIND
                                     <tab> LABELS lines, for a notification
    haltia-update health             the checks after an update (greenboot's
                                     scheme); all pass: the update is good
    haltia-update session-start      a session started (counts restarts)
    haltia-update boot               at boot (OpenRC local.d): too many boots
                                     without a good mark roll back
    haltia-update status             auto=, last check, pending, held

apk does the work. Before an upgrade the versions of all packages are
written down and the .apk files of the ones about to change are kept
(from apk's cache, or fetched before the upgrade), so a rollback needs no
network and works even after a repository dropped the old version. A
failed apk upgrade rolls back at once. A good upgrade stays "pending"
until the session has run a minute and the checks in
/etc/haltia/health/required.d pass; a session that keeps restarting, or a
system that keeps rebooting, while it is pending rolls back by itself. A
rollback pins the old version in apk's world and remembers the bad one:
it is offered again only when a newer version comes out.
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
import xml.etree.ElementTree as ET

STATE = "/var/lib/haltia/update"
CONF = "/etc/haltia/update.conf"
LOCK = "/run/haltia/update.lock"
CACHE = "/var/cache/apk"
WORLD = "/etc/apk/world"
HEALTH = "/etc/haltia/health"
KEEP = 5  # snapshots kept
MIN_FREE = 300 * 1024 * 1024
MIN_CHARGE = 30
RESTARTS = 3  # session starts within RESTART_WINDOW while pending: roll back
RESTART_WINDOW = 300
BOOTS = 2  # boots without a good mark while pending: roll back at the next
# A package name, never something apk would read as an option.
PACKAGE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._+-]*")
LANG = "{http://www.w3.org/XML/1998/namespace}lang"


def log(msg):
    print(msg, flush=True)


def note(msg):
    """A line in the update log, for history and for the person who looks
    after the tablet."""
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "log"), "a") as fh:
        fh.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))


def read_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=1)
    os.replace(path + ".new", path)


def conf():
    values = {"auto": "no"}
    try:
        with open(CONF) as fh:
            for line in fh:
                k, sep, v = line.partition("=")
                if sep and not k.strip().startswith("#"):
                    values[k.strip()] = v.strip()
    except OSError:
        pass
    return values


def group(name):
    """The package a subpackage belongs to (haltia-text-pyc: haltia-text)."""
    return re.sub(r"-(pyc|lang|doc|openrc|ru)$", "", name)


def is_haltia(name):
    return name.startswith("haltia-") or name.startswith("py3-haltia-")


def label(name):
    """A package as the person knows it: its program's name from the
    .desktop file (haltia-text: «Блокнот»), else the package's own name."""
    name = group(name)
    if name == "haltia-shell":
        return "Оболочка Haltia"
    if name == "py3-haltia-kit":
        return "Общая библиотека программ"
    if name.startswith("haltia-"):
        rest = name[len("haltia-"):]
        path = "/usr/share/applications/io.github.haltia_de.%s.desktop" % rest.capitalize()
        try:
            with open(path) as fh:
                names = dict(l.strip().split("=", 1) for l in fh if "=" in l)
            return names.get("Name[ru]") or names.get("Name") or name
        except OSError:
            pass
    return name


def apk(*args, check=False):
    # Changes wait for apk's lock (another apk, a person in a terminal)
    # instead of failing on it.
    if args and args[0] in ("add", "del", "upgrade", "fix"):
        args = (args[0], "--wait", "120") + tuple(args[1:])
    res = subprocess.run(["apk"] + list(args), capture_output=True, text=True)
    if check and res.returncode:
        raise RuntimeError((res.stderr or res.stdout).strip().splitlines()[-1:] or "apk failed")
    return res


def installed():
    """{name: version} from apk's database."""
    found, name = {}, None
    with open("/lib/apk/db/installed") as fh:
        for line in fh:
            if line.startswith("P:"):
                name = line[2:].strip()
            elif line.startswith("V:") and name:
                found[name] = line[2:].strip()
    return found


def upgradable(names=()):
    """[(name, old, new)] that apk upgrade would change now (all, or what
    upgrading these packages takes)."""
    out = apk("upgrade", "--simulate", *(("--",) + tuple(names) if names else ())).stdout
    changes = []
    for m in re.finditer(r"\(\d+/\d+\) (Upgrading|Downgrading|Replacing) (\S+) \((\S+) -> (\S+)\)",
                         out):
        changes.append((m.group(2), m.group(3), m.group(4)))
    return changes


def held():
    """{name: bad version} rolled back from; offered again once newer."""
    return read_json(os.path.join(STATE, "held.json"), {})


def available(name):
    """The newest version of name the repositories offer, or None."""
    out = apk("search", "-x", "--", name).stdout.split()
    for word in out:
        if word.startswith(name + "-"):
            return word[len(name) + 1:]
    return None


SIMPLE = re.compile(r"(\d+(?:\.\d+)*)(?:-r(\d+))?")


def newer(a, b):
    """a newer than b, by apk's own comparison; plain X.Y.Z-rN versions
    (all of Haltia's) without starting apk for each."""
    ma, mb = SIMPLE.fullmatch(a), SIMPLE.fullmatch(b)
    if ma and mb:
        def key(m):
            return [int(x) for x in m.group(1).split(".")], int(m.group(2) or 0)
        return key(ma) > key(mb)
    return apk("version", "-t", a, b).stdout.strip() == ">"


def unhold_checksums():
    """Images up to Pertin Haltia v2.2.0 held each Haltia package at its
    file's checksum in world (haltia-shell><Q1...), so nothing ever showed
    as upgradable. Such a hold becomes the plain name; a version pin
    (name=1.2) of a rollback stays."""
    try:
        with open(WORLD) as fh:
            lines = fh.read().split()
    except OSError:
        return
    plain = [re.sub(r"^((?:haltia-|py3-haltia-)[A-Za-z0-9._+-]*)><.*$", r"\1", l)
             for l in lines]
    if plain != lines:
        with open(WORLD + ".haltia-new", "w") as fh:
            fh.write("\n".join(plain) + "\n")
        os.replace(WORLD + ".haltia-new", WORLD)
        note("world: checksum holds of Haltia packages dropped")


def update_index():
    """apk update, once more after a few seconds: right after the
    repository is published, Pages may serve an index and a signature that
    do not match yet. The cause goes to the log."""
    for attempt in range(2):
        res = apk("update", "-q")
        if res.returncode == 0:
            return True
        note("index: %s" % (res.stderr or res.stdout).strip()[-200:])
        if attempt == 0:
            time.sleep(8)
    return False


CATALOG = "appstream.xml.gz"  # next to a repository's indexes (haltia-de/packages)
CATALOG_MAX = 8 * 1024 * 1024


def catalog_path(repo):
    import hashlib
    key = hashlib.sha1(repo.encode()).hexdigest()[:16]
    return os.path.join(STATE, "catalog", key + ".xml.gz")


def update_catalogs():
    """Each repository's AppStream catalog, when it has one and it changed:
    what is new in every version, without downloading packages."""
    import urllib.error
    import urllib.request
    for repo in repositories():
        if not repo.startswith("https://"):
            continue  # unsigned: only over TLS
        path = catalog_path(repo)
        tag = read_json(path + ".json", {})
        req = urllib.request.Request("%s/%s" % (repo, CATALOG))
        if tag.get("etag") and os.path.exists(path):
            req.add_header("If-None-Match", tag["etag"])
        try:
            with urllib.request.urlopen(req, timeout=30) as res:
                data = res.read(CATALOG_MAX + 1)
                etag = res.headers.get("ETag", "")
        except urllib.error.HTTPError as exc:
            if exc.code == 404:  # a repository without one (Alpine's)
                for f in (path, path + ".json"):
                    if os.path.exists(f):
                        os.unlink(f)
            continue  # 304: ours is current
        except OSError:
            continue
        if len(data) > CATALOG_MAX:
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".new", "wb") as fh:
            fh.write(data)
        os.replace(path + ".new", path)
        write_json(path + ".json", {"etag": etag, "time": int(time.time())})


def policy(names):
    """{name: [repositories that offer it]}, from one apk policy."""
    found, name = {}, None
    if not names:
        return found
    for line in apk("policy", "--", *names).stdout.splitlines():
        if line.endswith(" policy:") and not line.startswith(" "):
            name = line[:-len(" policy:")]
            found[name] = []
        elif name and line.strip().startswith("https://"):
            repo = line.strip().rstrip("/")
            if repo not in found[name]:
                found[name].append(repo)
    return found


def providers(name):
    """The repositories that offer package name: as the last check found
    (one apk policy for all), else asked now."""
    kept = read_json(os.path.join(STATE, "status.json"), {}).get("providers", {})
    return kept.get(name) or policy([name]).get(name, [])


def catalog_component(name):
    """The component of package name, as XML bytes, from the catalog of a
    repository that offers that package: another one's word is not taken."""
    import gzip
    for repo in providers(name):
        path = catalog_path(repo)
        try:
            with gzip.open(path, "rb") as fh:
                data = fh.read(CATALOG_MAX * 8 + 1)
        except (OSError, EOFError):
            continue
        # Unsigned, unlike the index, and read as root: no DTDs or
        # entities, a bounded size, and only text is ever shown.
        if len(data) > CATALOG_MAX * 8:
            continue
        try:
            root = parse_xml(data)
        except ET.ParseError:
            continue
        for comp in root.iter("component"):
            if (comp.findtext("pkgname") or "").strip() == name:
                return ET.tostring(comp)
    return None


def check():
    unhold_checksums()
    update_index()
    update_catalogs()
    lines = [c for c in upgradable()]
    for name, bad in held().items():
        new = available(name)
        if new and newer(new, bad):
            lines.append((name, installed().get(name, "?"), new))
    status = read_json(os.path.join(STATE, "status.json"), {})
    status.update(checked=int(time.time()), available=len(lines),
                  list=[list(c) for c in lines],
                  providers=policy(sorted({c[0] for c in lines if is_haltia(c[0])})))
    write_json(os.path.join(STATE, "status.json"), status)
    for name, old, new in lines:
        log("%s %s %s" % (name, old, new))
    return 0


def cached(name, version):
    """The .apk of name-version in apk's cache, or None."""
    try:
        for f in os.listdir(CACHE):
            if f.startswith("%s-%s." % (name, version)) and f.endswith(".apk"):
                return os.path.join(CACHE, f)
    except OSError:
        pass
    return None


def fetch(name, version, into):
    """name-version's .apk into a folder (from the cache or a repository,
    tried three times: GitHub Pages fails a TLS handshake now and then)."""
    os.makedirs(into, exist_ok=True)
    have = cached(name, version)
    if have:
        shutil.copy2(have, into)
        return True
    for _attempt in range(3):
        if apk("fetch", "-q", "-o", into, "--", "%s=%s" % (name, version)).returncode == 0:
            return True
        # apk 3.0.8 refuses "name=version" here ("unable to select
        # package"), even for the installed one: the file straight from the
        # repositories, which keep every release. apk checks its signature
        # when a rollback installs it.
        if download(name, version, into):
            return True
        time.sleep(3)
    return False


def repositories():
    found = []
    paths = ["/etc/apk/repositories"]
    try:
        paths += sorted(os.path.join("/etc/apk/repositories.d", f)
                        for f in os.listdir("/etc/apk/repositories.d") if f.endswith(".list"))
    except OSError:
        pass
    for path in paths:
        try:
            with open(path) as fh:
                for line in fh:
                    line = line.strip()
                    if line.startswith("https://") or line.startswith("http://"):
                        found.append(line.split()[0].rstrip("/"))
        except OSError:
            pass
    return found


def download(name, version, into):
    import urllib.request
    arch = apk("--print-arch").stdout.strip()
    file = "%s-%s.apk" % (name, version)
    for repo in repositories():
        try:
            with urllib.request.urlopen("%s/%s/%s" % (repo, arch, file), timeout=60) as res, \
                    open(os.path.join(into, file + ".part"), "wb") as out:
                shutil.copyfileobj(res, out)
            os.replace(os.path.join(into, file + ".part"), os.path.join(into, file))
            return True
        except OSError:
            try:
                os.unlink(os.path.join(into, file + ".part"))
            except OSError:
                pass
    return False


def changes(name):
    """The AppStream releases newer than the installed version, from the new
    package's metainfo: VERSION DATE, then its description's text. Kept per
    installed and new version, so a second look needs no download."""
    have = installed().get(name)
    # The new version as the last check found it (apk search reads every
    # index, seconds on the tablet), else from apk.
    known = {c[0]: c[2] for c in read_json(os.path.join(STATE, "status.json"), {}).get("list", [])}
    new = known.get(name) or available(name)
    notes = os.path.join(STATE, "notes")
    keep = os.path.join(notes, "%s-%s-%s.ru.txt" % (name, have, new))
    try:
        with open(keep) as fh:
            sys.stdout.write(fh.read())
        return 0
    except OSError:
        pass
    lines = None
    comp = catalog_component(name)
    if comp is not None and new:
        found = releases(comp, have)
        # The catalog knows this version (it may lag a fresh release).
        if any(l.split(" ", 1)[0] == new.split("-r")[0] for l in found
               if not l.startswith("• ")):
            lines = found
    if lines is None:
        lines = fetch_changes(name, have)
    if lines is None:
        return 1
    for line in lines:
        log(line)
    if new:
        os.makedirs(notes, exist_ok=True)
        for old in os.listdir(notes):
            if old.startswith(name + "-"):
                os.unlink(os.path.join(notes, old))
        with open(keep, "w") as fh:
            fh.write("".join(l + "\n" for l in lines))
    return 0


def fetch_changes(name, have):
    """The release lines from the newest package's metainfo, None when it
    cannot be fetched."""
    tmp = os.path.join(STATE, "changes")
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    lines = []
    try:
        if apk("fetch", "-q", "-o", tmp, "--", name).returncode:
            return None
        for f in os.listdir(tmp):
            try:
                with tarfile.open(os.path.join(tmp, f), "r:gz", ignore_zeros=True) as t:
                    for m in t:
                        if m.isfile() and m.name.startswith("usr/share/metainfo/"):
                            lines += releases(t.extractfile(m).read(), have)
            except (OSError, tarfile.TarError):
                pass
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return lines


def parse_xml(data):
    """XML from outside (a package's metainfo, a repository's catalog), read
    as root: a document type or an entity declaration ends it, whatever the
    encoding (a byte check alone missed UTF-16)."""
    import xml.parsers.expat

    def refuse(*_args):
        raise ET.ParseError("no DTDs or entities")
    # expat itself looks first (ElementTree's C parser takes no handlers),
    # then ElementTree reads what passed.
    scan = xml.parsers.expat.ParserCreate()
    scan.StartDoctypeDeclHandler = refuse
    scan.EntityDeclHandler = refuse
    try:
        scan.Parse(data, True)
    except xml.parsers.expat.ExpatError as exc:
        raise ET.ParseError(str(exc))
    return ET.fromstring(data)


def releases(xml, have):
    """VERSION DATE lines, each followed by its description's paragraphs
    and items (an item starts with "• "), for releases newer than have."""
    try:
        root = parse_xml(xml)
    except ET.ParseError:
        return []
    lines = []
    base = (have or "").split("-r")[0]
    for rel in root.iter("release"):
        ver = rel.get("version", "")
        if base and not newer(ver + "-r0", base + "-r0"):
            continue
        lines.append("%s %s" % (ver, rel.get("date", "")))
        desc = rel.find("description")
        if desc is not None:
            # The Russian text when there is one (xml:lang="ru"), else the
            # untranslated one; never both.
            items = [el for el in desc.iter() if el.tag in ("p", "li")]
            ru = [el for el in items if el.get(LANG) == "ru"]
            for el in ru or [el for el in items if not el.get(LANG)]:
                text = " ".join("".join(el.itertext()).split())
                if text:
                    lines.append(("• " if el.tag == "li" else "") + text)
    return lines


def battery_ok():
    try:
        out = subprocess.run(["/usr/libexec/haltia/haltia-meter", "battery-info"],
                             capture_output=True, text=True, timeout=10).stdout.split()
    except (OSError, subprocess.SubprocessError):
        return True
    if len(out) != 2:
        return True  # no battery: a desktop
    return out[1] in ("charging", "full") or int(out[0]) >= MIN_CHARGE


def enable_cache():
    """apk keeps what it downloads: the next rollback finds today's files."""
    os.makedirs(CACHE, exist_ok=True)
    link = "/etc/apk/cache"
    if not os.path.exists(link):
        os.symlink(CACHE, link)


def snapshots():
    try:
        return sorted((d for d in os.listdir(STATE) if d.isdigit()), reverse=True)
    except OSError:
        return []


def take_snapshot(changes_):
    sid = time.strftime("%Y%m%d%H%M%S")
    path = os.path.join(STATE, sid)
    os.makedirs(os.path.join(path, "apk"))
    missing = []
    for name, old, _new in changes_:
        if not fetch(name, old, os.path.join(path, "apk")):
            missing.append(name)
    write_json(os.path.join(path, "snapshot.json"), {
        "versions": installed(), "changes": changes_, "missing": missing,
        "time": int(time.time())})
    for old in snapshots()[KEEP:]:
        shutil.rmtree(os.path.join(STATE, old), ignore_errors=True)
    return sid, missing


def stage(name):
    """A step of the work for the window (haltia-settings reads these lines
    as they come) and for a window opened while it runs (progress.json)."""
    log("stage %s" % name)
    write_json(os.path.join(STATE, "progress.json"), {"stage": name, "percent": 0,
                                                       "time": int(time.time())})


def run_apk_with_progress(args):
    """apk with its progress on a pipe: "progress PERCENT" lines. Returns
    the finished process (stderr kept)."""
    rfd, wfd = os.pipe()
    # Options before the "--" that ends them (package names follow it).
    at = args.index("--") if "--" in args else len(args)
    args = args[:at] + ["--progress-fd", str(wfd)] + args[at:]
    proc = subprocess.Popen(args, pass_fds=(wfd,),
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    os.close(wfd)
    shown = -1
    with os.fdopen(rfd) as pipe:
        for line in pipe:
            done, _sep, total = line.strip().partition("/")
            try:
                percent = int(int(done) * 100 / max(int(total), 1))
            except ValueError:
                continue
            if percent != shown:
                shown = percent
                log("progress %d" % percent)
                prog = read_json(os.path.join(STATE, "progress.json"), {})
                prog["percent"] = percent
                write_json(os.path.join(STATE, "progress.json"), prog)
    out, err = proc.communicate()
    proc.stdout_text, proc.stderr_text = out, err
    return proc


def upgrade(auto=False, names=()):
    if not battery_ok():
        log("battery: charge it first")
        return 3
    if shutil.disk_usage("/").free < MIN_FREE:
        log("storage: not enough room")
        return 3
    unhold_checksums()
    stage("index")
    if not update_index():
        log("network: no repository")
        return 3
    plan = upgradable(names)
    skip = held()
    plan = [c for c in plan if not (c[0] in skip and c[2] == skip[c[0]])]
    if not plan:
        log("nothing to update")
        return 0
    for name, old, new in plan:
        log("plan %s %s %s" % (name, old, new))
    enable_cache()
    stage("snapshot")
    sid, missing = take_snapshot(plan)
    note("upgrade %s: %s%s" % (sid, ", ".join("%s %s→%s" % c for c in plan),
                               " (no way back for %s)" % ", ".join(missing) if missing else ""))
    # No sleep while apk works (haltia-sleep reads logind's block inhibitors).
    # Everything is downloaded into the cache before anything changes, so a
    # network that fails half way (it did: TLS) leaves the system as it was;
    # that is tried again, up to three times.
    stage("install")
    cmd = ["elogind-inhibit", "--what=sleep", "--who=haltia-update", "--why=Обновление",
           "--mode=block", "apk", "upgrade", "-q", "--wait", "120", "--cache-predownload"]
    if names:
        cmd += ["--"] + list(names)
    for attempt in range(3):
        res = run_apk_with_progress(cmd)
        if res.returncode == 0 or installed() != read_json(
                os.path.join(STATE, sid, "snapshot.json"), {}).get("versions"):
            break
        note("upgrade %s: download failed, again (%s)" % (sid, (res.stderr_text or "").strip()[-120:]))
        time.sleep(10)
    clear_progress()
    if res.returncode:
        note("upgrade %s failed: %s" % (sid, (res.stderr_text or res.stdout_text).strip()[-200:]))
        if rollback(sid, reason="failed") == 0:
            # Nothing of it stayed: no past update to show or go back from.
            shutil.rmtree(os.path.join(STATE, sid), ignore_errors=True)
        log("failed, going back")
        return 1
    write_json(os.path.join(STATE, "pending.json"), {"snapshot": sid, "boots": 0,
                                                     "starts": [], "auto": auto})
    # What check found and this installed is no longer to be updated.
    status = read_json(os.path.join(STATE, "status.json"), {})
    done = {c[0] for c in plan}
    status["list"] = [c for c in status.get("list", []) if c[0] not in done]
    status["available"] = len(status["list"])
    write_json(os.path.join(STATE, "status.json"), status)
    if auto:
        tell("updated", sorted({group(c[0]) for c in plan}))
    # The checks a minute on, as at a session start: an update made while
    # the session runs would otherwise wait for the next one to be good.
    subprocess.Popen(["sh", "-c", "sleep 60; exec %s health" % os.path.abspath(sys.argv[0])],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    note("upgrade %s done, pending checks" % sid)
    log("updated")
    return 0


def clear_progress():
    try:
        os.unlink(os.path.join(STATE, "progress.json"))
    except OSError:
        pass


def tell(kind, names):
    """Something that happened by itself, for a notification (news)."""
    path = os.path.join(STATE, "news.json")
    news = read_json(path, [])
    news.append({"kind": kind, "names": names, "time": int(time.time())})
    write_json(path, news[-20:])


def news():
    """What happened by itself and was not told yet: KIND <tab> labels."""
    path = os.path.join(STATE, "news.json")
    items = [n for n in read_json(path, []) if not n.get("told")]
    for item in items:
        log("%s\t%s" % (item["kind"], ", ".join(sorted({label(n) for n in item["names"]}))))
    if items:
        write_json(path, [dict(n, told=True) for n in read_json(path, [])])
    return 0


def rollback(sid=None, reason="asked", names=()):
    """Back to the versions of snapshot sid (the last by default): all it
    changed, or only the packages named (with their subpackages)."""
    sid = sid or (snapshots()[:1] or [None])[0]
    if not sid:
        log("no snapshot")
        return 2
    path = os.path.join(STATE, sid, "snapshot.json")
    snap = read_json(path, None)
    if not snap:
        log("no snapshot %s" % sid)
        return 2
    wanted = {group(n) for n in names}
    want, now = snap["versions"], installed()
    if wanted:
        want = {n: v for n, v in want.items() if group(n) in wanted}
    back = [(n, v) for n, v in want.items() if now.get(n) != v]
    folder = os.path.join(STATE, sid, "apk")
    files = [os.path.join(folder, f) for f in os.listdir(folder)
             if not wanted or any(f.startswith("%s-%s." % (n, v)) for n, v in back)]
    stage("rollback")
    if files:
        res = apk("add", "--no-network", *files)
        if res.returncode:
            clear_progress()
            note("rollback %s: %s" % (sid, res.stderr.strip()[-200:]))
            log("rollback failed")
            return 1
    # Pin what came back (from a repository when no file was kept), and
    # remember the bad version: not when the upgrade only failed to install,
    # which says nothing about the version.
    bad = held()
    for name, ver in back:
        if name in now:
            apk("add", "%s=%s" % (name, ver) if reason != "failed" else name)
            if reason != "failed":
                bad[name] = now[name]
    write_json(os.path.join(STATE, "held.json"), bad)
    clear_progress()
    if not wanted:
        try:
            os.unlink(os.path.join(STATE, "pending.json"))
        except OSError:
            pass
    snap["rolled_back"] = sorted(set(snap.get("rolled_back", [])) |
                                 {group(n) for n, _v in back} | wanted)
    write_json(path, snap)
    if reason not in ("asked", "failed"):
        tell("rolled back", sorted({group(n) for n, _v in back}))
    note("rollback %s (%s): %s" % (sid, reason, ", ".join("%s %s" % b for b in back)))
    log("rolled back")
    return 0


def unhold_newer():
    """A held package whose next version is out goes back to plain world."""
    bad = held()
    for name, ver in list(bad.items()):
        new = available(name)
        if new and newer(new, ver):
            apk("add", name)
            del bad[name]
    write_json(os.path.join(STATE, "held.json"), bad)


def run_checks(kind):
    folder = os.path.join(HEALTH, kind)
    ok = True
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return True
    for name in names:
        path = os.path.join(folder, name)
        if not os.access(path, os.X_OK):
            continue
        res = subprocess.run([path], capture_output=True, text=True, timeout=120)
        if res.returncode:
            note("health %s/%s failed: %s" % (kind, name, (res.stderr or "").strip()[-200:]))
            ok = False
    return ok


def health():
    pending = read_json(os.path.join(STATE, "pending.json"), None)
    required = run_checks("required.d")
    run_checks("wanted.d")
    if pending is None:
        return 0 if required else 1
    if not required:
        log("checks failed, going back")
        return rollback(pending["snapshot"], reason="checks failed")
    os.unlink(os.path.join(STATE, "pending.json"))
    note("upgrade %s good" % pending["snapshot"])
    log("good")
    return 0


def session_start():
    path = os.path.join(STATE, "pending.json")
    pending = read_json(path, None)
    if pending is None:
        return 0
    now = int(time.time())
    starts = [t for t in pending.get("starts", []) if now - t < RESTART_WINDOW] + [now]
    pending["starts"] = starts
    write_json(path, pending)
    if len(starts) >= RESTARTS:
        log("the session keeps restarting, going back")
        return rollback(pending["snapshot"], reason="session restarts")
    return 0


def boot():
    path = os.path.join(STATE, "pending.json")
    pending = read_json(path, None)
    if pending is None:
        return 0
    pending["boots"] = pending.get("boots", 0) + 1
    write_json(path, pending)
    if pending["boots"] > BOOTS:
        log("boots without a good mark, going back")
        return rollback(pending["snapshot"], reason="boots")
    return 0


def history():
    for sid in snapshots():
        snap = read_json(os.path.join(STATE, sid, "snapshot.json"), {})
        log("%s %s" % (sid, ", ".join("%s %s→%s" % tuple(c) for c in snap.get("changes", []))))
    return 0


def status():
    st = read_json(os.path.join(STATE, "status.json"), {})
    log("auto=%s" % conf().get("auto", "no"))
    log("checked=%s" % st.get("checked", 0))
    log("available=%s" % st.get("available", 0))
    log("pending=%s" % ("yes" if os.path.exists(os.path.join(STATE, "pending.json")) else "no"))
    log("held=%s" % " ".join("%s=%s" % kv for kv in held().items()))
    log("snapshots=%d" % len(snapshots()))
    return 0


def busy():
    """An update or rollback runs now (it holds the lock)."""
    try:
        with open(LOCK, "a") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
    except BlockingIOError:
        return True
    except OSError:
        return False


def state():
    """Everything the window shows, in one call, as JSON: the settings, the
    last check and what it found (by program, with names the person
    knows), what runs now, and the past updates."""
    st = read_json(os.path.join(STATE, "status.json"), {})
    have = installed()
    programs = {}
    for name, old, new in st.get("list", []):
        if have.get(name, old) != old:
            continue  # updated since the check
        key = group(name) if is_haltia(name) else "system"
        item = programs.setdefault(key, {"name": key, "label": label(key) if key != "system"
                                         else "Системные компоненты", "packages": []})
        item["packages"].append([name, old, new])
        if name == key:
            item["old"], item["new"] = old.split("-r")[0], new.split("-r")[0]
    history_ = []
    for sid in snapshots():
        snap = read_json(os.path.join(STATE, sid, "snapshot.json"), {})
        groups = {}
        for name, old, new in snap.get("changes", []):
            key = group(name) if is_haltia(name) else "system"
            g = groups.setdefault(key, {"name": key, "label": label(key) if key != "system"
                                        else "Системные компоненты", "packages": []})
            g["packages"].append(name)
            if name == key or "old" not in g:
                g["old"], g["new"] = old.split("-r")[0], new.split("-r")[0]
        back = set(snap.get("rolled_back", []))
        for g in groups.values():
            g["rolled_back"] = all(group(n) in back for n in g["packages"])
        history_.append({"id": sid, "time": snap.get("time", 0),
                         "programs": sorted(groups.values(), key=lambda g: (g["name"] == "system",
                                                                            g["label"]))})
    print(json.dumps({
        "auto": conf().get("auto", "no") == "yes",
        "checked": st.get("checked", 0),
        "programs": sorted(programs.values(), key=lambda p: (p["name"] == "system", p["label"])),
        "pending": os.path.exists(os.path.join(STATE, "pending.json")),
        "busy": busy(),
        "progress": read_json(os.path.join(STATE, "progress.json"), None),
        "history": history_,
    }, ensure_ascii=False))
    return 0


def set_auto(value):
    lines = []
    try:
        with open(CONF) as fh:
            lines = [l for l in fh if not l.strip().startswith("auto")]
    except OSError:
        lines = ["# haltia-update: auto=yes updates by itself at most once a day, when the\n",
                 "# screen goes off while charging (haltia-sleep).\n"]
    lines.append("auto=%s\n" % ("yes" if value else "no"))
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF + ".new", "w") as fh:
        fh.writelines(lines)
    os.replace(CONF + ".new", CONF)
    return 0


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if os.geteuid() != 0:
        sys.stderr.write("haltia-update: run as root (doas)\n")
        return 2
    # Reading needs no lock (the window asks while an update runs); the
    # session's and the boot's marks wait for one; the rest refuse to wait.
    if cmd == "history":
        return history()
    if cmd == "status":
        return status()
    if cmd == "state":
        return state()
    if cmd == "log":
        try:
            with open(os.path.join(STATE, "log")) as fh:
                lines = fh.read().splitlines()[-200:]
        except OSError:
            lines = []
        for line in reversed(lines):
            log(line)
        return 0
    wait = cmd in ("session-start", "boot")
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    lock = open(LOCK, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
    except BlockingIOError:
        log("busy: another update runs")
        return 4
    try:
        if cmd == "check":
            return check()
        # A package name, never something apk would read as an option.
        if cmd == "changes" and len(args) == 2 and PACKAGE.fullmatch(args[1]):
            return changes(args[1])
        names = [a for a in args[1:] if not a.startswith("-")]
        if any(not PACKAGE.fullmatch(n) for n in names):
            log("error: not a package name")
            return 2
        if cmd == "upgrade":
            unhold_newer()
            return upgrade(auto="--auto" in args, names=names)
        if cmd == "rollback":
            sid = names[0] if names and names[0].isdigit() else None
            return rollback(sid, names=names[1:] if sid else ())
        if cmd == "news":
            return news()
        if cmd == "history":
            return history()
        if cmd == "health":
            return health()
        if cmd == "session-start":
            return session_start()
        if cmd == "boot":
            return boot()
        if cmd == "status":
            return status()
        if cmd == "auto" and len(args) == 2 and args[1] in ("on", "off"):
            return set_auto(args[1] == "on")
    except RuntimeError as exc:
        log("error: %s" % exc)
        return 1
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
