#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Changes the touch filter's settings for haltia-touch-settings, which runs
# it as the session user through doas (a nopass rule): so it takes only
# known keys with whole numbers inside the ranges below, where the screen
# still answers a finger (a palm threshold at a finger's size, or one
# contact counted as a palm, would leave no way to undo it by touch).
#
#   haltia-touchguard-conf ranges              key, lowest, highest (no root)
#
# repeat_radius, palm_major, palm_pressure and tap_radius are hundredths of
# a percent of the screen's axis in ranges and set (7333), and go into the
# file as percent ("73.33%"), which haltia-touchguard reads.
#   haltia-touchguard-conf set KEY=VALUE...    try them: TRY, then reload the filter
#   haltia-touchguard-conf keep                write what is tried into CONF
#   haltia-touchguard-conf drop                forget what is tried
#   haltia-touchguard-conf log on|off          log every decision (15 min) or stop
#
# A value is tried in TRY (tmpfs, read by the filter over CONF) and reaches
# CONF only on keep («Оставить»). Each set starts a watch that drops what
# is tried TRY_S seconds on unless it was kept or tried again, so a window
# killed, crashed or closed by a session restart mid-try leaves nothing
# behind: an untried value could turn every tap into a slide until a helper
# came.
#
# The decisions go to EVENTS, made afresh for the user doas ran this for
# (DOAS_USER) and readable by them alone: they hold where each touch landed.
set -eu
CONF=/etc/haltia/touchguard.conf
# The old place until 3.0, while haltia-upgrade has not moved it.
[ -e "$CONF" ] || [ ! -e /etc/b8k/touchguard.conf ] || CONF=/etc/b8k/touchguard.conf
PIDFILE=/run/haltia/touchguard.pid
EVENTS=/run/haltia/touchguard.events
TRY=/run/haltia/touchguard.try
TRY_S=20 # the window's 15 s to tap «Оставить», and a margin

RANGES='hold_ms 0 300
repeat_ms 0 1500
repeat_radius 0 2700
palm_major 4000 10000
palm_pressure 2350 10000
palm_contacts 2 10
palm_grace_ms 0 2000
buzz_ms 0 500
tap_radius 90 1800
long_ms 300 2000
multitouch 0 1'

signal() {
	pid=$(cat "$PIDFILE" 2>/dev/null) || {
		echo "haltia-touchguard-conf: the filter is not running" >&2
		exit 1
	}
	kill -"$1" "$pid"
}

# merge FILE: FILE with the "key = value" lines on stdin put in, each in
# place of the same key's line (comments stay), the rest at the end. No
# lines: FILE is left as it is.
merge() {
	lines=$1.lines
	grep '^[a-z_]* = ' >"$lines" || true
	if [ ! -s "$lines" ]; then
		rm -f "$lines"
		return 0
	fi
	[ -f "$1" ] || : >"$1"
	awk '
		FILENAME == ARGV[1] { k = $1; line[k] = $0; order[++n] = k; next }
		/^[ \t]*[a-z_]+[ \t]*=/ {
			k = $0
			sub(/^[ \t]*/, "", k)
			sub(/[ \t]*=.*/, "", k)
			if (k in line) { print line[k]; done[k] = 1; next }
		}
		{ print }
		END {
			for (i = 1; i <= n; i++)
				if (!(order[i] in done)) { print line[order[i]]; done[order[i]] = 1 }
		}' "$lines" "$1" >"$1.new"
	rm -f "$lines"
	chmod 644 "$1.new"
	mv "$1.new" "$1"
}

case ${1:-} in
ranges)
	printf '%s\n' "$RANGES"
	;;
set)
	shift
	[ $# -gt 0 ] || exit 2
	for kv in "$@"; do
		key=${kv%%=*} val=${kv#*=}
		case $val in '' | *[!0-9]*) echo "haltia-touchguard-conf: bad value: $kv" >&2; exit 2 ;; esac
		range=$(printf '%s\n' "$RANGES" | awk -v k="$key" '$1 == k { print $2, $3 }')
		[ -n "$range" ] || { echo "haltia-touchguard-conf: unknown key: $key" >&2; exit 2; }
		lo=${range% *} hi=${range#* }
		# Leading zeros would read as octal in the shell's arithmetic.
		val=$(printf '%s' "$val" | sed 's/^0*\(.\)/\1/')
		if [ "${#val}" -gt 5 ] || [ "$val" -lt "$lo" ] || [ "$val" -gt "$hi" ]; then
			echo "haltia-touchguard-conf: $key out of $lo-$hi: $val" >&2
			exit 2
		fi
	done
	# What is tried: TRY, its values as the filter reads them, and a token
	# for the watch below.
	token=$(date +%s)$$
	{
		for kv in "$@"; do
			key=${kv%%=*} val=$(printf '%s' "${kv#*=}" | sed 's/^0*\(.\)/\1/')
			case $key in
			repeat_radius | palm_major | palm_pressure | tap_radius)
				printf '%s = %d.%02d%%\n' "$key" $((val / 100)) $((val % 100)) ;;
			*) printf '%s = %d\n' "$key" "$val" ;;
			esac
		done
	} | merge "$TRY"
	sed -i '/^# token /d' "$TRY"
	echo "# token $token" >>"$TRY"
	signal HUP
	# Nobody kept or tried again in TRY_S seconds: drop it.
	setsid sh -c '
		sleep "$1"
		[ "$(sed -n "s/^# token //p" "$2" 2>/dev/null)" = "$3" ] || exit 0
		rm -f "$2"
		pid=$(cat "$4" 2>/dev/null) && kill -HUP "$pid"
	' watch "$TRY_S" "$TRY" "$token" "$PIDFILE" </dev/null >/dev/null 2>&1 &
	;;
keep)
	# «Оставить»: what is tried goes into the file, comments kept.
	if [ -f "$TRY" ]; then
		merge "$CONF" <"$TRY"
		rm -f "$TRY"
	fi
	signal HUP
	;;
drop)
	rm -f "$TRY"
	signal HUP
	;;
log)
	case ${2:-} in
	on)
		# Again while the window is open (every 10 minutes): the file
		# it reads stays.
		if [ -L "$EVENTS" ] || [ ! -f "$EVENTS" ]; then
			rm -f "$EVENTS"
			install -m 600 -o "${DOAS_USER:-root}" /dev/null "$EVENTS"
		fi
		signal USR1
		;;
	off)
		signal USR2
		rm -f "$EVENTS"
		;;
	*) exit 2 ;;
	esac
	;;
*)
	echo "usage: haltia-touchguard-conf ranges | set KEY=VALUE... | keep | drop | log on|off" >&2
	exit 2
	;;
esac
