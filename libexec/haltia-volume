#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0
"""Volume keys: 5% up or down on the PulseAudio default sink per press; a
key held down slides the volume 2% every 80 ms until it is let go.

Phosh used to handle the keys; phoc alone ignores them, so the sound could
be muted at 0% with no way back. Runs in the session as the user, who is
in the input group. The keypad is only read, not grabbed.
"""
import ctypes
import os
import select
import struct
import subprocess
import sys


_panel = None


def panel():
    """haltia-panel-signal as a module (loaded on first use): signalling
    the panel, the one way."""
    global _panel
    if _panel is None:
        import importlib.machinery
        import importlib.util
        here = os.path.dirname(os.path.realpath(__file__))
        for path in (os.path.join(here, "haltia-panel-signal"),
                     os.path.join(here, "..", "bin", "haltia-panel-signal"),
                     "/usr/bin/haltia-panel-signal"):
            if os.path.exists(path):
                loader = importlib.machinery.SourceFileLoader("haltia_panel_signal", path)
                spec = importlib.util.spec_from_loader("haltia_panel_signal", loader)
                _panel = importlib.util.module_from_spec(spec)
                loader.exec_module(_panel)
                break
        else:
            raise OSError("haltia-panel-signal is missing")
    return _panel
import time

KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
EV_SYN = 0
EV_KEY = 1
SYN_DROPPED = 3
EVENT = struct.Struct("llHHi")  # struct input_event (a timeval of two longs)
LONG_BITS = ctypes.sizeof(ctypes.c_long) * 8
STEP = 5  # percent per press; up stops at 100, past which PulseAudio would overdrive
HOLD = 0.4  # seconds a key is held before the slope starts
RAMP = 2  # percent per tick while it is held
TICK = 0.08  # seconds between ticks
PACTL_WAIT = 2  # seconds: a PulseAudio that hangs must not take the keys with it
DEVICE_WAIT = 30  # seconds a late keypad is looked for at start
NOTHING = 3  # exit status: nothing to do here, haltia-keep leaves it off


def find_keypads():
    """Every input device with a volume key. Most keypads have both keys;
    some machines split them (the Tab P11's Volume Up is a GPIO key, its
    Volume Down the PMIC's RESIN), so each one is read."""
    found = []
    for node in sorted(os.listdir("/sys/class/input")):
        if not node.startswith("event"):
            continue
        try:
            with open("/sys/class/input/%s/device/capabilities/key" % node) as fh:
                words = fh.read().split()
        except OSError:
            continue
        # A hex bitmap of key codes, lowest word last, one long per word.
        bits = 0
        for i, word in enumerate(reversed(words)):
            bits |= int(word, 16) << (LONG_BITS * i)
        if bits >> KEY_VOLUMEUP & 1 or bits >> KEY_VOLUMEDOWN & 1:
            found.append("/dev/input/" + node)
    return found


def pactl(*args):
    try:
        subprocess.call(["pactl"] + list(args), stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL, timeout=PACTL_WAIT)
    except (OSError, subprocess.SubprocessError):
        pass


def volume():
    # Current default-sink volume in percent, rounded to the step grid.
    try:
        out = subprocess.run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"],
                             capture_output=True, text=True, timeout=PACTL_WAIT).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    try:
        pct = int(out.split("/")[1].strip().rstrip("%"))
    except (IndexError, ValueError):
        return 50
    return int(round(pct / STEP)) * STEP


def refresh_bar():
    # The speaker in the status listens on SIGRTMIN+10 (only a bar that
    # catches it gets it).
    try:
        panel().refresh(10)
    except OSError:
        pass


def step(level, by):
    """Set the volume to level + by, within 0-100; returns the new level."""
    new = max(0, min(100, level + by))
    if by > 0:
        pactl("set-sink-mute", "@DEFAULT_SINK@", "0")
    pactl("set-sink-volume", "@DEFAULT_SINK@", "%d%%" % new)
    refresh_bar()
    return new


def open_keypads():
    """{file: path} of the keypads that open; a late one (still probing
    at boot) is waited for up to DEVICE_WAIT seconds."""
    deadline = time.monotonic() + DEVICE_WAIT
    while True:
        devs = {}
        for path in find_keypads():
            try:
                devs[open(path, "rb", buffering=0)] = path
            except OSError as exc:
                # One that does not open (a headset going away) leaves the rest.
                sys.stderr.write("haltia-volume: %s: %s\n" % (path, exc.strerror))
        if devs or time.monotonic() >= deadline:
            return devs
        time.sleep(2)


def main():
    devs = open_keypads()
    if not devs:
        # Nothing to do on this machine: haltia-keep leaves it off instead
        # of starting it again and again (SH2-36).
        sys.stderr.write("haltia-volume: no device with volume keys\n")
        return NOTHING
    # A press steps STEP; a key held past HOLD goes on by RAMP every TICK
    # until it is let go: a smooth slope, whether or not the keypad repeats
    # the key itself (its own repeats, value 2, are ignored).
    held = None  # (code, direction, level, next step time)
    while True:
        timeout = None if held is None else max(0.0, held[3] - time.monotonic())
        ready = select.select(list(devs), [], [], timeout)[0]
        if not ready:
            code, by, level, _due = held
            held = (code, by, step(level, by * RAMP), time.monotonic() + TICK)
            continue
        dev = ready[0]
        try:
            data = dev.read(EVENT.size)
        except OSError:  # ENODEV: unplugged
            data = b""
        if len(data) < EVENT.size:
            # A keypad went away (a USB keyboard or headset unplugged):
            # the others go on. With none left, end: haltia-keep starts
            # this again, which looks the keypads up afresh.
            sys.stderr.write("haltia-volume: %s: gone\n" % devs.pop(dev))
            dev.close()
            held = None
            if not devs:
                return 1
            continue
        _sec, _usec, etype, code, value = EVENT.unpack(data)
        if etype == EV_SYN and code == SYN_DROPPED:
            # Events were lost, a release perhaps: a held key would slide
            # the volume to the end and on (SH2-34).
            held = None
            continue
        if etype != EV_KEY or code not in (KEY_VOLUMEUP, KEY_VOLUMEDOWN):
            continue
        if value == 0:
            if held and held[0] == code:
                held = None
            continue
        if value != 1:
            continue
        by = 1 if code == KEY_VOLUMEUP else -1
        held = (code, by, step(volume(), by * STEP), time.monotonic() + HOLD)


if __name__ == "__main__":
    sys.exit(main())
