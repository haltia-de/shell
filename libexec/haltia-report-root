#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""What only root may read, for haltia-report (doas, no password, no
arguments of the caller's beyond the two words below), already cleaned of
what is personal by haltia-report's own clean():

    haltia-report-root scan       JSON: {"oom": [kernel lines], "pstore":
                                  [names], "rollback": [update log lines],
                                  "daemon": [messages' lines of a service
                                  supervise-daemon saw killed by a signal]}
    haltia-report-root sections   JSON {"root/NAME": text}: dmesg, /var/log's
                                  haltia logs and messages, pstore's records,
                                  the update log

It reads only, writes nothing, and takes no path from the caller.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
PSTORE = "/sys/fs/pstore"
UPDATE_LOG = "/var/lib/haltia/update/log"
VAR_LOG = "/var/log"
LOGS = re.compile(r"^(haltia-.*\.log|messages|rc\.log|dmesg)$")
TAIL = 300
# Kernel lines that tell a crash (kernel.print-fatal-signals: "potentially
# unexpected fatal signal 11", then the registers); CONTEXT lines after each.
CRASH = re.compile(r"fatal signal|Unable to handle|Oops|\bBUG\b|WARNING|Kernel panic|segfault")
CONTEXT = 40
HEAD_MAX = 1000
# What the MT6628 Wi-Fi driver writes by the hundred after every resume.
NOISE = {"fwdl": re.compile(r"wlan_mt6628: FWDL resp"),
         "alloc": re.compile(r"\[MT6628\].*\b(allocated|freed)\b")}
OOM = re.compile(r"Killed process \d+")  # one line a kill
ROLLBACK = re.compile(r"rolled back|going back|checks failed|session restarts|boots without")
# OpenRC's supervisor about a service it watches.
DAEMON = re.compile(r"supervise-daemon\[\d+\]: /\S+, pid \d+, terminated by signal \d+$")


def report():
    loader = importlib.machinery.SourceFileLoader("haltia_report",
                                                  os.path.join(HERE, "haltia-report"))
    spec = importlib.util.spec_from_loader("haltia_report", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def dmesg():
    try:
        return subprocess.run(["dmesg"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def dmesg_text(text):
    """dmesg for a report: what tells a crash, from the whole buffer, then
    the last TAIL lines, with the driver spam that fills the buffer after a
    resume counted instead of kept."""
    lines = collapse(text.splitlines())
    head, tail = lines[:-TAIL], lines[-TAIL:]
    out, upto = [], 0  # head's lines before upto are taken or counted
    for i, line in enumerate(head):
        if not CRASH.search(line):
            continue
        if i > upto:
            out.append("[... %d lines ...]" % (i - upto))
        # A fatal-signal line or an oops: the dump follows it.
        end = min(i + 1 + CONTEXT, len(head))
        out.extend(head[max(i, upto):end])
        upto = max(upto, end)
    if len(out) > HEAD_MAX:  # a warning repeated all over the buffer
        out = ["[... earlier lines ...]"] + out[-HEAD_MAX:]
    if out:
        if upto < len(head):
            out.append("[... %d lines ...]" % (len(head) - upto))
        out.append("[last %d lines]" % len(tail))
    return "\n".join(out + tail) + "\n"


def collapse(lines):
    """Each run of spam lines as one line of each kind, with its count."""
    out, run = [], {}
    for line in lines + [None]:
        kind = next((k for k, rule in NOISE.items() if line and rule.search(line)), None)
        if kind:
            first, n = run.get(kind, (line, 0))
            run[kind] = (first, n + 1)
            continue
        for first, n in run.values():
            out.append(first if n == 1 else "%s [x%d such lines]" % (first, n))
        run = {}
        if line is not None:
            out.append(line)
    return out


def pstore_names():
    try:
        return sorted(os.listdir(PSTORE))
    except OSError:
        return []


def daemon_lines(rep):
    out = []
    for line in rep.tail(os.path.join(VAR_LOG, "messages"), 1 << 30).splitlines():
        m = rep._SYSLOG_LINE.match(line)
        # user.* and local*.* are what any program (logger) may send.
        if DAEMON.search(line) and not (m and m.group(1) not in rep._SYSLOG_FACILITY):
            out.append(line)
    return out


def scan(rep):
    lines = [l for l in dmesg().splitlines() if OOM.search(l)]
    rollback = [l for l in rep.read(UPDATE_LOG, 1024 * 1024).splitlines() if ROLLBACK.search(l)]
    # A record stays until removed, and the next crash may reuse its name:
    # its time tells them apart.
    stored = []
    for name in pstore_names():
        try:
            stored.append("%s@%d" % (name, os.stat(os.path.join(PSTORE, name)).st_mtime))
        except OSError:
            continue
    return {"oom": lines[-50:], "pstore": stored, "rollback": rollback[-50:],
            "daemon": daemon_lines(rep)[-50:]}


def sections(rep):
    out = [("root/dmesg.txt", dmesg_text(dmesg())),
           ("root/update.log", rep.tail(UPDATE_LOG))]
    try:
        names = sorted(n for n in os.listdir(VAR_LOG) if LOGS.match(n))
    except OSError:
        names = []
    for name in names:
        text = rep.tail(os.path.join(VAR_LOG, name))
        if name == "messages":
            text = rep.keep_syslog(text)
        out.append(("root/var-log/" + name, text))
    for name in pstore_names():
        out.append(("root/pstore/" + name, rep.read(os.path.join(PSTORE, name), 64 * 1024)))
    return out


def main(argv):
    rep = report()
    cmd = argv[1] if len(argv) == 2 else ""
    if cmd == "scan":
        found = scan(rep)
        print(json.dumps({k: [rep.clean(x) for x in v] for k, v in found.items()},
                         ensure_ascii=False))
        return 0
    if cmd == "sections":
        # JSON: no log line can pass itself off as another section.
        print(json.dumps({name: rep.clean(text) for name, text in sections(rep)},
                         ensure_ascii=False))
        return 0
    sys.stderr.write("usage: haltia-report-root scan|sections\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
