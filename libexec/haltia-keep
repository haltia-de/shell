#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# haltia-keep [--session] COMMAND [ARGS...]: run a daemon of the session and
# start it again when it ends (haltia-launcher: the home screen, «✕», the
# window watcher, volume keys, turning, badges).
#
# A second later each time; more than MAX ends within WINDOW seconds mean
# it cannot run here, and it is left off (said in its log). --session: it
# stops for good with the session, when the compositor's socket is gone or
# is another compositor's (the session loop starts the next one under the
# same name at once). One that ends well (0) within its first QUIET
# seconds has nothing to do (another copy holds its lock) and stays off. A
# SIGTERM to this script stops the daemon too; a
# SIGTERM to the daemon alone (haltia-restart after an update, haltia-apps
# reload) starts the new version.
MAX=5
WINDOW=60
QUIET=3
socket=${XDG_RUNTIME_DIR:-/nonexistent}/${WAYLAND_DISPLAY:-wayland-0}
session=
if [ "${1:-}" = --session ]; then
	session=$(stat -L -c %i "$socket" 2>/dev/null) || exit 1
	shift
fi
[ $# -gt 0 ] || { echo "usage: haltia-keep [--session] COMMAND [ARGS...]" >&2; exit 2; }
child=
trap '[ -n "$child" ] && kill "$child" 2>/dev/null; exit 0' TERM INT HUP
ends=
secs() {
	read -r up _ </proc/uptime
	echo "${up%%.*}"
}
while :; do
	began=$(secs)
	"$@" &
	child=$!
	wait "$child"
	code=$?
	child=
	if [ -n "$session" ] && [ "$(stat -L -c %i "$socket" 2>/dev/null)" != "$session" ]; then
		exit 0
	fi
	now=$(secs)
	if [ "$code" -eq 0 ] && [ $((now - began)) -lt "$QUIET" ]; then
		exit 0
	fi
	recent=
	n=0
	for t in $ends $now; do
		if [ $((now - t)) -lt "$WINDOW" ]; then
			recent="$recent $t"
			n=$((n + 1))
		fi
	done
	ends=$recent
	if [ "$n" -gt "$MAX" ]; then
		echo "haltia-keep: $1 ended $n times in ${WINDOW} s (last: $code), left off" >&2
		exit 1
	fi
	echo "haltia-keep: $1 ended ($code), starting it again" >&2
	sleep 1
done
