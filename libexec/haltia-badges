#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""Counts on panel buttons from the standard programs use on any desktop.

A program sets the number on its launcher with the Unity LauncherEntry
signal (what GNOME's Dash to Dock, KDE's task manager and Plank read):

    com.canonical.Unity.LauncherEntry.Update(
        "application://io.github.haltia_de.Messenger.desktop",
        {"count": <int64 4>, "count-visible": <true>})

haltia-badges (started by haltia-launcher) hears it on the session bus and hands
the number to the panel: $XDG_RUNTIME_DIR/haltia/badge/<id>, which
haltia-launch status shows on the button, then the button is told (badge()). The program is found in the session's
apps.conf by its id, or by an app_ids word, which is how a program still
under its old shell id (max, with app_ids b8k.Max) is found; an old or a
new id of a program renamed with Haltia 2.0 (haltia-apps' aliases, and
RENAMED) finds the other. A count that
is not visible, or a program leaving the bus, clears the number.

It also follows the media players on the bus (MPRIS: any
org.mpris.MediaPlayer2.* name, found by its DesktopEntry): a player that
plays or is paused writes "Playing <bus name>" or "Paused <bus name>" to
$XDG_RUNTIME_DIR/haltia/play/<id>, which haltia-launch status marks on the
button (▶ or ‖) and haltia-ask media uses to pause or stop it; stopped, or
gone from the bus, removes the file.

And it tells the panel when a program records from a microphone (a
PulseAudio source output on anything but a monitor, read again only when
pactl subscribe tells of a source output) or uses a camera (a /dev/video*
open in one of the user's processes, looked at every REC_EVERY seconds,
only when the device has a camera and the screen is on): "mic", "cam" or
both in $XDG_RUNTIME_DIR/haltia/rec, then the panel's custom/rec
(signal REC_SIGNAL) reads it again (haltia-meter rec).
"""
import configparser
import glob
import os
import subprocess
import signal

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402


_panel = None


def panel():
    """haltia-panel-signal as a module (loaded on first use): signalling
    the panel, the one way."""
    global _panel
    if _panel is None:
        import importlib.machinery
        import importlib.util
        here = os.path.dirname(os.path.realpath(__file__))
        for path in (os.path.join(here, "haltia-panel-signal"),
                     os.path.join(here, "..", "bin", "haltia-panel-signal"),
                     "/usr/bin/haltia-panel-signal"):
            if os.path.exists(path):
                loader = importlib.machinery.SourceFileLoader("haltia_panel_signal", path)
                spec = importlib.util.spec_from_loader("haltia_panel_signal", loader)
                _panel = importlib.util.module_from_spec(spec)
                loader.exec_module(_panel)
                break
        else:
            raise OSError("haltia-panel-signal is missing")
    return _panel

SHARE = "/usr/share/haltia"


def apps_conf():
    """The session's apps.conf (haltia-apps), else the built-in one."""
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    session = os.path.join(run, "haltia", "apps.conf")
    return session if run and os.path.exists(session) else os.path.join(SHARE, "apps.conf")


def panel_signal(app_id):
    """The program's waybar signal (haltia-apps numbers the buttons by their
    place on the panel); 0 when it has no button."""
    try:
        with open(apps_conf(), encoding="utf-8") as fh:
            inside = False
            for line in fh:
                line = line.strip()
                if line.startswith("["):
                    inside = line == "[%s]" % app_id
                elif inside and line.replace(" ", "").startswith("signal="):
                    return int(line.split("=", 1)[1])
    except (OSError, ValueError):
        pass
    return 0


def slot_signals():
    """The signals of the panel's slots (haltia-apps writes them): an open
    program without a button of its own shows in one of them."""
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        with open(os.path.join(run, "haltia", "slots")) as fh:
            return [int(l) for l in fh if l.strip().isdigit()]
    except OSError:
        return []


def badge(app_id, count):
    """Write the number haltia-launch shows on the program's button, then tell
    waybar to redraw it."""
    run = os.environ.get("XDG_RUNTIME_DIR")
    if not run:
        return
    folder = os.path.join(run, "haltia/badge")
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        path = os.path.join(folder, app_id)
        with open(path + ".new", "w") as fh:
            fh.write("%d\n" % count)
        os.replace(path + ".new", path)
    except OSError:
        return
    redraw(panel_signal(app_id))


def redraw(*sigs):
    """Tell waybar to redraw the modules on these signals. An uncaught
    real-time signal would kill the bar, and the whole session with it, so
    only a waybar that catches it gets one."""
    for sig in sigs:
        if sig > 0:
            send(signal.SIGRTMIN + sig)


def send(signum):
    try:
        panel().send(signum)
    except OSError:
        pass


shown = {}  # bus name -> the ids it set a count for


# Renamed with Haltia 2.0 (as in haltia-apps): old id -> new id.
RENAMED = dict([("io.github.trudenboy.%s" % n, "io.github.haltia_de.%s" % n)
                for n in ("Calendar", "Files", "Gallery", "Music", "News", "Paint", "Text",
                          "Video", "Weather")]
               + [("io.github.trudenboy.Max", "io.github.haltia_de.Messenger")])


def other_names(desktop_id):
    """The same program's other ids: haltia-apps' aliases, RENAMED either way."""
    names = []
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        with open(os.path.join(run, "haltia", "aliases")) as fh:
            for line in fh:
                parts = line.split()
                if len(parts) == 2 and desktop_id in parts:
                    names.append(parts[1] if parts[0] == desktop_id else parts[0])
    except OSError:
        pass
    names += [n for o, n in RENAMED.items() if o == desktop_id]
    names += [o for o, n in RENAMED.items() if n == desktop_id]
    return names


def program_of(desktop_id):
    """The apps.conf section for a .desktop id, or None."""
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(apps_conf(), encoding="utf-8")
    except configparser.Error:
        return None
    for name in [desktop_id] + other_names(desktop_id):
        if conf.has_section(name):
            return name
        for sec in conf.sections():
            if name in conf[sec].get("app_ids", "").split():
                return sec
    return None


def on_update(_bus, sender, _path, _iface, _signal, params, _data):
    try:
        uri, props = params.unpack()
    except (TypeError, ValueError):
        return
    if not uri.startswith("application://") or not uri.endswith(".desktop"):
        return
    desktop_id = uri[len("application://"):-len(".desktop")]
    if not desktop_id or "/" in desktop_id:
        return
    app = program_of(desktop_id)
    if app is None:
        return
    count = props.get("count", 0) if props.get("count-visible", False) else 0
    try:
        count = max(0, min(int(count), 9999))
    except (TypeError, ValueError):
        count = 0
    badge(app, count)
    shown.setdefault(sender, set()).add(app)


def on_owner(_bus, _sender, _path, _iface, _signal, params, _data):
    name, _old, new = params.unpack()
    if new or name not in shown:
        return
    for app in shown.pop(name):  # the program left the bus: no count from it now
        badge(app, 0)


MPRIS = "org.mpris.MediaPlayer2"
players = {}  # unique bus name -> [well-known name, apps.conf id or None]


def play_mark(app_id, status, name):
    """The player's state for the panel: a file while it plays or is
    paused, none when stopped; then its button and the slots redraw."""
    run = os.environ.get("XDG_RUNTIME_DIR")
    if not run or not app_id:
        return
    folder = os.path.join(run, "haltia/play")
    path = os.path.join(folder, app_id)
    try:
        if status in ("Playing", "Paused"):
            os.makedirs(folder, mode=0o700, exist_ok=True)
            with open(path + ".new", "w") as fh:
                fh.write("%s %s\n" % (status, name))
            os.replace(path + ".new", path)
        elif os.path.exists(path):
            os.unlink(path)
        else:
            return
    except OSError:
        return
    redraw(panel_signal(app_id), *slot_signals())


def player_prop(bus, name, iface, prop):
    try:
        res = bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties",
                            "Get", GLib.Variant("(ss)", (iface, prop)),
                            GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 2000, None)
        return res.unpack()[0]
    except GLib.Error:
        return None


def add_player(bus, name, unique):
    """A player came onto the bus: whose it is (DesktopEntry, else the
    end of its bus name) and how it plays now."""
    entry = player_prop(bus, name, MPRIS, "DesktopEntry") or name[len(MPRIS) + 1:]
    app = program_of(entry)
    players[unique] = [name, app]
    play_mark(app, player_prop(bus, name, MPRIS + ".Player", "PlaybackStatus"), name)


def on_props(_bus, sender, _path, _iface, _signal, params, _data):
    try:
        iface, changed, _gone = params.unpack()
    except (TypeError, ValueError):
        return
    if iface != MPRIS + ".Player" or "PlaybackStatus" not in changed:
        return
    player = players.get(sender)
    if player:
        play_mark(player[1], changed["PlaybackStatus"], player[0])


REC_SIGNAL = 11
REC_EVERY = 10  # s: the camera has no events to follow


def short(*args):
    """pactl list short ...: rows of tab-separated fields."""
    try:
        out = subprocess.run(["pactl", "list", "short"] + list(args), capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [line.split("\t") for line in out.splitlines() if line.strip()]


def microphone():
    """Some program records from a source that is not a monitor (the
    speaker's own sound)."""
    names = {row[0]: row[1] for row in short("sources") if len(row) > 1}
    return any(len(row) > 1 and not names.get(row[1], "").endswith(".monitor")
               for row in short("source-outputs"))


def cameras():
    return glob.glob("/dev/video*")


def screen_on():
    """The backlight is lit (no backlight: a desktop, counted as on)."""
    lit = None
    for path in glob.glob("/sys/class/backlight/*/brightness"):
        try:
            with open(path) as fh:
                lit = bool(lit) or int(fh.read().strip() or 0) > 0
        except (OSError, ValueError):
            continue
    return lit is not False


def camera():
    """One of the user's processes has a video device open."""
    me = os.getuid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        fds = "/proc/%s/fd" % pid
        try:
            if os.stat("/proc/" + pid).st_uid != me:
                continue
            for fd in os.listdir(fds):
                if os.readlink(os.path.join(fds, fd)).startswith("/dev/video"):
                    return True
        except OSError:
            continue
    return False


class Recording:
    """custom/rec: what records now, told to the panel when it changes."""

    def __init__(self):
        run = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
        self.path = os.path.join(run, "haltia", "rec")
        self.shown = None
        self.pending = None
        self.mic = microphone()
        self.cam = False
        self.look_camera()
        GLib.timeout_add_seconds(REC_EVERY, self.look_camera)
        self.follow()

    def look_camera(self):
        """The camera: no events to follow, so a look every REC_EVERY
        seconds, and none on a device without one or with the screen dark
        (nobody sees the panel then; it is looked at again when it lights)."""
        if cameras() and screen_on():
            self.cam = camera()
        elif not cameras():
            self.cam = False
        self.show()
        return True

    def check(self):
        """A source output came or went: the microphone read again."""
        self.pending = None
        self.mic = microphone()
        self.show()
        return False

    def show(self):
        now = " ".join(w for w, on in (("mic", self.mic), ("cam", self.cam)) if on)
        if now != self.shown:
            self.shown = now
            try:
                if now:
                    with open(self.path + ".new", "w") as fh:
                        fh.write(now + "\n")
                    os.replace(self.path + ".new", self.path)
                elif os.path.exists(self.path):
                    os.unlink(self.path)
            except OSError:
                pass
            redraw(REC_SIGNAL)

    def soon(self):
        # Events come in bursts (a stream is made, then moved, then runs).
        if self.pending is None:
            self.pending = GLib.timeout_add(200, self.check)

    def follow(self):
        """pactl subscribe, line by line; again 5 s after it ends (the
        sound server restarted)."""
        # Its event lines are translated ("Событие «появление» в отношении
        # выхода источника"): in C, they name a source-output.
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE |
                                              Gio.SubprocessFlags.STDERR_SILENCE)
        launcher.setenv("LC_ALL", "C", True)
        try:
            proc = launcher.spawnv(["pactl", "subscribe"])
        except GLib.Error:
            GLib.timeout_add_seconds(5, lambda: self.follow() and False)
            return
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def got(src, result):
            try:
                line, _len = src.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                self.soon()
                GLib.timeout_add_seconds(5, lambda: self.follow() and False)
                return
            if "source-output" in line:
                self.soon()
            src.read_line_async(GLib.PRIORITY_DEFAULT, None, got)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    Recording()

    def on_player_owner(_bus, _sender, _path, _iface, _signal, params, _data):
        name, old, new = params.unpack()
        if not name.startswith(MPRIS + "."):
            return
        if old and old in players:
            gone = players.pop(old)
            play_mark(gone[1], "Stopped", gone[0])
        if new:
            add_player(bus, name, new)

    bus.signal_subscribe(None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         "/org/mpris/MediaPlayer2", None, Gio.DBusSignalFlags.NONE, on_props,
                         None)
    bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                         "/org/freedesktop/DBus", None, Gio.DBusSignalFlags.NONE,
                         on_player_owner, None)
    # Players already on the bus (haltia-badges restarted with the session).
    run = os.environ.get("XDG_RUNTIME_DIR")
    if run:
        for old in glob.glob(os.path.join(run, "haltia/play", "*")):
            try:
                os.unlink(old)
            except OSError:
                pass
    names = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "ListNames", None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE,
                          -1, None).unpack()[0]
    for name in names:
        if name.startswith(MPRIS + "."):
            try:
                unique = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                       "org.freedesktop.DBus", "GetNameOwner",
                                       GLib.Variant("(s)", (name,)), GLib.VariantType("(s)"),
                                       Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
            except GLib.Error:
                continue
            add_player(bus, name, unique)
    bus.signal_subscribe(None, "com.canonical.Unity.LauncherEntry", "Update", None, None,
                         Gio.DBusSignalFlags.NONE, on_update, None)
    bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                         "/org/freedesktop/DBus", None, Gio.DBusSignalFlags.NONE, on_owner,
                         None)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
