#!/usr/bin/python3
"""Power key: screen off and on, the power menu, and system sleep.

A short press of the power key turns the lamp off or on when the key is
released; holding it for a second opens the power menu (haltia-ask power)
in the user's session instead. Ten minutes without a touch or a key turn
the lamp off as a short press would, so a tablet left lying on the table
does not light the room for hours. Thirty seconds after the lamp goes off,
the system sleeps (s2idle), unless a charger powers it (a Mains or USB
power supply online: then it stays up with the lamp off, so Wi-Fi and the
messenger keep working and a call can wake the lamp): through the device's hook
/usr/lib/haltia/hooks/suspend when it is there (B8000-H moves its Wi-Fi
drivers out of the way in it), else by writing "freeze" to
/sys/power/state. A wake source (the power key) wakes it, and the same
press turns the lamp back on.

The hook runs as root with no arguments and must return once the system
is awake again, with what it took down brought back; its exit status is
only logged. The lamp and the touch screen are not its business: they stay
off and grabbed until a press of the power key, which this loop handles.

The power key is the key device named power_key= in
/etc/haltia/device.conf, else the first one with KEY_POWER. It is grabbed so
elogind cannot power the tablet off, and the other keys on it (Home on
B8000-H) are passed through.

A program holds the screen on, or the system awake, as on any desktop:
with a logind inhibitor in "block" mode — "idle" keeps the idle timer from
turning the lamp off (a video), "sleep" keeps the system from sleeping
while the lamp is off (music); haltia-kit's Awake takes "sleep:idle".
"""
import ctypes
import errno
import fcntl
import os
import pwd
import select
import shutil
import socket
import stat
import struct
import subprocess
import sys
import time

EV_SYN = 0
EV_KEY = 1
SYN_REPORT = 0
KEY_POWER = 116
BUS_VIRTUAL = 0x06

LEVEL_PATH = "/run/haltia/sleep/level"
# There while the screen is off on purpose: haltia-brightness --restore (a
# session started again in the dark) leaves it off.
DARK_PATH = "/run/haltia/screen-dark"
LONG_PRESS = 1.0  # seconds held before the power menu opens
SUSPEND_AFTER = 30.0  # seconds with the screen off before a system sleep
IDLE_OFF = 600.0  # seconds without any input before the screen goes off
# Настройки → Экран, read from the session user's ~/.config/haltia/screen:
#   off_after=SECONDS     instead of IDLE_OFF
#   charging=on           the screen stays on while the tablet charges
SCREEN_CONF = ".config/haltia/screen"
SCREEN_CHECK = 30.0  # seconds between looks at that file and the charger
RESCAN_SEC = 30.0  # how often the input devices are looked at again
# A suspend hook that is still running this long (awake time: the clock
# stops while the system sleeps) is stuck: logged and killed.
SUSPEND_DEADLINE = 120.0
FILTER_NAME = "haltia-touchguard touchscreen"
NOTHING_TO_DO = 3  # exit status: no power key; haltia-sleep-loop stops
POWER_SUPPLY = "/sys/class/power_supply"
SUSPEND_HOOK = "/usr/lib/haltia/hooks/suspend"
POWER_STATE = "/sys/power/state"
DEVICE_CONF = "/etc/haltia/device.conf"


class Timeval(ctypes.Structure):
    _fields_ = [("sec", ctypes.c_long), ("usec", ctypes.c_long)]


class InputEvent(ctypes.Structure):
    _fields_ = [
        ("time", Timeval),
        ("type", ctypes.c_uint16),
        ("code", ctypes.c_uint16),
        ("value", ctypes.c_int32),
    ]


class InputId(ctypes.Structure):
    _fields_ = [
        ("bustype", ctypes.c_uint16),
        ("vendor", ctypes.c_uint16),
        ("product", ctypes.c_uint16),
        ("version", ctypes.c_uint16),
    ]


class UinputSetup(ctypes.Structure):
    _fields_ = [
        ("id", InputId),
        ("name", ctypes.c_char * 80),
        ("ff_effects_max", ctypes.c_uint32),
    ]


def _ioc(direction, type_, nr, size):
    return (direction << 30) | (size << 16) | (type_ << 8) | nr


def _iow(type_, nr, size):
    return _ioc(1, type_, nr, size)


def _io(type_, nr):
    return _ioc(0, type_, nr, 0)


EVIOCGRAB = _iow(ord("E"), 0x90, ctypes.sizeof(ctypes.c_int))
UI_SET_EVBIT = _iow(ord("U"), 100, ctypes.sizeof(ctypes.c_int))
UI_SET_KEYBIT = _iow(ord("U"), 101, ctypes.sizeof(ctypes.c_int))
UI_DEV_SETUP = _iow(ord("U"), 3, ctypes.sizeof(UinputSetup))
UI_DEV_CREATE = _io(ord("U"), 1)


def log(msg):
    print(msg, flush=True)


def device_conf(key):
    """A value of /etc/haltia/device.conf (key=value lines), or ""."""
    try:
        with open(DEVICE_CONF) as fh:
            for line in fh:
                name, sep, val = line.partition("=")
                if sep and name.strip() == key:
                    return val.strip()
    except OSError:
        pass
    return ""


def backlight_path():
    # haltia-brightness looks the lamp up alike.
    root = "/sys/class/backlight"
    name = device_conf("backlight")
    if not name:
        names = sorted(os.listdir(root))
        if not names:
            raise SystemExit("NO_BACKLIGHT")
        name = names[0]
    return os.path.join(root, name, "brightness")


def hook(name):
    """The system's hooks for name (haltia-hook, /etc/haltia/hooks)."""
    try:
        subprocess.call(["/usr/libexec/haltia/haltia-hook", name])
    except OSError:
        pass


UPDATE = "/usr/libexec/haltia/haltia-update"
UPDATE_STATE = "/var/lib/haltia/update"
UPDATE_NOTIFY = "/usr/libexec/haltia/haltia-update-notify"
UPDATE_EVERY = 20 * 3600  # seconds between looks for updates


_screen = {"at": -SCREEN_CHECK, "off": IDLE_OFF, "keep": False, "charging": False}


def read_user_file(path, uid, limit=4096):
    """A small file of the user's, read as root without trusting it: never
    through a symbolic link (opening /dev/watchdog or another device has
    effects of its own), opened without blocking (a FIFO would stop the
    power key's loop), taken only when what was opened is a regular file
    of that user, and at most limit bytes of it."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC |
                 os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
            raise OSError(errno.EPERM, "not a regular file of the user", path)
        return os.read(fd, limit).decode("utf-8", "replace")
    finally:
        os.close(fd)


def idle_off():
    """Seconds without input before the screen goes off, as Настройки set
    it (IDLE_OFF otherwise); None while it stays on (charging, when asked)."""
    now = time.monotonic()
    if now - _screen["at"] >= SCREEN_CHECK:
        _screen["at"] = now
        off, keep = IDLE_OFF, False
        found = session_env()
        if found:
            try:
                home = pwd.getpwuid(found[1]).pw_dir
                text = read_user_file(os.path.join(home, SCREEN_CONF), found[1])
                for line in text.splitlines():
                    key, sep, val = line.partition("=")
                    key, val = key.strip(), val.strip()
                    if sep and key == "off_after" and val.isdigit() and int(val) >= 30:
                        off = float(val)
                    elif sep and key == "charging":
                        keep = val == "on"
            except (OSError, KeyError):
                pass
        _screen.update(off=off, keep=keep, charging=keep and charging())
    if _screen["keep"] and _screen["charging"]:
        return None
    return _screen["off"]


_power = {"at": -SCREEN_CHECK, "on": False}


def external_power():
    """Whether a charger powers the tablet now: a power supply of type
    Mains or USB (USB_DCP, USB_PD...) that is online. Not the battery's
    status: a full battery says Full, and some chargers report Not
    charging while they power the system. Looked at once in SCREEN_CHECK."""
    now = time.monotonic()
    if now - _power["at"] < SCREEN_CHECK:
        return _power["on"]
    on = False
    try:
        names = os.listdir(POWER_SUPPLY)
    except OSError:
        names = []
    for name in names:
        base = os.path.join(POWER_SUPPLY, name)
        try:
            with open(os.path.join(base, "type")) as fh:
                kind = fh.read().strip()
            with open(os.path.join(base, "online")) as fh:
                online = fh.read().strip() == "1"
        except OSError:
            continue
        if online and (kind == "Mains" or kind.startswith("USB")):
            on = True
            break
    if on != _power["on"]:
        log("POWER %s" % ("external" if on else "battery"))
    _power.update(at=now, on=on)
    return on


def charging():
    """On the charger, or with no battery at all (a desktop): from sysfs,
    cached. Asking upower (haltia-meter, up to 10 s) here held up the power
    key and made haltia-wake give up on a ringing call (SH2-26)."""
    if external_power():
        return True
    try:
        names = os.listdir(POWER_SUPPLY)
    except OSError:
        return True
    for name in names:
        try:
            with open(os.path.join(POWER_SUPPLY, name, "type")) as fh:
                if fh.read().strip() == "Battery":
                    return False
        except OSError:
            continue
    return True


def updates_when_dark():
    """At most once in UPDATE_EVERY, when the screen goes off on the charger:
    look for updates, and with auto=yes (/etc/haltia/update.conf) install
    them. haltia-update holds a sleep inhibitor while apk works, so the
    system stays up for it (suspend_due reads the inhibitors)."""
    if not os.access(UPDATE, os.X_OK) or not charging():
        return
    stamp = os.path.join(UPDATE_STATE, "last-look")
    try:
        if time.time() - os.path.getmtime(stamp) < UPDATE_EVERY:
            return
    except OSError:
        pass
    # A full or read-only /var must not end the daemon on every screen-off
    # (SH2-28): no stamp, no look this time.
    try:
        os.makedirs(UPDATE_STATE, exist_ok=True)
        open(stamp, "w").close()
    except OSError as exc:
        log("UPDATES_STAMP_FAIL %s" % exc.errno)
        return
    auto = False
    try:
        auto = any(line.strip() == "auto=yes" for line in open("/etc/haltia/update.conf"))
    except OSError:
        pass
    cmd = "%s check >/dev/null" % UPDATE
    if auto:
        cmd += " && %s upgrade --auto" % UPDATE
    # Below the person's programs in both the processor and the disk: the
    # update is no hurry, the screen coming back is.
    lower = ["nice", "-n", "10"]
    if shutil.which("ionice"):
        lower += ["ionice", "-c", "2", "-n", "7"]
    try:
        subprocess.Popen(lower + ["sh", "-c", cmd + " >>/var/log/haltia-update.log 2>&1"],
                         start_new_session=True)
        log("UPDATES %s" % ("auto" if auto else "look"))
    except OSError as exc:
        log("UPDATES_FAIL %s" % exc.errno)


def updates_when_light():
    """Updates found while dark and not installed by themselves: say so once,
    when the person is back (a notification while dark would time out)."""
    try:
        with open(os.path.join(UPDATE_STATE, "status.json")) as fh:
            status = __import__("json").load(fh)
    except (OSError, ValueError):
        return
    # What it did by itself (updated, went back), when not told yet.
    try:
        with open(os.path.join(UPDATE_STATE, "news.json")) as fh:
            news = __import__("json").load(fh)
    except (OSError, ValueError):
        news = []
    if any(not n.get("told") for n in news):
        as_session_user([UPDATE_NOTIFY])
    told = os.path.join(UPDATE_STATE, "told")
    if not status.get("available") or os.path.exists(told) and \
            os.path.getmtime(told) >= status.get("checked", 0):
        return
    try:
        open(told, "w").close()
    except OSError as exc:
        log("UPDATES_TOLD_FAIL %s" % exc.errno)
        return
    as_session_user([UPDATE_NOTIFY, "Есть обновления",
                     "Нажмите, чтобы узнать, что нового, и обновить"])


def read_level(path):
    with open(path) as fh:
        return int(fh.read().strip() or "0")


def write_level(path, level):
    with open(path, "w") as fh:
        fh.write(str(int(level)))


def input_name(node):
    path = "/sys/class/input/%s/device/name" % node
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def has_key(node, code):
    """True when the input device's key bitmap (sysfs, hex words of the
    kernel's long, highest first) has that key."""
    try:
        with open("/sys/class/input/%s/device/capabilities/key" % node) as fh:
            words = fh.read().split()
    except OSError:
        return False
    bits = ctypes.sizeof(ctypes.c_long) * 8
    index = len(words) - 1 - code // bits
    return index >= 0 and bool(int(words[index], 16) >> (code % bits) & 1)


def find_power_key():
    nodes = sorted((n for n in os.listdir("/sys/class/input") if n.startswith("event")),
                   key=lambda n: int(n[5:]))
    name = device_conf("power_key")
    for node in nodes:
        if (input_name(node) == name) if name else has_key(node, KEY_POWER):
            return "/dev/input/" + node
    return ""


def can_freeze():
    try:
        with open(POWER_STATE) as fh:
            return "freeze" in fh.read().split()
    except OSError:
        return False


def suspend_command():
    """How the system sleeps: the device's hook, else s2idle by hand, else
    None (no sleep at all)."""
    if os.access(SUSPEND_HOOK, os.X_OK):
        return [SUSPEND_HOOK]
    if can_freeze():
        return ["/bin/sh", "-c", "sync; echo freeze >%s" % POWER_STATE]
    return None


def touch_nodes():
    """The touch devices to grab while dark: the filter's own while it runs
    (grabbing the real screen under it made a restarting filter fail with
    EBUSY), else the screens themselves."""
    found, filtered = [], []
    for node in sorted(os.listdir("/sys/class/input")):
        if not node.startswith("event"):
            continue
        name = input_name(node)
        if name == FILTER_NAME:
            filtered.append("/dev/input/" + node)
        elif "synaptics" in name.lower() or "touch" in name.lower():
            found.append("/dev/input/" + node)
    return filtered or found


def event_nodes():
    """The input devices there are now, to notice one coming or going (the
    touch filter haltia-touchguard replaces the screen with its own)."""
    return sorted(n for n in os.listdir("/sys/class/input") if n.startswith("event"))


def has_keys(node):
    """The device sends key or button events (EV_KEY): touch, buttons, a
    mouse. An accelerometer or a switch that only reports positions
    (EV_ABS, EV_MSC) is no sign of a person and would keep the screen on
    for good (SH2-32)."""
    try:
        with open("/sys/class/input/%s/device/capabilities/ev" % node) as fh:
            return bool(int(fh.read().strip() or "0", 16) & (1 << EV_KEY))
    except (OSError, ValueError):
        return True  # unknown: counted, as before


def activity_nodes(power_path):
    """Every input device that sends keys or buttons but the power key
    (read on its own), the vibration motor and our own Home forwarder:
    touch and buttons alike. They are opened without a grab, so the
    session still gets each event."""
    found = []
    for node in sorted(os.listdir("/sys/class/input")):
        if not node.startswith("event"):
            continue
        path = "/dev/input/" + node
        if path == power_path or input_name(node) in ("regulator-haptic", "haltia-home") or \
                not has_keys(node):
            continue
        try:
            found.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK))
        except OSError as exc:
            log("ACTIVITY_OPEN_FAIL %s %s" % (path, exc.errno))
    return found


def drain(fd):
    try:
        while os.read(fd, 4096):
            pass
    except OSError:
        pass


def saved_level(path):
    try:
        level = int(open(LEVEL_PATH).read().strip())
    except (OSError, ValueError):
        level = 0
    if level <= 0:
        max_path = os.path.join(os.path.dirname(path), "max_brightness")
        try:
            level = max(1, read_level(max_path) // 2)
        except OSError:
            level = 116
    return level


def mark_dark(dark):
    try:
        if dark:
            os.makedirs(os.path.dirname(DARK_PATH), exist_ok=True)
            open(DARK_PATH, "w").close()
        elif os.path.lexists(DARK_PATH):
            os.unlink(DARK_PATH)
    except OSError as exc:
        log("DARK_MARK_FAIL %s" % exc.errno)


def remember(level):
    os.makedirs(os.path.dirname(LEVEL_PATH), exist_ok=True)
    tmp = LEVEL_PATH + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(str(int(level)))
    os.rename(tmp, LEVEL_PATH)


class Lamp:
    def __init__(self):
        self.path = backlight_path()
        self.touch = []
        self.asleep = read_level(self.path) <= 0
        self.since = time.monotonic()
        self.suspender = None
        self.suspend_started = 0.0
        self.stuck_told = False
        mark_dark(self.asleep)
        if self.asleep:
            self._grab_touch()

    def press(self):
        if self.asleep:
            self.wake()
        else:
            self.sleep()

    def sleep(self):
        current = read_level(self.path)
        if current > 0:
            remember(current)
        self._grab_touch()
        mark_dark(True)
        write_level(self.path, 0)
        kick_frame()
        self.asleep = True
        self.since = time.monotonic()
        log("SLEEP")
        hook("screen-off")
        updates_when_dark()

    def wake(self):
        mark_dark(False)
        write_level(self.path, saved_level(self.path))
        kick_frame()
        self._ungrab_touch()
        self.asleep = False
        log("WAKE")
        hook("screen-on")
        updates_when_light()

    def suspend_due(self):
        """Seconds until the screen-off timer asks for a system sleep."""
        if not self.asleep or suspend_command() is None:
            return None
        if external_power():
            # On the charger the system stays up with the screen off: Wi-Fi
            # and the messenger keep working, a call wakes the screen
            # (calls plan, step 7). Unplugged while dark, it sleeps
            # SUSPEND_AFTER later; look again then.
            self.since = time.monotonic()
            return SCREEN_CHECK
        if awake_held("suspend"):
            self.since = time.monotonic()  # check again a full delay later
        if self.suspender is not None:
            if self.suspender.poll() is None:
                if time.monotonic() - self.suspend_started < SUSPEND_DEADLINE:
                    return None  # asleep or just woken; it is still running
                # Stuck (a module reload that hangs, sync on a hung card):
                # without this the tablet never slept again.
                if not self.stuck_told:
                    log("SUSPEND_STUCK %d s" % SUSPEND_DEADLINE)
                    self.stuck_told = True
                try:
                    os.killpg(self.suspender.pid, 9)
                    self.suspender.wait(timeout=1)
                except (OSError, subprocess.TimeoutExpired):
                    return None  # unkillable (D state): nothing more to do
            self.suspender = None
            self.stuck_told = False
            self.since = time.monotonic()  # woke without a key: wait again
        return max(0.0, self.since + SUSPEND_AFTER - time.monotonic())

    def suspend(self):
        # A child does the sleep, so this loop is ready for the key that
        # wakes the tablet.
        try:
            command = suspend_command()
            # Its own process group, so a stuck hook dies with its children.
            self.suspender = subprocess.Popen(command, start_new_session=True)
            self.suspend_started = time.monotonic()
            log("SUSPEND %s" % command[0])
        except (OSError, TypeError) as exc:
            log("SUSPEND_FAIL %s" % getattr(exc, "errno", exc))
            self.since = time.monotonic()

    def _grab_touch(self):
        self._ungrab_touch()
        for path in touch_nodes():
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                fcntl.ioctl(fd, EVIOCGRAB, 1)
            except OSError as exc:
                log("TOUCH_GRAB_FAIL %s %s" % (path, exc.errno))
                continue
            self.touch.append(fd)
            log("TOUCH_GRAB %s" % path)

    def _ungrab_touch(self):
        for fd in self.touch:
            try:
                fcntl.ioctl(fd, EVIOCGRAB, 0)
            except OSError:
                pass
            os.close(fd)
        self.touch = []


# Only these variables reach the menu; anything else in the panel's
# environment (LD_PRELOAD, PATH...) is not trusted by a root process.
SESSION_VARS = ("WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
                "LANG", "NO_AT_BRIDGE", "GTK_A11Y", "GTK_THEME")


def session_user():
    # desktop.start runs the session as this user, or as root without it.
    try:
        path = "/etc/haltia/session-user"
        if not os.path.exists(path):
            path = "/etc/b8k/session-user"  # the old place, until 3.0
        name = open(path).read().strip()
        pwd.getpwnam(name)
        return name
    except (OSError, KeyError):
        return "root"


_inhibit = {"bus": None, "last": {}}


def inhibited(what):
    """True while some process holds a logind "block" inhibitor for what
    ("idle" or "sleep"). Delay inhibitors (NetworkManager's) do not count.
    One system bus connection, kept, and a short call: a fresh connection
    each time could take its Hello 25 s in this loop. A failed look keeps
    the last answer rather than letting a playing video's inhibitor lapse
    (SH2-27)."""
    try:
        from gi.repository import Gio, GLib

        bus = _inhibit["bus"]
        if bus is None or bus.is_closed():
            bus = _inhibit["bus"] = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        res = bus.call_sync("org.freedesktop.login1", "/org/freedesktop/login1",
                            "org.freedesktop.login1.Manager", "ListInhibitors", None,
                            GLib.VariantType("(a(ssssuu))"), Gio.DBusCallFlags.NONE,
                            1000, None)
    except Exception as exc:  # no logind, no gi, or slow: the last answer
        log("INHIBIT_LIST_FAIL %s" % type(exc).__name__)
        return _inhibit["last"].get(what, False)
    held = any(mode == "block" and what in whats.split(":")
               for whats, _who, _why, mode, _uid, _pid in res.unpack()[0])
    _inhibit["last"][what] = held
    return held


def awake_held(kind):
    """True while a program keeps the screen on ("screen") or the system up
    ("suspend") with a logind block inhibitor."""
    return inhibited("idle" if kind == "screen" else "sleep")


def session_env():
    """Environment, uid and gid of the session, taken from its panel.

    The panel is the process running the real /usr/bin/waybar, not any
    process that calls itself waybar, and its runtime directory must be the
    one logind made for its uid.
    """
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.readlink("/proc/%s/exe" % pid) != "/usr/bin/waybar":
                continue
            with open("/proc/%s/environ" % pid, "rb") as fh:
                raw = fh.read().split(b"\0")
            st = os.stat("/proc/%s" % pid)
        except OSError:
            continue
        env = {}
        for item in raw:
            key, sep, val = item.partition(b"=")
            key = key.decode(errors="replace")
            if sep and key in SESSION_VARS:
                env[key] = val.decode(errors="replace")
        if env.get("XDG_RUNTIME_DIR") != "/run/user/%d" % st.st_uid:
            continue
        try:
            user = pwd.getpwuid(st.st_uid)
        except KeyError:
            continue
        if user.pw_name != session_user():
            continue
        env.update(HOME=user.pw_dir, USER=user.pw_name, LOGNAME=user.pw_name,
                   PATH="/usr/local/bin:/usr/bin:/bin")
        return env, st.st_uid, st.st_gid
    return None


def as_session_user(argv):
    """Start argv in the user's session; False when there is no session."""
    found = session_env()
    if not found:
        return False
    env, uid, gid = found
    groups = os.getgrouplist(env["USER"], gid)
    # The ids are dropped by subprocess itself, in C between fork and exec:
    # no Python in the child, so no lock left held by another thread of this
    # one can hang it before exec (SH2-25). SCHED_RESET_ON_FORK already
    # starts the child at nice 0 with no real-time priority.
    try:
        subprocess.Popen(argv, env=env, cwd=env["HOME"], user=uid, group=gid,
                         extra_groups=groups, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError as exc:
        log("SESSION_START_FAIL %s %s" % (argv[0], exc.errno))
        return False
    return True


def kick_frame():
    # The BLS PWM duty is latched at the start of a display frame, and phoc
    # sends no frames while nothing on screen changes, so a new brightness
    # could wait seconds for the clock to redraw. A screen capture makes
    # phoc render one frame now; the picture itself is thrown away.
    try:
        as_session_user(["grim", "-t", "ppm", "/dev/null"])
    except OSError as exc:
        log("KICK_FAIL %s" % exc.errno)


def power_menu():
    try:
        if as_session_user(["/usr/bin/haltia-ask", "power"]):
            log("MENU")
        else:
            log("MENU_NO_SESSION")
    except OSError as exc:
        log("MENU_FAIL %s" % exc.errno)


def check():
    path = backlight_path()
    current = read_level(path)
    off = current
    try:
        write_level(path, 0)
        time.sleep(0.35)
        off = read_level(path)
    finally:
        write_level(path, current if current > 0 else saved_level(path))
    restored = read_level(path)
    log("CHECK off=%s restored=%s was=%s" % (off, restored, current))
    if off != 0 or restored != (current if current > 0 else saved_level(path)):
        return 1
    return 0


WAKE_SOCKET = "/run/haltia/wake.sock"
WAKE_EVERY = 15.0  # s: at most one wake of a dark screen this often


def open_wake_socket():
    """The session's way to turn the screen on (haltia-wake: an incoming
    call). Anyone may connect; only root and the session user are heard."""
    try:
        os.unlink(WAKE_SOCKET)
    except OSError:
        pass
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
    sock.bind(WAKE_SOCKET)
    os.chmod(WAKE_SOCKET, 0o666)
    sock.listen(4)
    sock.setblocking(False)
    return sock


def wake_request(sock):
    """One connection on the wake socket: True when it comes from root or
    the session user (SO_PEERCRED, looked at first: anyone else is closed
    at once, unread) and asks to wake. Only those get 0.2 s to say so,
    inside this real-time loop."""
    try:
        conn, _addr = sock.accept()
    except OSError:
        return False
    with conn:
        try:
            creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                    struct.calcsize("3i"))
            _pid, uid, _gid = struct.unpack("3i", creds)
            if uid != 0 and uid != pwd.getpwnam(session_user()).pw_uid:
                return False
            conn.settimeout(0.2)
            if conn.recv(16).strip() == b"wake":
                conn.sendall(b"ok\n")
                return True
            conn.sendall(b"no\n")
        except (OSError, KeyError, struct.error):
            pass
    return False


def open_home_forward():
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
    fcntl.ioctl(fd, UI_SET_KEYBIT, 102)
    setup = UinputSetup()
    setup.id.bustype = BUS_VIRTUAL
    setup.name = b"haltia-home"
    raw = ctypes.string_at(ctypes.addressof(setup), ctypes.sizeof(setup))
    fcntl.ioctl(fd, UI_DEV_SETUP, raw)
    fcntl.ioctl(fd, UI_DEV_CREATE, 0)
    return fd


def emit(fd, ev_type, code, value):
    ev = InputEvent()
    ev.type = ev_type
    ev.code = code
    ev.value = value
    os.write(fd, ctypes.string_at(ctypes.addressof(ev), ctypes.sizeof(ev)))


def read_event(fd):
    need = ctypes.sizeof(InputEvent)
    buf = b""
    while len(buf) < need:
        chunk = os.read(fd, need - len(buf))
        if not chunk:
            raise EOFError("input closed")
        buf += chunk
    return InputEvent.from_buffer_copy(buf)


def listen():
    path = find_power_key()
    if not path:
        log("NO_POWER_KEY")
        return NOTHING_TO_DO
    power = os.open(path, os.O_RDONLY)
    home = None
    grabbed = False
    try:
        home = open_home_forward()
        log("HOME_OK")
    except OSError as exc:
        log("HOME_FAIL %s" % exc.errno)
        home = None
    if home is not None:
        try:
            fcntl.ioctl(power, EVIOCGRAB, 1)
            grabbed = True
            log("GRAB_OK %s" % path)
        except OSError as exc:
            log("GRAB_FAIL %s" % exc.errno)
    else:
        log("NO_GRAB")
    lamp = Lamp()
    try:
        waker = open_wake_socket()
    except OSError as exc:
        log("WAKE_SOCKET_FAIL %s" % exc.errno)
        waker = None
    woke_at = -WAKE_EVERY
    activity = activity_nodes(path)
    seen_nodes = event_nodes()
    last_input = time.monotonic()
    last = 0.0
    down = None  # press time while the key is held and not yet handled
    log("LISTEN asleep=%s activity=%d" % (int(lamp.asleep), len(activity)))
    while True:
        if down is None:
            # A device came or went: watch the ones there are now.
            nodes = event_nodes()
            if nodes != seen_nodes:
                for fd in activity:
                    os.close(fd)
                activity = activity_nodes(path)
                seen_nodes = nodes
                log("ACTIVITY_RESCAN %d" % len(activity))
                # The touch filter restarted while dark: its new device
                # must be grabbed too, or touches in a bag reach the program.
                if lamp.asleep:
                    lamp._grab_touch()
            due = lamp.suspend_due()
            idle = None
            off_after = idle_off()
            if not lamp.asleep and off_after is not None:
                idle = max(0.0, last_input + off_after - time.monotonic())
            # At least every RESCAN_SEC, to notice new devices.
            waits = [t for t in (due, idle, RESCAN_SEC) if t is not None]
            ready = select.select([power] + activity + ([waker] if waker else []), [], [],
                                  min(waits))[0]
            if waker in ready:
                ready.remove(waker)
                if wake_request(waker):
                    # A call: the screen comes on and stays a full idle
                    # time (the program holds it on while it rings). A
                    # dark screen wakes at most once in WAKE_EVERY: a
                    # program in a loop cannot keep turning it on.
                    now = time.monotonic()
                    if not lamp.asleep:
                        last_input = now
                    elif now - woke_at >= WAKE_EVERY:
                        woke_at = last_input = now
                        log("WAKE_ASKED")
                        lamp.wake()
                    else:
                        log("WAKE_TOO_SOON")
                    if not ready:
                        continue
            for fd in ready:
                if fd != power:
                    drain(fd)
                    last_input = time.monotonic()
            if power not in ready:
                if ready:
                    continue
                if lamp.asleep:
                    left = lamp.suspend_due()
                    if left is not None and left <= 0:
                        lamp.suspend()
                elif off_after is not None and time.monotonic() - last_input >= off_after:
                    if awake_held("screen"):
                        last_input = time.monotonic()  # a video is playing
                    else:
                        log("IDLE")
                        lamp.sleep()
                continue
        if down is not None:
            # Held: wait for the release, or open the menu at LONG_PRESS.
            left = LONG_PRESS - (time.monotonic() - down)
            if left <= 0 or not select.select([power], [], [], left)[0]:
                down = None
                if lamp.asleep:
                    lamp.wake()
                power_menu()
                continue
        ev = read_event(power)
        last_input = time.monotonic()
        if ev.type == EV_KEY and ev.code == KEY_POWER:
            now = time.monotonic()
            if ev.value == 1:
                if now - last >= 0.4:
                    down = now
            elif ev.value == 0 and down is not None:
                # A short press acts on release, so a hold for the menu
                # leaves the screen alone.
                down = None
                last = now
                lamp.press()
            continue
        if home is None or not grabbed:
            continue
        if ev.type == EV_KEY:
            emit(home, EV_KEY, ev.code, ev.value)
            emit(home, EV_SYN, SYN_REPORT, 0)


class SchedParam(ctypes.Structure):
    _fields_ = [("sched_priority", ctypes.c_int)]


def set_policy(policy, priority):
    """sched_setscheduler for this thread. musl leaves sched_setscheduler()
    unimplemented (ENOSYS: Python's os.sched_setscheduler there), so
    pthread_setschedparam, which passes the policy and its flags on to the
    kernel, does it."""
    try:
        os.sched_setscheduler(0, policy, os.sched_param(priority))
        return True
    except (OSError, AttributeError):
        pass
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        libc.pthread_self.restype = ctypes.c_ulong
        libc.pthread_setschedparam.argtypes = (ctypes.c_ulong, ctypes.c_int,
                                               ctypes.POINTER(SchedParam))
        return libc.pthread_setschedparam(libc.pthread_self(), policy,
                                          ctypes.byref(SchedParam(priority))) == 0
    except (OSError, AttributeError):
        return False


def raise_priority():
    # The press must act at once even with every core busy. The handler
    # sleeps in read() almost all the time, so real-time costs nothing.
    # SCHED_RESET_ON_FORK: what it starts (the nightly update, hooks, the
    # suspend hook) begins as an ordinary process with nice 0, instead of
    # inheriting real time, or nice -10, over the person's programs.
    reset = getattr(os, "SCHED_RESET_ON_FORK", 0x40000000)
    if set_policy(os.SCHED_FIFO | reset, 10):
        log("PRIO fifo")
        return
    set_policy(os.SCHED_OTHER | reset, 0)
    try:
        os.nice(-10)
        log("PRIO nice")
    except OSError:
        pass


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--check":
        return check()
    raise_priority()
    lock_path = "/run/haltia/sleep.lock"
    os.makedirs("/run", exist_ok=True)
    lock = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as exc:
        if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
            log("ALREADY_RUNNING")
            return 0
        raise
    try:
        return listen()
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except KeyboardInterrupt:
        sys.exit(0)
