#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""haltia-update-notify [TITLE BODY]: tell the person about updates.

Without arguments: what haltia-update did by itself since it was last
asked (haltia-update news through doas): «Обновлены: Музыка, Видео» after
updating by itself, «Обновление не прижилось» after going back by itself;
the programs it changed take up their new versions (haltia-restart).
With TITLE and BODY: that one notification (haltia-sleep's «Есть
обновления»).

A tap on the notification opens Настройки at «Обновления». The
notification goes over D-Bus (org.freedesktop.Notifications, mako), as
notify-send is not installed; it runs in the session (haltia-launcher, or
haltia-sleep as the session user) and waits until the notification is
tapped or gone.
"""
import os
import subprocess
import sys

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

UPDATE = ["doas", "-n", "/usr/libexec/haltia/haltia-update"]
WAIT = 15 * 60  # seconds a notification may stay before we stop waiting


def items():
    if len(sys.argv) == 3:
        return [(sys.argv[1], sys.argv[2])]
    try:
        out = subprocess.run(UPDATE + ["news"], capture_output=True, text=True,
                             timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    found = []
    changed = set()
    for line in out.splitlines():
        kind, _tab, rest = line.partition("\t")
        names, _tab, packages = rest.partition("\t")
        if kind in ("updated", "rolled back"):
            changed.update(packages.split())
        if kind == "updated":
            found.append(("Обновлены: %s" % names, "Нажмите, чтобы узнать, что нового"))
        elif kind == "rolled back":
            found.append(("Обновление не прижилось",
                          "Вернул прежнюю версию: %s" % names))
    if changed:
        # The new versions start: programs in the background at once, ones
        # with a window when they are next opened (haltia-restart).
        subprocess.Popen(["/usr/libexec/haltia/haltia-restart", *sorted(changed)],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return found


def open_updates():
    env = dict(os.environ, HALTIA_LAUNCH_ARGS="--page updates")
    subprocess.Popen(["/usr/bin/haltia-launch", "tap", "settings"], env=env,
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    todo = items()
    if not todo:
        return 0
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except GLib.Error as exc:
        sys.stderr.write("haltia-update-notify: %s\n" % exc.message)
        return 1
    loop = GLib.MainLoop()
    waiting = set()

    def signal(_conn, _sender, _path, _iface, name, params):
        nid = params.unpack()[0]
        if nid not in waiting:
            return
        if name == "ActionInvoked" and params.unpack()[1] == "default":
            open_updates()
        waiting.discard(nid)
        if not waiting:
            loop.quit()

    for name in ("ActionInvoked", "NotificationClosed"):
        bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications",
                             name, "/org/freedesktop/Notifications", None,
                             Gio.DBusSignalFlags.NONE, signal)
    for title, body in todo:
        try:
            res = bus.call_sync(
                "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications", "Notify",
                GLib.Variant("(susssasa{sv}i)", ("Настройки", 0, "io.github.haltia_de.Settings",
                                                 title, body, ["default", "Открыть"], {}, -1)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 10000, None)
            waiting.add(res.unpack()[0])
        except GLib.Error as exc:
            sys.stderr.write("haltia-update-notify: %s\n" % exc.message)
    if waiting:
        GLib.timeout_add_seconds(WAIT, loop.quit)
        loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
