#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# Keeps accidental touches off the screen (haltia-touchguard): brushes, a
# tremor's repeated strikes and a resting palm. Settings in
# /etc/haltia/touchguard.conf; reload reads them again without letting go of
# the screen (haltia-touch-settings changes them so).
#
# supervise-daemon starts it again when it ends (the screen went away, a
# crash), at most 10 times a minute; each start looks the screen up afresh.
# The filter writes its own pid to /run/haltia/touchguard.pid for signals
# (haltia-touchguard-conf); the service's pidfile is the supervisor's.
description="Filter for accidental touches"
supervisor=supervise-daemon
command=/usr/libexec/haltia/haltia-touchguard
respawn_delay=2
respawn_max=10
respawn_period=60
output_log=/var/log/haltia-touchguard.log
error_log=/var/log/haltia-touchguard.log
extra_started_commands="reload"
description_reload="Read the settings again"

start_pre() {
	# A device whose screen needs no filter says so in device.conf; a
	# runlevel link left from an earlier install must not grab its screen.
	if [ "$(sed -n 's/^[[:space:]]*touchguard[[:space:]]*=[[:space:]]*//p' \
		/etc/haltia/device.conf 2>/dev/null | tail -n 1)" = no ]; then
		eerror "touchguard=no in /etc/haltia/device.conf: this device runs without the filter"
		return 1
	fi
	checkpath -d -m 755 /run/haltia
}

stop_post() {
	rm -f /run/haltia/touchguard.pid
}

depend() {
	# Before the session and haltia-sleep (local.d) see the screen.
	before local
	after udev
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
	supervise-daemon "$RC_SVCNAME" --signal HUP
	eend $?
}
