#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# haltia-update's required check (/etc/haltia/health/required.d): the
# session is up, the panel, the home screen and the close button run.
for p in waybar haltia-home haltia-close; do
	pidof "$p" >/dev/null || { echo "$p is not running" >&2; exit 1; }
done
