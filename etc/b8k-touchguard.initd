#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-2.0
# Keeps accidental touches off the screen (b8k-touchguard): brushes, a
# tremor's repeated strikes and a resting palm. Settings in
# /etc/b8k/touchguard.conf; reload reads them again without letting go of
# the screen (b8k-touchguard-setup changes them so).
description="Filter for accidental touches"
command=/usr/sbin/b8k-touchguard
command_background=yes
pidfile=/run/b8k-touchguard.pid
output_log=/var/log/b8k-touchguard.log
error_log=/var/log/b8k-touchguard.log
extra_started_commands="reload"
description_reload="Read the settings again"

depend() {
	# Before the session and b8k-sleep (local.d) see the screen.
	before local
	after udev
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
	start-stop-daemon --signal HUP --pidfile "$pidfile"
	eend $?
}
