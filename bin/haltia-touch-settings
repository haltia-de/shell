#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
# The touch filter's settings (haltia-touchguard), for whoever looks after the
# tablet: every value of /etc/haltia/touchguard.conf as a large slider, a
# field to try touches in, and the filter's own word on each touch (taken,
# dropped as a brush, a repeat, a palm), which it writes to
# /run/haltia/touchguard.events while this window is open.
#
# A change goes to the filter at once (haltia-touchguard-conf through doas,
# which keeps the values where a finger still works, and a reload that
# keeps the screen grabbed), but only as a try in /run: it reaches
# /etc/haltia/touchguard.conf on «Оставить» (keep). Unless that is tapped
# within 15 s, the values go back to what was kept: a filter that no longer
# takes the finger undoes itself. Closing the window undoes what was not
# kept, too, and the helper drops a try nobody kept 20 s on by itself, so a
# window killed or crashed mid-try leaves nothing behind. The helper runs
# in one worker thread, in the order asked (Ordered), never on the GTK
# thread: doas and a shell are a second or so on the tablet.
#
# Настройки (haltia-settings) show the same as a page of «Для помощника»:
# Setup(embedded=True).widget, with enter() when the page opens and leave()
# when it goes. Its style is scoped to the class .touch, so it leaves the
# rest of the window alone. The page takes touch-settings.lock while it is
# open, as the window does, so the two never try values over each other.
import fcntl
import os
import re
import signal
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

CONF = "/etc/haltia/touchguard.conf"
if not os.path.exists(CONF) and os.path.exists("/etc/b8k/touchguard.conf"):
    CONF = "/etc/b8k/touchguard.conf"  # the old place, until 3.0
DEFAULTS = "/usr/share/haltia/touchguard.conf"
HELPER = "/usr/libexec/haltia/haltia-touchguard-conf"
EVENTS = "/run/haltia/touchguard.events"
CONFIRM_S = 15
APPLY_MS = 600  # a slider dragged is sent once it rests this long
LOG_RENEW_S = 10 * 60  # the filter logs for 15 minutes per request
AXES = "/run/haltia/touchguard.axes"  # the screen's axes, written by the filter
FRAC = 10000  # the fractions' unit: hundredths of a percent of the axis
# key: the axis it is a fraction of (the file writes it as "73.33%").
FRACTIONS = {"repeat_radius": "x", "tap_radius": "x", "palm_major": "major",
             "palm_pressure": "pressure"}


def read_axes():
    # The B8000-H's, until the filter has written the screen's own.
    axes = {"x": (0, 2230), "y": (0, 1250), "major": (0, 15), "pressure": (0, 255)}
    try:
        with open(AXES) as fh:
            for line in fh:
                parts = line.split()
                if len(parts) == 3:
                    axes[parts[0]] = (int(parts[1]), int(parts[2]))
    except (OSError, ValueError):
        pass
    return axes


AXIS = read_axes()


def span(axis):
    lo, hi = AXIS[axis]
    return max(1, hi - lo)


def screen_width():
    try:
        return Gdk.Display.get_default().get_monitor(0).get_geometry().width
    except AttributeError:
        return 1280


PX_PER_UNIT = screen_width() / span("x")  # the screen's units against pixels

