]


class Setup:
    def __init__(self, embedded=False):
        self.embedded = embedded
        self.ranges = read_ranges()
        self.defaults = read_conf(DEFAULTS)
        current = read_conf(CONF)
        self.kept = {}
        for key in LABELS:
            lo, hi = self.ranges.get(key, (0, 0))
            v = current.get(key, self.defaults.get(key, lo))
            self.kept[key] = min(max(v, lo), hi)
        self.applied = dict(self.kept)  # what the filter took
        self.sent = dict(self.kept)  # what it was asked last, maybe not answered yet
        self.worker = Ordered()
        self.epoch = 0  # turned by leave(): answers to what came before go unheard
        self.lock = None  # touch-settings.lock, while the page is open in Настройки
        self.scales = {}
        self.values = {}
        self.pending = None
        self.countdown = None
        self.left = 0
        self.log = None
        self.opening = None  # the epoch of a "log on" not answered yet
        self.renew = None
        self.taps = []  # (x, y, alpha) of what reached the window
        self.build()
        if not embedded:
            self.enter()

    # The window.

    def build(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # Everything in a box of class .touch, the scope of the style.
        self.widget = Gtk.Box()
        self.widget.get_style_context().add_class("touch")
        page = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20)
        page.get_style_context().add_class("page")
        for side in ("start", "end", "top", "bottom"):
            getattr(page, "set_margin_" + side)(16)
        self.widget.pack_start(page, True, True, 0)
        if not self.embedded:
            win = self.win = Gtk.Window(title="Касания")
            header = Gtk.HeaderBar(title="Касания")
            win.set_titlebar(header)
            win.connect("delete-event", self.on_close)
            win.add(self.widget)

        # Left: the settings.
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        page.pack_start(left, True, True, 0)
        if not self.ranges:
            note = Gtk.Label(label="Нет haltia-touchguard-conf: менять нечего", xalign=0)
            note.get_style_context().add_class("title")
            left.pack_start(note, False, False, 0)

        self.banner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        self.banner.get_style_context().add_class("banner")
        self.banner_text = Gtk.Label(xalign=0, wrap=True)
        self.banner_text.set_margin_start(20)
        self.banner.pack_start(self.banner_text, True, True, 0)
        undo = Gtk.Button(label="Вернуть")
        undo.get_style_context().add_class("action")
        undo.connect("clicked", lambda _b: self.revert())
        keep = Gtk.Button(label="Оставить")
        for cls in ("action", "keep"):
            keep.get_style_context().add_class(cls)
        keep.connect("clicked", lambda _b: self.keep())
        for b in (undo, keep):
            b.set_margin_top(10)
            b.set_margin_bottom(10)
        keep.set_margin_end(10)
        self.banner.pack_end(keep, False, False, 0)
        self.banner.pack_end(undo, False, False, 0)
        self.banner.set_no_show_all(True)
        left.pack_start(self.banner, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_kinetic_scrolling(True)
        left.pack_start(scroll, True, True, 0)
        rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        rows.set_margin_end(16)
        scroll.add(rows)
        for group, params in GROUPS:
            g = Gtk.Label(label=group, xalign=0)
            g.get_style_context().add_class("group")
            g.set_margin_top(10)
            rows.pack_start(g, False, False, 0)
            for key, title, hint, unit in params:
                if key in self.ranges:
                    rows.pack_start(self.row(key, title, hint, unit), False, False, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        reset = Gtk.Button(label="Как при установке")
        reset.get_style_context().add_class("action")
        reset.connect("clicked", lambda _b: self.set_all(self.defaults))
        reset.set_sensitive(bool(self.defaults))
        actions.pack_start(reset, False, False, 0)
        left.pack_start(actions, False, False, 0)

        # Right: the field to try touches in, and what the filter said.
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        right.set_size_request(420, -1)
        page.pack_start(right, False, False, 0)
        t = Gtk.Label(label="Проверка", xalign=0)
        t.get_style_context().add_class("group")
        right.pack_start(t, False, False, 0)
        h = Gtk.Label(label="Касайтесь здесь: засчитанное касание оставляет "
                      "синий круг", xalign=0, wrap=True, max_width_chars=30)
        h.get_style_context().add_class("hint")
        right.pack_start(h, False, False, 0)
        field = self.field = Gtk.DrawingArea()
        field.get_style_context().add_class("field")
        field.set_size_request(-1, 300)
        field.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK)
        field.connect("draw", self.draw_field)
        field.connect("button-press-event", self.on_tap)
        right.pack_start(field, False, False, 0)
        self.feed = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.feed.get_style_context().add_class("feed")
        right.pack_start(self.feed, True, True, 0)

        if not self.embedded:
            self.win.show_all()

    def row(self, key, title, hint, unit):
        lo, hi = self.ranges[key]
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.get_style_context().add_class("row")
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for side in ("start", "end", "top", "bottom"):
            getattr(inner, "set_margin_" + side)(16)
        box.pack_start(inner, True, True, 0)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("title")
        top.pack_start(t, True, True, 0)
        value = self.values[key] = Gtk.Label(xalign=1)
        value.get_style_context().add_class("value")
        top.pack_end(value, False, False, 0)
        inner.pack_start(top, False, False, 0)

        h = Gtk.Label(label=hint, xalign=0, wrap=True)
        h.get_style_context().add_class("hint")
        inner.pack_start(h, False, False, 0)

        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        value.set_text(show_value(key, unit, self.kept[key]))
        if unit == "bool":
            toggle = self.scales[key] = Toggle()
            toggle.set_value(self.kept[key])
            toggle.connect("notify::active", lambda w, _p: self.on_change(w, key, unit))
            line.pack_start(toggle, False, False, 0)
            inner.pack_start(line, False, False, 0)
            return box
        step = STEPS[unit]
        scale = self.scales[key] = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, lo, hi, step)
        scale.set_draw_value(False)
        scale.set_value(self.kept[key])
        scale.connect("value-changed", self.on_change, key, unit)
        scale.connect("scroll-event", lambda *_a: True)  # the page scrolls, not it
        minus = Gtk.Button(label="−")
        plus = Gtk.Button(label="+")
        for b, d in ((minus, -step), (plus, step)):
            b.get_style_context().add_class("step")
            b.connect("clicked", lambda _b, d=d: scale.set_value(scale.get_value() + d))
        line.pack_start(minus, False, False, 0)
        line.pack_start(scale, True, True, 0)
        line.pack_start(plus, False, False, 0)
        inner.pack_start(line, False, False, 0)
        return box

    # Changes.

    def current(self):
        return {k: int(round(s.get_value())) for k, s in self.scales.items()}

    def on_change(self, scale, key, unit):
        step = STEPS[unit]
        v = int(round(scale.get_value()))
        lo = self.ranges[key][0]
        snapped = lo + round((v - lo) / step) * step
        if unit in SNAP and snapped != v and snapped <= self.ranges[key][1]:
            scale.set_value(snapped)  # comes back here with the snapped value
            return
        self.values[key].set_text(show_value(key, unit, v))
        if self.pending is not None:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(APPLY_MS, self.apply)

    def apply(self):
        self.pending = None
        want = self.current()
        diff = ["%s=%d" % (k, v) for k, v in want.items() if self.sent.get(k) != v]
        if not diff:
            self.settled()
            return False
        # Back to what is kept: nothing to try any more. Otherwise the
        # change is tried (the helper drops it by itself unless kept).
        args = ("drop",) if want == self.kept else ("set",) + tuple(diff)
        self.sent = dict(want)
        epoch = self.epoch

        def done(err):
            if epoch != self.epoch:
                return
            if err:
                self.say("Не применено: " + err, "palm")
                # Asked again on the next change, unless a later try
                # asks something else anyway.
                for k, v in want.items():
                    if self.sent.get(k) == v:
                        self.sent[k] = self.applied.get(k)
            else:
                self.applied.update(want)
            self.settled()

        self.worker.submit(lambda: helper(*args), done)
        return False

    def settled(self):
        """The countdown while what the filter took differs from what is
        kept."""
        if self.applied != self.kept:
            self.left = CONFIRM_S
            if self.countdown is None:
                self.countdown = GLib.timeout_add_seconds(1, self.tick)
            self.show_banner()
        else:
            self.hide_banner()

    def set_all(self, values):
        for key, scale in self.scales.items():
            if key in values:
                scale.set_value(values[key])

    def keep(self):
        if self.pending is not None:
            GLib.source_remove(self.pending)
            self.apply()
        # The values themselves, not "what is tried": the helper's watch
        # may have dropped the try already. The worker sends them after the
        # tries before, so they are the values last asked.
        values = dict(self.sent)
        args = ["%s=%d" % (k, v) for k, v in values.items() if self.kept.get(k) != v]
        self.hide_banner()  # no revert while the answer is on its way
        epoch = self.epoch

        def done(err):
            if epoch != self.epoch:
                # The page went meanwhile: leave() showed the old values.
                if not err:
                    self.kept = values
                    self.reset_to(values)
                return
            if err:
                self.say("Не сохранено: " + err, "palm")
                self.settled()
                return
            self.kept = values
            self.hide_banner()
            self.say("Настройки сохранены", "ok")

        self.worker.submit(lambda: helper("keep", *args), done)

    def reset_to(self, values):
        """The sliders show values, which the filter has: nothing to send."""
        self.applied = dict(values)
        self.sent = dict(values)
        self.set_all(values)
        if self.pending is not None:  # set_all's own change
            GLib.source_remove(self.pending)
            self.pending = None

    def revert(self):
        self.set_all(self.kept)
        if self.pending is not None:
            GLib.source_remove(self.pending)
        self.apply()  # nothing differs from what is kept now: no countdown

    def tick(self):
        self.left -= 1
        if self.left <= 0:
            self.countdown = None
            self.revert()
            self.say("Изменения отменены: «Оставить» не нажали", "drop")
            return False
        self.show_banner()
        return True

    def show_banner(self):
        self.banner_text.set_text(
            "Попробуйте касания справа. Через %d с вернётся как было" % self.left)
        self.banner.set_no_show_all(False)
        self.banner.show_all()

    def hide_banner(self):
        if self.countdown is not None:
            GLib.source_remove(self.countdown)
            self.countdown = None
        self.banner.hide()

    def enter(self):
        """The page is on screen: the filter tells its decisions. False in
        Настройки while the window of its own is open (it holds the lock)."""
        if self.embedded and self.lock is None:
            self.lock = take_lock()
            if self.lock is None:
                return False
        if self.log is None and self.opening != self.epoch:
            self.open_log()
        if self.renew is None:
            self.renew = GLib.timeout_add_seconds(LOG_RENEW_S, self.renew_log)
        return True

    def leave(self):
        """The page goes: what was not kept goes back, the filter stops
        telling."""
        if self.pending is not None:
            GLib.source_remove(self.pending)
            self.pending = None
        if self.countdown is not None:
            GLib.source_remove(self.countdown)
            self.countdown = None
            self.hide_banner()
        self.epoch += 1
        if self.applied != self.kept or self.sent != self.kept:
            self.worker.submit(lambda: helper("drop"))
            self.reset_to(self.kept)
        if self.renew is not None:
            GLib.source_remove(self.renew)
            self.renew = None
        if self.log is not None or self.opening is not None:
            self.worker.submit(lambda: helper("log", "off"))
            if self.log is not None:
                self.log.close()
                self.log = None
            self.opening = None
        if self.lock is not None:
            # Let go once what this page asked is done.
            lock, self.lock = self.lock, None
            self.worker.submit(lambda: lock.close())

    def wait(self, timeout=12):
        """Before the process ends: what was asked reaches the filter."""
        return self.worker.wait(timeout)

    def on_close(self, *_args):
        self.leave()
        Gtk.main_quit()
        return False

    # The field and the feed.

    def on_tap(self, _w, event):
        self.taps.append([event.x, event.y, 1.0])
        self.taps = self.taps[-12:]
        if len(self.taps) == 1:
            GLib.timeout_add(50, self.fade)
        self.field.queue_draw()
        return True

    def fade(self):
        for t in self.taps:
            t[2] -= 0.02
        self.taps = [t for t in self.taps if t[2] > 0]
        self.field.queue_draw()
        return bool(self.taps)

    def draw_field(self, w, cr):
        alloc = w.get_allocation()
        Gtk.render_background(w.get_style_context(), cr, 0, 0, alloc.width, alloc.height)
        Gtk.render_frame(w.get_style_context(), cr, 0, 0, alloc.width, alloc.height)
        r = self.current().get("tap_radius", 358) * screen_width() / FRAC
        for x, y, a in self.taps:
            # The tap, and how far the finger may slide and still tap.
            cr.set_source_rgba(0x35 / 255, 0x84 / 255, 0xe4 / 255, 0.25 * a)
            cr.arc(x, y, r, 0, 6.2832)
            cr.fill()
            cr.set_source_rgba(0x35 / 255, 0x84 / 255, 0xe4 / 255, a)
            cr.arc(x, y, 22, 0, 6.2832)
            cr.fill()
        return False

    def say(self, text, cls):
        label = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=30)
        label.get_style_context().add_class(cls)
        self.feed.pack_start(label, False, False, 0)
        self.feed.reorder_child(label, 0)
        label.show()
        children = self.feed.get_children()
        for old in children[10:]:
            old.destroy()

    def open_log(self):
        epoch = self.opening = self.epoch
        self.worker.submit(lambda: helper("log", "on"),
                           lambda err: self.log_opened(err, epoch))

    def log_opened(self, err, epoch):
        if epoch != self.epoch:
            return  # the page went before the filter answered (leave)
        self.opening = None
        try:
            self.log = open(EVENTS, errors="replace")
            self.log.seek(0, os.SEEK_END)
        except OSError as exc:
            self.log = None
            self.say("Фильтр не пишет решений (%s): старая версия?" % exc.strerror, "quiet")
            return
        if err:
            self.say("Фильтр не ответил: " + err, "palm")
        GLib.timeout_add(200, self.read_log)

    def renew_log(self):
        self.worker.submit(lambda: helper("log", "on"))
        return True

    def read_log(self):
        if self.log is None:
            return False  # the page went (leave)
        try:
            if os.fstat(self.log.fileno()).st_size < self.log.tell():
                self.log.seek(0)  # the log was rotated or truncated
            lines = self.log.readlines()
        except OSError:
            return True
        for line in lines:
            line = line.strip()
            if not line.startswith("haltia-touchguard: "):
                continue
            line = line[len("haltia-touchguard: "):]
            for pattern, text, cls in FEED:
                m = re.match(pattern, line)
                if m:
                    args = list(m.groups())
                    if "units away" in pattern:
                        args[1] = round(int(args[1]) * PX_PER_UNIT)
                    self.say(text.format(*args), cls)
                    break
        return True


def main():
    GLib.set_prgname("io.github.haltia_de.TouchSettings")
    lock = take_lock()
    if lock is None:
        return 0  # already open, here or in Настройки
    setup = Setup()
    # Stopped from outside, it undoes what was not kept as well.
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, setup.on_close)
    except (ImportError, ValueError):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, setup.on_close)
    Gtk.main()
    setup.wait()  # the drop and "log off" of leave()
    return 0


if __name__ == "__main__":
    sys.exit(main())
