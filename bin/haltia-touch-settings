# A step of the − and + buttons: a size step is one of the screen's own,
# a pressure step five.
STEPS = {"ms": 10, "width": 50, "major": max(1, round(FRAC / span("major"))),
         "pressure": max(1, round(5 * FRAC / span("pressure"))), "count": 1, "bool": 1}
SNAP = ("ms", "count")  # fractions take any value a drag leaves
LABELS = {k: t for _g, rows in GROUPS for k, t, _h, _u in rows}

