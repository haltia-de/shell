def read_conf(path):
    """The values, fractions in FRAC: "73.33%", or an old absolute value in
    the screen's units (shell 1.x) converted as the filter does."""
    values = {}
    try:
        with open(path) as fh:
            for line in fh:
                m = re.match(r"\s*([a-z_]+)\s*=\s*(-?\d+(?:\.\d+)?)(%?)", line)
                if not m or line.lstrip().startswith("#"):
                    continue
                key, num, pct = m.groups()
                if key not in FRACTIONS:
                    values[key] = int(float(num))
                elif pct:
                    values[key] = int(float(num) * 100 + 0.5)
                else:
                    axis = FRACTIONS[key]
                    base = 0 if axis == "x" else AXIS[axis][0]
                    values[key] = (int(float(num)) - base) * FRAC // span(axis)
    except OSError:
        pass
    return values


def read_ranges():
    ranges = {}
    try:
        out = subprocess.run([HELPER, "ranges"], capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ranges
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 3:
            ranges[parts[0]] = (int(parts[1]), int(parts[2]))
    return ranges


def helper(*args):
    """Runs the root helper; returns its error text, or None."""
    try:
        res = subprocess.run(["doas", "-n", HELPER] + list(args), capture_output=True,
                             text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        return str(exc)
    if res.returncode:
        return res.stderr.strip() or "ошибка %d" % res.returncode
    return None


class Ordered:
    """Runs jobs one at a time in a worker thread, in the order they were
    given, and hands each result to its done() in the main loop, in the
    same order: a try never overtakes an earlier one, and keep or drop
    come after the tries before them, while the GTK thread never waits
    for doas (SH2-47). post: how done() reaches the main loop."""

    def __init__(self, post=None):
        self.post = post or GLib.idle_add
        self.cond = threading.Condition()
        self.jobs = []  # (work, done) not started yet
        self.answers = []  # (done, result) not handed over yet
        self.busy = False  # a worker thread runs

    def submit(self, work, done=None):
        with self.cond:
            self.jobs.append((work, done))
            if self.busy:
                return
            self.busy = True
        threading.Thread(target=self._run, daemon=True).start()

    def wait(self, timeout):
        """True once every job given so far has run (not their done())."""
        with self.cond:
            return self.cond.wait_for(lambda: not self.busy, timeout)

    def _run(self):
        while True:
            with self.cond:
                if not self.jobs:
                    self.busy = False
                    self.cond.notify_all()
                    return
                work, done = self.jobs.pop(0)
            try:
                result = work()
            except Exception as exc:  # noqa: BLE001 - told like the helper's error
                result = str(exc)
            if done is not None:
                with self.cond:
                    self.answers.append((done, result))
                self.post(self._hand_over)

    def _hand_over(self):
        # One call hands over every answer waiting, oldest first: the order
        # holds whatever order the main loop runs its callbacks in.
        while True:
            with self.cond:
                if not self.answers:
                    return False
                done, result = self.answers.pop(0)
            done(result)


def take_lock():
    """touch-settings.lock, held while the window or the page in Настройки
    is open: the open file, or None when another one holds it."""
    run = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    lock = open(os.path.join(run, "haltia/touch-settings.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return None
    return lock


class Toggle(Gtk.Switch):
    """A switch that reads and sets like a slider, 0 or 1."""

    def get_value(self):
        return 1 if self.get_active() else 0

    def set_value(self, v):
        self.set_active(bool(round(v)))


def show_value(key, unit, v):
    if unit == "bool":
        return "вкл." if v else "выкл."
    if unit == "ms":
        if key == "buzz_ms" and v == 0:
            return "нет"
        if key == "repeat_ms" and v == 0:
            return "выкл."
        return "%d мс" % v
    if unit == "width":
        return "%d px" % round(v * screen_width() / FRAC)
    if unit in ("major", "pressure"):
        lo, hi = AXIS[unit]
        return "%d %% · %d из %d" % (round(v / 100), lo + round(v * span(unit) / FRAC), hi)
    return str(v)


# The filter's log lines, as the feed shows them: (pattern, text, class).
FEED = [
    (r"touch \d+ at \d+,\d+ size (\d+) pressure (\d+)",
     "Касание засчитано · пятно {0}, давление {1}", "ok"),
    (r"gesture", "Второй палец: жест", "ok"),
    (r"lift \d+ after (\d+) ms, gesture", "Поднят через {0} мс (жест)", "quiet"),
    (r"lift \d+ after (\d+) ms, moved", "Поднят через {0} мс, сдвинулся: листание", "quiet"),
    (r"lift \d+ after (\d+) ms", "Поднят через {0} мс", "quiet"),
    (r"long press", "Долгое нажатие", "ok"),
    (r"drop \d+: (\d+) ms, a brush", "Отброшено: вскользь, {0} мс", "drop"),
    (r"drop \d+ at \d+,\d+: repeat after (\d+) ms, (\d+) units away",
     "Отброшено: повтор через {0} мс, в {1} px", "drop"),
    (r"drop \d+ at \d+,\d+: after a palm", "Отброшено: пауза после ладони", "drop"),
    (r"drop \d+ at \d+,\d+: second finger", "Отброшено: второй палец", "drop"),
    (r"palm \((\d+) contacts, size (\d+), pressure (\d+)\)",
