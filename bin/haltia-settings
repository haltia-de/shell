def run(*args, timeout=10):
    """A command's output, or "" when it fails. Blocks: on the GTK thread
    only through background()."""
    try:
        return subprocess.run(list(args), capture_output=True, text=True,
                              timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


_latest = {}  # background(latest=KEY): the newest call for each key
_queue = []  # background(serial=True): one worker thread for these
_queue_lock = threading.Lock()
_draining = [False]


def background(fetch, apply=None, fallback=None, latest=None, serial=False):
    """fetch() in a worker thread, then apply(its result) in the main loop.
    fetch runs commands, reads files and D-Bus, never GTK: the window
    stays live while haltia-update, pactl or nmcli take their time (a
    Python start through doas is about a second on the tablet).

    fallback: what apply gets when fetch raises (otherwise apply is not
    called then). latest: a key; of several calls with it, only the newest
    one's result is applied, so a slow old read never undoes a newer one.
    serial: queued for one worker, for the many lines of the section list
    at once, which would otherwise start their commands all together."""
    token = None
    if latest is not None:
        token = _latest[latest] = _latest.get(latest, 0) + 1

    def done(result):
        if latest is None or _latest.get(latest) == token:
            apply(result)
        return False

    def work():
        try:
            result = fetch()
        except Exception as exc:  # noqa: BLE001 - a status that cannot be had
            sys.stderr.write("haltia-settings: %s\n" % exc)
            if fallback is None:
                return
            result = fallback
        if apply is not None:
            GLib.idle_add(done, result)

    if not serial:
        threading.Thread(target=work, daemon=True).start()
        return
    # One worker at a time, under a lock: a job queued just as the worker
    # took the last one used to start a second worker, so one job ran twice
    # and another raised IndexError (SH2-48).
    def drain():
        while True:
            with _queue_lock:
                if not _queue:
                    _draining[0] = False
                    return
                job = _queue.pop(0)
            job()

    with _queue_lock:
        _queue.append(work)
        if _draining[0]:
            return
        _draining[0] = True
    threading.Thread(target=drain, daemon=True).start()


def spawn(*args):
    """A command whose answer nobody waits for, off the GTK thread."""
    background(lambda: run(*args))


def panel_volume():
    """The panel's speaker shows the new volume (signal 10)."""
    run("/usr/bin/haltia-panel-signal", "10")


def ask_text(parent, title, value=""):
    if dialogs:
        return dialogs.text(parent, title, value)
    return None


def say(parent, message):
    if dialogs:
        dialogs.info(parent, message)


def row_box(name, sub=None, mark=None):
    """A list row's content: a name, a line under it, a mark on the right."""
    box = Gtk.Box(spacing=16)
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    label = Gtk.Label(label=name, xalign=0)
    label.get_style_context().add_class("name")
    text.pack_start(label, False, False, 0)
    sub_label = Gtk.Label(label=sub or "", xalign=0)
    sub_label.get_style_context().add_class("sub")
    sub_label.set_no_show_all(not sub)
    text.pack_start(sub_label, False, False, 0)
    box.pack_start(text, True, True, 0)
    if mark is not None:
        m = Gtk.Label(label=mark)
        m.get_style_context().add_class("mark")
        box.pack_end(m, False, False, 0)
    box.sub = sub_label
    return box


def section(text):
    label = Gtk.Label(label=text, xalign=0)
    label.get_style_context().add_class("section")
    return label


def listbox(on_activate):
    lb = Gtk.ListBox()
    lb.set_selection_mode(Gtk.SelectionMode.NONE)
    lb.connect("row-activated", on_activate)
    return lb


def reading_view():
    """(scrolled window, text view) for a long text to read: a TextView
    measures its own height, where wrapped labels in a scrolled page were
    measured at another width and a long text did not scroll to its end."""
    view = Gtk.TextView(editable=False, cursor_visible=False,
                        wrap_mode=Gtk.WrapMode.WORD_CHAR)
    view.get_style_context().add_class("reading")
    for side in ("left", "right", "top", "bottom"):
        getattr(view, "set_%s_margin" % side)(16)
    buf = view.get_buffer()
    buf.create_tag("head", weight=700, foreground="#5e5c64", pixels_above_lines=16,
                   pixels_below_lines=8)
    buf.create_tag("item", pixels_below_lines=12)
    buf.create_tag("note", foreground="#5e5c64")
    buf.create_tag("mono", family="monospace", scale=0.75)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.add(view)
    return scroll, view


def set_reading(view, parts):
    """The view's text: (text, tag) pieces, each its own paragraph."""
    buf = view.get_buffer()
    buf.set_text("")
    for n, (text, tag) in enumerate(parts):
        end = buf.get_end_iter()
        buf.insert_with_tags_by_name(end, ("\n" if n else "") + text, tag)
    view.get_parent().get_vadjustment().set_value(0)


def page_box():
    """A scrolling page: the box to fill, 16 px in. GTK 3 draws a box's
    background inside its border width only, and on a long page what lay
    under the border showed black: the outer box draws the background over
    all of it."""
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    outer.get_style_context().add_class("page")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
    box.set_border_width(16)
    outer.pack_start(box, True, True, 0)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.add(outer)
    return scroll, box


def switch_line(box, title, hint, on_toggle):
    """A line with a title, a hint under it and a switch on the right."""
    line = Gtk.Box(spacing=16)
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    label = Gtk.Label(label=title, xalign=0)
    label.get_style_context().add_class("note")
    text.pack_start(label, False, False, 0)
    if hint:
        sub = Gtk.Label(label=hint, xalign=0, wrap=True)
        sub.get_style_context().add_class("sub")
        text.pack_start(sub, False, False, 0)
    line.pack_start(text, True, True, 0)
    sw = Gtk.Switch(valign=Gtk.Align.CENTER)
    sw.connect("notify::active", on_toggle)
    line.pack_end(sw, False, False, 0)
    box.pack_start(line, False, False, 0)
    sw.line = line
    return sw


def set_quietly(switch, handler, value):
    """A switch shown in a state without calling its handler."""
    switch.handler_block_by_func(handler)
    switch.set_active(bool(value))
    switch.handler_unblock_by_func(handler)


class Choices(Gtk.Box):
    """A row of large buttons, one of them chosen (blue)."""

    def __init__(self, options, on_pick):
        super().__init__(spacing=12)
        self.buttons = {}
        self.on_pick = on_pick
        for value, text in options:
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("choice")
            b.connect("clicked", lambda _b, v=value: self.pick(v))
            self.pack_start(b, False, False, 0)
            self.buttons[value] = b

    def show_value(self, value):
        for v, b in self.buttons.items():
            ctx = b.get_style_context()
            (ctx.add_class if v == value else ctx.remove_class)("on")

    def pick(self, value):
        self.show_value(value)
        self.on_pick(value)


def read_keys(path):
    """KEY=VALUE lines of a small settings file."""
    values = {}
    try:
        with open(path) as fh:
            for line in fh:
                key, sep, val = line.partition("=")
                if sep and not key.strip().startswith("#"):
                    values[key.strip()] = val.strip()
    except OSError:
        pass
    return values


def write_keys(path, values, comment):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w") as fh:
        fh.write("# %s\n" % comment)
        for key, val in values.items():
            fh.write("%s=%s\n" % (key, val))
    os.replace(path + ".new", path)


# --- the network ------------------------------------------------------------
class Network:
    """Wi-Fi through NetworkManager: the networks in reach, the one in use,
    connecting with a password, forgetting one, a hidden one, on and off."""

    title = "Сеть"

    def __init__(self, app):
        self.app = app
        self.client = None
        self.ready = False
        self.widget, box = page_box()
        line = Gtk.Box(spacing=16)
        label = Gtk.Label(label="Wi-Fi", xalign=0)
        label.get_style_context().add_class("big")
        line.pack_start(label, True, True, 0)
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch.connect("notify::active", self.on_switch)
        line.pack_end(self.switch, False, False, 0)
        box.pack_start(line, False, False, 0)
        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.get_style_context().add_class("note")
        box.pack_start(self.status, False, False, 0)
        box.pack_start(section("Сети рядом"), False, False, 0)
        self.list = listbox(self.on_row)
        box.pack_start(self.list, False, False, 0)
        buttons = Gtk.Box(spacing=16)
        refresh = Gtk.Button(label="Обновить")
        refresh.get_style_context().add_class("plain")
        refresh.connect("clicked", lambda _b: self.scan())
        buttons.pack_start(refresh, False, False, 0)
        hidden = Gtk.Button(label="Скрытая сеть…")
        hidden.get_style_context().add_class("plain")
        hidden.connect("clicked", lambda _b: self.hidden())
        buttons.pack_start(hidden, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        box.pack_start(section("Сохранённые"), False, False, 0)
        self.saved = listbox(self.on_saved)
        box.pack_start(self.saved, False, False, 0)
        self.pending = None
        self.status.set_text("Узнаю, что с Wi-Fi…")
        self.switch.set_sensitive(False)
        # NetworkManager's client reads every device and access point over
        # D-Bus: asynchronously, the page shows at once.
        if NM:
            NM.Client.new_async(None, self.connected)
        else:
            self.refresh()

    def connected(self, _source, result):
        try:
            self.client = NM.Client.new_finish(result)
        except GLib.Error:
            self.client = None
        self.ready = True
        if self.client:
            self.client.connect("notify::wireless-enabled", lambda *_a: self.refresh())
            self.client.connect("notify::active-connections", lambda *_a: self.refresh())
            dev = self.device()
            if dev:
                dev.connect("access-point-added", lambda *_a: self.later())
                dev.connect("access-point-removed", lambda *_a: self.later())
                dev.connect("notify::state", lambda *_a: self.later())
        self.switch.set_sensitive(True)
        self.refresh()

    def device(self):
        if not self.client:
            return None
        for d in self.client.get_devices():
            if d.get_device_type() == NM.DeviceType.WIFI:
                return d
        return None

    @staticmethod
    def peek():
        """The list's line, from nmcli (in a worker thread)."""
        devices = run("nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "device").splitlines()
        wifi = [d.split(":", 2) for d in devices if d.startswith("wifi:")]
        if not wifi:
            return "нет Wi-Fi"
        if run("nmcli", "-t", "-f", "WIFI", "general") != "enabled":
            return "выключен"
        state, name = (wifi[0] + ["", ""])[1:3]
        return name if state == "connected" and name else "не подключено"

    @staticmethod
    def name(ap):
        ssid = ap.get_ssid()
        return NM.utils_ssid_to_utf8(ssid.get_data()) if ssid else ""

    def later(self):
        # Access points come and go in bursts: redraw once they settle.
        if self.pending is None:
            self.pending = GLib.timeout_add(500, self._later)

    def _later(self):
        self.pending = None
        self.refresh()
        return False

    def refresh(self):
        if NM and not self.ready:
            return  # connected() shows the page once the client is there
        for lb in (self.list, self.saved):
            for child in lb.get_children():
                lb.remove(child)
        dev = self.device()
        if not dev:
            self.status.set_text("Wi-Fi не найден.")
            self.switch.set_sensitive(False)
            return
        on = self.client.wireless_get_enabled()
        self.switch.handler_block_by_func(self.on_switch)
        self.switch.set_active(on)
        self.switch.handler_unblock_by_func(self.on_switch)
        active = dev.get_active_access_point()
        if not on:
            self.status.set_text("Wi-Fi выключен.")
        elif active:
            self.status.set_text("Подключено к «%s»." % self.name(active))
        else:
            self.status.set_text("Не подключено. Выберите сеть.")
        best = {}
        for ap in dev.get_access_points() if on else []:
            n = self.name(ap)
            if n and (n not in best or ap.get_strength() > best[n].get_strength()):
                best[n] = ap
        for n, ap in sorted(best.items(), key=lambda kv: -kv[1].get_strength()):
            secure = bool(ap.get_wpa_flags() or ap.get_rsn_flags())
            strength = ap.get_strength()
            sub = "сигнал %s%s" % ("отличный" if strength >= 70 else "хороший" if strength >= 45
                                   else "слабый", ", с паролем" if secure else ", открытая")
            row = Gtk.ListBoxRow()
            row.add(row_box(n, sub, "✓" if active and self.name(active) == n else ""))
            row.ap = ap
            self.list.add(row)
        for con in self.wifi_connections():
            row = Gtk.ListBoxRow()
            row.add(row_box(con.get_id(), "нажмите, чтобы забыть"))
            row.con = con
            self.saved.add(row)
        self.list.show_all()
        self.saved.show_all()

    def wifi_connections(self):
        return [c for c in self.client.get_connections()
                if c.get_connection_type() == "802-11-wireless"] if self.client else []

    def known(self, name):
        for con in self.wifi_connections():
            s = con.get_setting_wireless()
            if s and s.get_ssid() and NM.utils_ssid_to_utf8(s.get_ssid().get_data()) == name:
                return con
        return None

    def on_switch(self, switch, _param):
        if self.client:
            self.client.dbus_set_property(NM.DBUS_PATH, NM.DBUS_INTERFACE, "WirelessEnabled",
                                          GLib.Variant("b", switch.get_active()), -1, None,
                                          None, None)

    def scan(self):
        dev = self.device()
        if dev:
            dev.request_scan_async(None, None, None)
            self.status.set_text("Ищу сети…")
            GLib.timeout_add_seconds(4, lambda: self.refresh() or False)

    def on_row(self, _lb, row):
        ap = row.ap
        name = self.name(ap)
        dev = self.device()
        con = self.known(name)
        if con:
            self.client.activate_connection_async(con, dev, None, None, self.activated, name)
            self.status.set_text("Подключаюсь к «%s»…" % name)
            return
        secure = bool(ap.get_wpa_flags() or ap.get_rsn_flags())
        password = None
        if secure:
            password = ask_text(self.app.win, "Пароль сети «%s»" % name)
            if not password:
                return
        self.add(name, password, dev, ap, hidden=False)

    def hidden(self):
        name = ask_text(self.app.win, "Имя скрытой сети")
        if not name:
            return
        password = ask_text(self.app.win, "Пароль сети «%s» (пусто — без пароля)" % name)
        self.add(name, password or None, self.device(), None, hidden=True)

    def add(self, name, password, dev, ap, hidden):
        con = NM.SimpleConnection.new()
        s_con = NM.SettingConnection.new()
        s_con.set_property(NM.SETTING_CONNECTION_ID, name)
        s_con.set_property(NM.SETTING_CONNECTION_TYPE, "802-11-wireless")
        con.add_setting(s_con)
        s_wifi = NM.SettingWireless.new()
        s_wifi.set_property(NM.SETTING_WIRELESS_SSID, GLib.Bytes.new(name.encode()))
        s_wifi.set_property(NM.SETTING_WIRELESS_HIDDEN, hidden)
        con.add_setting(s_wifi)
        if password:
            s_sec = NM.SettingWirelessSecurity.new()
            s_sec.set_property(NM.SETTING_WIRELESS_SECURITY_KEY_MGMT, "wpa-psk")
            s_sec.set_property(NM.SETTING_WIRELESS_SECURITY_PSK, password)
            con.add_setting(s_sec)
        self.client.add_and_activate_connection_async(
            con, dev, ap.get_path() if ap else None, None, self.added, name)
        self.status.set_text("Подключаюсь к «%s»…" % name)

    def activated(self, client, result, name):
        self.finished(client.activate_connection_finish, result, name)

    def added(self, client, result, name):
        self.finished(client.add_and_activate_connection_finish, result, name)

    def finished(self, finish, result, name):
        try:
            finish(result)
        except GLib.Error as exc:
            self.status.set_text("Не удалось подключиться к «%s»." % name)
            sys.stderr.write("haltia-settings: %s\n" % exc.message)
        self.later()

    def on_saved(self, _lb, row):
        con = row.con
        if dialogs and dialogs.ask(self.app.win, "Забыть сеть «%s»?" % con.get_id(), "Забыть"):
            con.delete_async(None, lambda c, r, _d: self.later(), None)


# --- sound ----------------------------------------------------------------
class Sound:
    """The default sink's volume, mute and which output plays; the buzz of a
    tap (the touch filter's buzz_ms)."""

    title = "Звук и вибрация"

    def __init__(self, app):
        self.app = app
        self.widget, box = page_box()
        box.pack_start(section("Громкость"), False, False, 0)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_draw_value(False)
        self.scale.connect("value-changed", self.on_volume)
        box.pack_start(self.scale, False, False, 0)
        line = Gtk.Box(spacing=16)
        label = Gtk.Label(label="Без звука", xalign=0)
        label.get_style_context().add_class("note")
        line.pack_start(label, True, True, 0)
        self.mute = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.mute.connect("notify::active", self.on_mute)
        line.pack_end(self.mute, False, False, 0)
        box.pack_start(line, False, False, 0)
        box.pack_start(section("Куда идёт звук"), False, False, 0)
        self.outputs = listbox(self.on_output)
        box.pack_start(self.outputs, False, False, 0)
        box.pack_start(section("Вибрация"), False, False, 0)
        self.buzz = switch_line(box, "При касании",
                                "Короткий толчок, когда палец коснулся экрана",
                                self.on_buzz)
        self.pending = None
        self.refresh()

    @staticmethod
    def peek():
        vol = Sound.volume()
        if vol is None:
            return "нет звука"
        return "без звука" if Sound.muted() else "%d %%" % vol

    @staticmethod
    def volume():
        out = run("pactl", "get-sink-volume", "@DEFAULT_SINK@")
        try:
            return int(out.split("/")[1].strip().rstrip("%"))
        except (IndexError, ValueError):
            return None

    @staticmethod
    def muted():
        return run("pactl", "get-sink-mute", "@DEFAULT_SINK@").split()[-1:] in (["yes"], ["да"])

    @staticmethod
    def status():
        """Everything the page shows (in a worker thread)."""
        desc, name = {}, None
        for line in run("pactl", "list", "sinks").splitlines():
            line = line.strip()
            if line.startswith("Name:") or line.startswith("Имя:"):
                name = line.split(":", 1)[1].strip()
            elif (line.startswith("Description:") or line.startswith("Описание:")) and name:
                desc[name] = line.split(":", 1)[1].strip()
        return {"volume": Sound.volume(), "muted": Sound.muted(),
                "default": run("pactl", "get-default-sink"), "sinks": desc,
                "buzz": Sound.buzz_ms()}

    def refresh(self):
        background(self.status, self.show_status, latest=(id(self), "status"))

    def show_status(self, st):
        self.scale.handler_block_by_func(self.on_volume)
        self.scale.set_value(st["volume"] or 0)
        self.scale.handler_unblock_by_func(self.on_volume)
        self.mute.handler_block_by_func(self.on_mute)
        self.mute.set_active(st["muted"])
        self.mute.handler_unblock_by_func(self.on_mute)
        set_quietly(self.buzz, self.on_buzz, st["buzz"] > 0)
        for child in self.outputs.get_children():
            self.outputs.remove(child)
        default = st["default"]
        for name, text in st["sinks"].items():
            row = Gtk.ListBoxRow()
            row.add(row_box(text, None, "✓" if name == default else ""))
            row.sink = name
            self.outputs.add(row)
        self.outputs.show_all()

    def on_volume(self, scale):
        if self.pending is None:
            self.pending = GLib.timeout_add(120, self.apply_volume)

    def apply_volume(self):
        self.pending = None
        level = int(self.scale.get_value())

        def work():
            run("pactl", "set-sink-volume", "@DEFAULT_SINK@", "%d%%" % level)
            unmuted = level > 0 and Sound.muted()
            if unmuted:
                run("pactl", "set-sink-mute", "@DEFAULT_SINK@", "0")
            panel_volume()
            return unmuted
        background(work, lambda unmuted: unmuted and set_quietly(self.mute, self.on_mute,
                                                                  False))
        return False

    def on_mute(self, switch, _param):
        on = "1" if switch.get_active() else "0"
        background(lambda: (run("pactl", "set-sink-mute", "@DEFAULT_SINK@", on),
                            panel_volume()))

    def on_output(self, _lb, row):
        sink = row.sink
        background(lambda: run("pactl", "set-default-sink", sink), lambda _r: self.refresh())

    @staticmethod
    def buzz_ms():
        """The touch filter's buzz on a tap, in ms (0: none)."""
        for path in (TOUCH_CONF, "/usr/share/haltia/touchguard.conf"):
            try:
                with open(path) as fh:
                    for line in fh:
                        key, sep, val = line.partition("=")
                        if sep and key.strip() == "buzz_ms":
                            return int(val.split("#")[0].strip())
            except (OSError, ValueError):
                continue
        return BUZZ_MS

    def on_buzz(self, switch, _param):
        spawn("doas", "-n", "/usr/libexec/haltia/haltia-touchguard-conf", "set",
              "buzz_ms=%d" % (BUZZ_MS if switch.get_active() else 0))


# --- the screen ---------------------------------------------------------------
class Screen:
    """Brightness, turning with the tablet, and when the screen goes off by
    itself (haltia-sleep reads ~/.config/haltia/screen)."""

    title = "Экран"
    CONF = os.path.join(CONFIG, "screen")
    OFF = ((60, "1 мин"), (120, "2 мин"), (300, "5 мин"), (600, "10 мин"), (1800, "30 мин"))

    def __init__(self, app):
        self.app = app
        self.light = brightness_module()
        self.widget, box = page_box()
        self.scale = None
        self.pending = None
        if self.light:
            box.pack_start(section("Яркость"), False, False, 0)
            top = self.light.read_int(self.light.SYSFS + "/max_brightness", 255)
            self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,
                                                  max(1, top // 20), top, 1)
            self.scale.set_draw_value(False)
            self.scale.connect("value-changed", self.on_light)
            box.pack_start(self.scale, False, False, 0)
        self.rotate = switch_line(box, "Поворачивать экран",
                                  "Экран следует за планшетом: на боку — книжная ориентация",
                                  self.on_rotate)
        box.pack_start(section("Экран гаснет, если не касаться"), False, False, 0)
        self.off = Choices(self.OFF, self.on_off)
        box.pack_start(self.off, False, False, 0)
        self.charging = switch_line(box, "Не гасить на зарядке",
                                    "Пока планшет заряжается, экран горит", self.on_charging)
        self.refresh()

    @classmethod
    def settings(cls):
        values = read_keys(cls.CONF)
        off = int(values.get("off_after", "600")) if values.get("off_after", "").isdigit() else 600
        return off, values.get("charging") == "on"

    def save(self, off, charging):
        write_keys(self.CONF, {"off_after": off, "charging": "on" if charging else "off"},
                   "Настройки → Экран (haltia-sleep reads it)")

    @classmethod
    def peek(cls):
        off, charging = cls.settings()
        text = "гаснет через %d мин" % (off // 60)
        return text + (", на зарядке горит" if charging else "")

    def refresh(self):
        # haltia-rotate is a Python start: its answer comes when it comes.
        background(lambda: run("/usr/bin/haltia-rotate", "status") != "off",
                   lambda on: set_quietly(self.rotate, self.on_rotate, on),
                   latest=(id(self), "rotate"))
        off, charging = self.settings()
        self.off.show_value(off)
        set_quietly(self.charging, self.on_charging, charging)
        if self.scale is not None:
            now = self.light.read_int(self.light.SYSFS + "/brightness", 0)
            self.scale.handler_block_by_func(self.on_light)
            self.scale.set_value(now)
            self.scale.handler_unblock_by_func(self.on_light)

    @staticmethod
    def on_rotate(switch, _param):
        spawn("/usr/bin/haltia-rotate", "on" if switch.get_active() else "off")

    def on_off(self, value):
        self.save(value, self.settings()[1])

    def on_charging(self, switch, _param):
        self.save(self.settings()[0], switch.get_active())

    def on_light(self, _scale):
        if self.pending is None:
            self.pending = GLib.timeout_add(80, self.apply_light)

    def apply_light(self):
        self.pending = None
        level = int(self.scale.get_value())
        try:
            self.light.Brightness().set(level)
            self.light.save(level)
        except Exception as exc:  # logind refused, or the module changed
            sys.stderr.write("haltia-settings: brightness: %s\n" % exc)
        return False


def brightness_module():
    """haltia-brightness as a module (its Brightness through logind, its
    saved level), or None where it cannot load."""
    try:
        from importlib.machinery import SourceFileLoader
        mod = SourceFileLoader("haltia_brightness", "/usr/bin/haltia-brightness").load_module()
        return mod if mod.BACKLIGHT else None
    except Exception:  # no layer shell, no backlight: no slider
        return None


# --- date and time --------------------------------------------------------
class DateTime:
    """The time zone, the time from the network or set by hand (timedated)."""

    title = "Дата и время"
    BUS = ("org.freedesktop.timedate1", "/org/freedesktop/timedate1",
           "org.freedesktop.timedate1")

    def __init__(self, app):
        self.app = app
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error:
            self.bus = None
        self.widget, box = page_box()
        self.clock = Gtk.Label(xalign=0)
        self.clock.get_style_context().add_class("big")
        box.pack_start(self.clock, False, False, 0)
        self.date = Gtk.Label(xalign=0)
        self.date.get_style_context().add_class("note")
        box.pack_start(self.date, False, False, 0)
        self.rows = listbox(self.on_row)
        box.pack_start(self.rows, False, False, 0)
        self.zone_row = Gtk.ListBoxRow()
        self.zone_box = row_box("Часовой пояс", "")
        self.zone_row.add(self.zone_box)
        self.zone_row.kind = "zone"
        self.rows.add(self.zone_row)
        self.set_row = Gtk.ListBoxRow()
        self.set_row.add(row_box("Поставить время вручную", "когда время берётся не из сети"))
        self.set_row.kind = "set"
        self.rows.add(self.set_row)
        line = Gtk.Box(spacing=16)
        label = Gtk.Label(label="Время из интернета", xalign=0)
        label.get_style_context().add_class("note")
        line.pack_start(label, True, True, 0)
        self.ntp = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.ntp.connect("notify::active", self.on_ntp)
        line.pack_end(self.ntp, False, False, 0)
        box.pack_start(line, False, False, 0)
        self.note = Gtk.Label(xalign=0, wrap=True)
        self.note.get_style_context().add_class("note")
        box.pack_start(self.note, False, False, 0)
        GLib.timeout_add_seconds(10, self.tick)
        self.refresh()

    def prop(self, name):
        if not self.bus:
            return None
        try:
            v = self.bus.call_sync(self.BUS[0], self.BUS[1], "org.freedesktop.DBus.Properties",
                                   "Get", GLib.Variant("(ss)", (self.BUS[2], name)), None,
                                   0, 3000, None)
            return v.unpack()[0]
        except GLib.Error:
            return None

    def call(self, method, args):
        try:
            self.bus.call_sync(self.BUS[0], self.BUS[1], self.BUS[2], method, args, None,
                               0, 10000, None)
            return True
        except (GLib.Error, AttributeError) as exc:
            self.note.set_text("Не получилось: нет прав или нет службы времени.")
            sys.stderr.write("haltia-settings: %s: %s\n" % (method, getattr(exc, "message", exc)))
            return False

    @staticmethod
    def zone_name(zone):
        return dict((z, n) for n, z in ZONES).get(zone or "", zone or "") or "—"

    @classmethod
    def peek(cls):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            v = bus.call_sync(cls.BUS[0], cls.BUS[1], "org.freedesktop.DBus.Properties",
                              "Get", GLib.Variant("(ss)", (cls.BUS[2], "Timezone")), None,
                              0, 3000, None)
            return cls.zone_name(v.unpack()[0])
        except GLib.Error:
            return "—"

    def tick(self):
        now = time.localtime()
        self.clock.set_text(time.strftime("%H:%M", now))
        months = ("января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа",
                  "сентября", "октября", "ноября", "декабря")
        days = ("понедельник", "вторник", "среда", "четверг", "пятница", "суббота",
                "воскресенье")
        self.date.set_text("%s, %d %s %d" % (days[now.tm_wday], now.tm_mday,
                                             months[now.tm_mon - 1], now.tm_year))
        return True

    def refresh(self):
        self.tick()
        background(lambda: (self.prop("Timezone"), bool(self.prop("NTP"))), self.show_props)

    def show_props(self, props):
        zone, ntp = props
        self.zone_box.sub.set_text(self.zone_name(zone))
        self.zone_box.sub.show()
        self.ntp.handler_block_by_func(self.on_ntp)
        self.ntp.set_active(ntp)
        self.ntp.handler_unblock_by_func(self.on_ntp)
        self.set_row.set_sensitive(not ntp)

    def pick_zone(self, zone):
        """A name from ZONES or «Другой…», from a list that scrolls (twelve
        zones do not fit a dialog of buttons), or None."""
        dialog = Gtk.Dialog(title="Часовой пояс", transient_for=self.app.win, modal=True)
        dialog.get_style_context().add_class("haltia-dialog")
        dialog.set_default_size(640, 620)
        dialog.add_button("Отмена", Gtk.ResponseType.CANCEL)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        chosen = []
        lb = listbox(lambda _lb, r: (chosen.append(r.name),
                                     dialog.response(Gtk.ResponseType.OK)))
        for name, z in ZONES + [("Другой…", None)]:
            r = Gtk.ListBoxRow()
            r.add(row_box(name, None, "✓" if z and z == zone else ""))
            r.name = name
            lb.add(r)
        scroll.add(lb)
        dialog.get_content_area().pack_start(scroll, True, True, 0)
        dialog.show_all()
        res = dialog.run()
        dialog.destroy()
        return chosen[0] if res == Gtk.ResponseType.OK and chosen else None

    def on_ntp(self, switch, _param):
        if self.call("SetNTP", GLib.Variant("(bb)", (switch.get_active(), False))):
            self.note.set_text("")
        self.refresh()

    def on_row(self, _lb, row):
        if row.kind == "zone":
            zone = self.prop("Timezone")
            name = self.pick_zone(zone)
            if name is None:
                return
            if name == "Другой…":
                zone = ask_text(self.app.win, "Пояс, например Europe/Berlin", zone or "")
                if not zone or not os.path.exists("/usr/share/zoneinfo/" + zone):
                    return
            else:
                zone = dict(ZONES)[name]
            if self.call("SetTimezone", GLib.Variant("(sb)", (zone, False))):
                os.environ["TZ"] = zone
                time.tzset()
                self.note.set_text("")
            self.refresh()
        elif row.kind == "set":
            now = time.localtime()
            value = ask_text(self.app.win, "Дата и время: ДД.ММ.ГГГГ ЧЧ:ММ",
                             time.strftime("%d.%m.%Y %H:%M", now))
            if not value:
                return
            try:
                t = time.mktime(time.strptime(value.strip(), "%d.%m.%Y %H:%M"))
            except ValueError:
                say(self.app.win, "Не понял дату. Пример: 19.10.2026 15:30")
                return
            if self.call("SetTime", GLib.Variant("(xbb)", (int(t * 1000000), False, False))):
                self.note.set_text("")
            self.refresh()


# --- the panel and the home screen ----------------------------------------------
PANEL_ROOM = 3  # pinned buttons that fit beside two slots for open programs


class Programs:
    """Where each program is: on the panel, on the home screen, in which
    order (haltia-apps programs), and writing it back (~/.config/haltia/panel
    and home, then haltia-apps reload)."""

    def __init__(self):
        self.items = []
        self.pending = None

    @staticmethod
    def fetch():
        """haltia-apps programs (in a worker thread: a Python start)."""
        import json
        try:
            return json.loads(run("/usr/bin/haltia-apps", "programs", timeout=20) or "[]")
        except ValueError:
            return []

    def load(self, done):
        """Read them again, then done() in the main loop."""
        def got(items):
            self.items = items
            done()
        background(self.fetch, got)

    def pinned(self):
        return [i for i in self.items if i["pinned"]]

    def save(self):
        os.makedirs(CONFIG, exist_ok=True)
        # The panel keeps its own order; a newly pinned one goes last.
        panel = sorted(self.pinned(), key=lambda i: (i.get("place", -1) < 0,
                                                     i.get("place", -1)))
        for n, item in enumerate(panel):
            item["place"] = n
        with open(os.path.join(CONFIG, "panel.new"), "w") as fh:
            fh.write("# Настройки → «Панель и домашний экран»: the pinned buttons.\n")
            fh.write("".join(i["id"] + "\n" for i in panel))
        os.replace(os.path.join(CONFIG, "panel.new"), os.path.join(CONFIG, "panel"))
        with open(os.path.join(CONFIG, "home.new"), "w") as fh:
            fh.write("# Настройки → «Панель и домашний экран»: the home screen's order;"
                     " -ID: not on it.\n")
            fh.write("".join(("" if i["home"] else "-") + i["id"] + "\n" for i in self.items))
        os.replace(os.path.join(CONFIG, "home.new"), os.path.join(CONFIG, "home"))
        # Several taps in a row make one reload.
        if self.pending is not None:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(700, self.reload)

    def reload(self):
        self.pending = None
        subprocess.Popen(["/usr/bin/haltia-apps", "reload"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
        return False


def icon_image(path, size=48):
    try:
        from gi.repository import GdkPixbuf
        return Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size))
    except (GLib.Error, TypeError, ImportError):
        return Gtk.Image()


class Places:
    """Each program on the panel, on the home screen, and their order. One
    cannot take a program off both here (it could not be opened then): only
    «Для помощника» hides one."""

    title = "Панель и домашний экран"

    def __init__(self, app):
        self.app = app
        self.widget, box = page_box()
        self.hint = Gtk.Label(xalign=0, wrap=True)
        self.hint.get_style_context().add_class("note")
        box.pack_start(self.hint, False, False, 0)
        self.list = listbox(lambda *_a: None)
        box.pack_start(self.list, False, False, 0)
        self.refresh()

    @staticmethod
    def peek():
        pinned = [i["label"] for i in Programs.fetch() if i["pinned"]]
        return "на панели: %s" % ", ".join(pinned) if pinned else "на панели ничего"

    def refresh(self):
        self.app.programs.load(self.fill)

    def shown(self):
        return [i for i in self.app.programs.items if i["pinned"] or i["home"]]

    def fill(self):
        for child in self.list.get_children():
            self.list.remove(child)
        items = self.shown()
        full = len(self.app.programs.pinned()) >= PANEL_ROOM
        self.hint.set_text(
            "На панели помещаются %d программы%s. Убрать программу совсем можно только в "
            "разделе «Для помощника»." % (PANEL_ROOM, " — сейчас мест нет" if full else ""))
        for n, item in enumerate(items):
            row = Gtk.ListBoxRow(activatable=False)
            line = Gtk.Box(spacing=12)
            line.pack_start(icon_image(item["icon"]), False, False, 0)
            name = Gtk.Label(label=item["label"], xalign=0)
            name.get_style_context().add_class("name")
            line.pack_start(name, True, True, 0)
            up = button("↑", "step", lambda i=item: self.move(i, -1))
            up.set_sensitive(n > 0)
            down = button("↓", "step", lambda i=item: self.move(i, 1))
            down.set_sensitive(n < len(items) - 1)
            line.pack_start(up, False, False, 0)
            line.pack_start(down, False, False, 0)
            pin = self.toggle(line, "На панели", item["pinned"],
                              lambda sw, i=item: self.set_place(i, "pinned", sw))
            home = self.toggle(line, "Дома", item["home"],
                               lambda sw, i=item: self.set_place(i, "home", sw))
            # Never off both; Настройки always on the home screen (the way
            # back to everything); no more pinned than fit.
            pin.set_sensitive(item["home"] and (item["pinned"] or not full))
            home.set_sensitive(item["pinned"] and item["id"] != "settings")
            row.add(line)
            self.list.add(row)
        self.list.show_all()

    @staticmethod
    def toggle(line, text, on, changed):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        label = Gtk.Label(label=text)
        label.get_style_context().add_class("sub")
        box.pack_start(label, False, False, 0)
        sw = Gtk.Switch(halign=Gtk.Align.CENTER)
        sw.set_active(on)
        sw.connect("notify::active", lambda s, _p: changed(s))
        box.pack_start(sw, False, False, 0)
        line.pack_start(box, False, False, 0)
        return sw

    def set_place(self, item, key, switch):
        item[key] = switch.get_active()
        if key == "pinned" and not item["pinned"]:
            item["place"] = -1
        self.app.programs.save()
        GLib.idle_add(lambda: self.fill() and False)

    def move(self, item, step):
        items = self.app.programs.items
        shown = self.shown()
        n = shown.index(item)
        if not 0 <= n + step < len(shown):
            return
        other = shown[n + step]
        a, b = items.index(item), items.index(other)
        items[a], items[b] = items[b], items[a]
        # Neighbours on the panel swap there too.
        if item["pinned"] and other["pinned"]:
            item["place"], other["place"] = other["place"], item["place"]
        self.app.programs.save()
        self.fill()


# --- notifications --------------------------------------------------------------
class Notify:
    """How a notification behaves (haltia-mako reads ~/.config/haltia/
    notifications): the buzz, how long it stays, quiet at night."""

    title = "Уведомления"
    CONF = os.path.join(CONFIG, "notifications")
    STAY = ((5, "5 с"), (12, "12 с"), (30, "30 с"), (0, "До нажатия"))

    def __init__(self, app):
        self.app = app
        self.widget, box = page_box()
        self.vibrate = switch_line(box, "Вибрация", "Короткий толчок, когда пришло уведомление",
                                   self.on_switch)
        box.pack_start(section("Сколько показывать"), False, False, 0)
        self.stay = Choices(self.STAY, lambda v: self.set("timeout", v))
        box.pack_start(self.stay, False, False, 0)
        self.quiet = switch_line(box, "Не беспокоить ночью",
                                 "Уведомления приходят без вибрации", self.on_switch)
        hours = Gtk.Box(spacing=12)
        self.hour_from = self.hour(hours, "с", "quiet_from")
        self.hour_to = self.hour(hours, "до", "quiet_to")
        self.hours = hours
        box.pack_start(hours, False, False, 0)
        self.refresh()

    def hour(self, box, text, key):
        label = Gtk.Label(label=text)
        label.get_style_context().add_class("note")
        box.pack_start(label, False, False, 0)
        box.pack_start(button("−", "step", lambda: self.step(key, -1)), False, False, 0)
        value = Gtk.Label()
        value.get_style_context().add_class("headline")
        value.set_width_chars(5)
        box.pack_start(value, False, False, 0)
        box.pack_start(button("+", "step", lambda: self.step(key, 1)), False, False, 0)
        return value

    @classmethod
    def values(cls):
        v = read_keys(cls.CONF)
        out = {"vibrate": v.get("vibrate", "on"), "timeout": v.get("timeout", "12"),
               "quiet": v.get("quiet", "off"), "quiet_from": v.get("quiet_from", "22"),
               "quiet_to": v.get("quiet_to", "8")}
        for key, default in (("timeout", "12"), ("quiet_from", "22"), ("quiet_to", "8")):
            if not out[key].isdigit():
                out[key] = default
        return out

    def set(self, key, value):
        v = self.values()
        v[key] = str(value)
        write_keys(self.CONF, v, "Настройки → Уведомления (haltia-mako reads it)")
        if key == "timeout":
            # mako takes a new timeout only from its config.
            background(lambda: (run("/usr/libexec/haltia/haltia-mako", "config"),
                                run("makoctl", "reload")))
        self.refresh()

    def step(self, key, d):
        self.set(key, (int(self.values()[key]) + d) % 24)

    def on_switch(self, switch, _param):
        self.set("vibrate" if switch is self.vibrate else "quiet",
                 "on" if switch.get_active() else "off")

    @classmethod
    def peek(cls):
        v = cls.values()
        parts = ["с вибрацией" if v["vibrate"] == "on" else "без вибрации"]
        if v["quiet"] == "on":
            parts.append("ночью тихо")
        return ", ".join(parts)

    def refresh(self):
        v = self.values()
        set_quietly(self.vibrate, self.on_switch, v["vibrate"] == "on")
        set_quietly(self.quiet, self.on_switch, v["quiet"] == "on")
        self.stay.show_value(int(v["timeout"]))
        self.hour_from.set_text("%s:00" % v["quiet_from"])
        self.hour_to.set_text("%s:00" % v["quiet_to"])
        self.hours.set_sensitive(v["quiet"] == "on")


# --- for whoever looks after the tablet -------------------------------------------
CHOOSER_CONF = os.path.join(CONFIG, "chooser.conf")
CHOOSER_SERVICE = "org.freedesktop.impl.portal.desktop.haltia.service"
CLOSE_CONF = os.path.join(CONFIG, "close.conf")


def close_asks():
    """«✕» asks «Закрыть «…»?» first (haltia-ask close-front reads ask=)."""
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(CLOSE_CONF, encoding="utf-8")
        return conf.getboolean("close", "ask", fallback=True)
    except (configparser.Error, UnicodeDecodeError, ValueError):
        return True


def set_close_asks(on):
    os.makedirs(CONFIG, exist_ok=True)
    with open(CLOSE_CONF + ".new", "w", encoding="utf-8") as fh:
        fh.write("[close]\nask = %s\n" % ("yes" if on else "no"))
    os.replace(CLOSE_CONF + ".new", CLOSE_CONF)


def chooser_get(key, default):
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(CHOOSER_CONF, encoding="utf-8")
        return conf.getboolean("chooser", key, fallback=default)
    except (configparser.Error, UnicodeDecodeError, ValueError):
        return default


def chooser_set(**values):
    """Write the switches, keeping what the chooser keeps there (the last
    folder per program)."""
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(CHOOSER_CONF, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError):
        conf = configparser.ConfigParser(interpolation=None)
    if not conf.has_section("chooser"):
        conf.add_section("chooser")
    for key, value in values.items():
        conf.set("chooser", key, "yes" if value else "no")
    os.makedirs(CONFIG, exist_ok=True)
    with open(CHOOSER_CONF + ".new", "w", encoding="utf-8") as fh:
        conf.write(fh)
    os.replace(CHOOSER_CONF + ".new", CHOOSER_CONF)


class Helper:
    """What the person needs not see: the touch filter's values, the
    terminal, the update log, going back to any kept update, and programs
    hidden altogether. Shown after a long press on «О системе», until the
    window closes."""

    title = "Для помощника"

    def __init__(self, app):
        self.app = app
        self.touch = None
        self.widget, box = page_box()
        self.menu = listbox(self.on_menu)
        for key, name, sub in (
                ("touch", "Касания", "пороги фильтра случайных касаний и проверка"),
                ("term", "Терминал", "командная строка с правами администратора"),
                ("log", "Журнал обновлений", "что и когда обновлялось и откатывалось"),
                ("rollback", "Вернуть обновление целиком", "любое из сохранённых")):
            row = Gtk.ListBoxRow()
            row.add(row_box(name, sub, "›"))
            row.key = key
            self.menu.add(row)
        box.pack_start(self.menu, False, False, 0)
        # The file chooser of Файлы (haltia-files --portal): ~/.config/haltia/
        # chooser.conf, read by haltia-launch at every start and by the
        # chooser itself.
        if any(os.path.exists(d + "/dbus-1/services/" + CHOOSER_SERVICE)
               for d in ("/usr/share", "/usr/local/share")):
            box.pack_start(section("Выбор файлов"), False, False, 0)
            self.simple = switch_line(
                box, "Простой выбор файлов",
                "Крупные папки и картинки вместо обычного окна GTK; для программ, "
                "открытых после переключения", self.on_chooser)
            self.everything = switch_line(
                box, "Все файлы при выборе",
                "Показывать и домашнюю папку, и всю систему, и скрытые файлы",
                self.on_chooser)
            set_quietly(self.simple, self.on_chooser, chooser_get("simple", True))
            set_quietly(self.everything, self.on_chooser, chooser_get("all", False))
        box.pack_start(section("Закрытие программ"), False, False, 0)
        self.close_ask = switch_line(
            box, "Спрашивать перед закрытием",
            "«✕» сначала спрашивает «Закрыть «…»?»; выключено — закрывает сразу",
            self.on_close_ask)
        set_quietly(self.close_ask, self.on_close_ask, close_asks())
        box.pack_start(section("Программы"), False, False, 0)
        hint = Gtk.Label(label="Выключенная программа не видна ни на панели, ни на домашнем "
                         "экране", xalign=0, wrap=True)
        hint.get_style_context().add_class("sub")
        box.pack_start(hint, False, False, 0)
        self.list = listbox(lambda *_a: None)
        box.pack_start(self.list, False, False, 0)
        # The subpages: the touch page (the whole window), the log, going back.
        self.log_page, self.log_view = reading_view()
        self.back_page, self.back_box = page_box()
        self.subpages = {"log": self.log_page, "rollback": self.back_page}
        self.refresh()

    def refresh(self):
        self.app.programs.load(self.fill)

    def fill(self):
        for child in self.list.get_children():
            self.list.remove(child)
        for item in self.app.programs.items:
            if item["id"] == "settings":
                continue  # the way back to all of this
            row = Gtk.ListBoxRow(activatable=False)
            line = Gtk.Box(spacing=12)
            line.pack_start(icon_image(item["icon"]), False, False, 0)
            name = Gtk.Label(label=item["label"], xalign=0)
            name.get_style_context().add_class("name")
            line.pack_start(name, True, True, 0)
            sw = Gtk.Switch(valign=Gtk.Align.CENTER)
            sw.set_active(item["pinned"] or item["home"])
            sw.connect("notify::active", lambda s, _p, i=item: self.show_program(i, s))
            line.pack_end(sw, False, False, 0)
            row.add(line)
            self.list.add(row)
        self.list.show_all()

    def on_close_ask(self, *_a):
        set_close_asks(self.close_ask.get_active())

    def on_chooser(self, *_a):
        chooser_set(simple=self.simple.get_active(), all=self.everything.get_active())

    def show_program(self, item, switch):
        if switch.get_active():
            item["home"] = True
        else:
            item["home"] = item["pinned"] = False
            item["place"] = -1
        self.app.programs.save()

    def on_menu(self, _lb, row):
        if row.key == "term":
            subprocess.Popen(["/usr/bin/haltia-launch", "tap", "term"])
        elif row.key == "touch":
            self.open_touch()
        elif row.key == "log":
            self.open_log()
        elif row.key == "rollback":
            self.open_rollback()

    def open_touch(self):
        if self.touch is None:
            try:
                from importlib.machinery import SourceFileLoader
                mod = SourceFileLoader("haltia_touch",
                                       "/usr/bin/haltia-touch-settings").load_module()
                Gtk.StyleContext.add_provider_for_screen(
                    Gdk.Screen.get_default(), css_provider(mod.CSS),
                    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
                self.touch = mod.Setup(embedded=True)
            except Exception as exc:  # the touch filter's helper is missing
                say(self.app.win, "Касания недоступны: %s" % exc)
                return
            self.app.stack.add_named(self.touch.widget, "helper/touch")
            self.touch.widget.show_all()
        self.touch.enter()
        self.app.open_subpage("helper/touch", "Касания", wide=True)

    def open_log(self):
        set_reading(self.log_view, [("Читаю журнал…", "note")])
        self.app.open_subpage("helper/log", "Журнал обновлений")
        background(lambda: run(*UPDATE, "log", timeout=20).splitlines() or ["Журнал пуст."],
                   lambda lines: set_reading(self.log_view, [("\n".join(lines), "mono")]))

    def open_rollback(self):
        for child in self.back_box.get_children():
            self.back_box.remove(child)
        self.back_box.pack_start(row_box("Читаю сохранённые обновления…"), False, False, 0)
        self.back_box.show_all()
        self.app.open_subpage("helper/rollback", "Вернуть обновление целиком")
        background(lambda: Updates.fetch()[0].get("history", []), self.fill_rollback)

    def fill_rollback(self, history):
        for child in self.back_box.get_children():
            self.back_box.remove(child)
        if not history:
            self.back_box.pack_start(row_box("Сохранённых обновлений нет"), False, False, 0)
        lb = listbox(lambda *_a: None)
        for entry in history:
            row = Gtk.ListBoxRow(activatable=False)
            line = Gtk.Box(spacing=16)
            names = ", ".join(p["label"] for p in entry["programs"])
            line.pack_start(row_box(when(entry["time"]).capitalize(), names), True, True, 0)
            b = button("Вернуть всё", "plain", lambda e=entry: self.rollback(e))
            b.get_style_context().add_class("danger")
            line.pack_end(b, False, False, 0)
            row.add(line)
            lb.add(row)
        self.back_box.pack_start(lb, False, False, 0)
        self.back_box.show_all()

    def rollback(self, entry):
        if dialogs and not dialogs.ask(
                self.app.win, "Вернуть всё, что изменило обновление %s?" % when(entry["time"]),
                "Вернуть"):
            return
        run_async(UPDATE + ["rollback", entry["id"]],
                  lambda code, out: (say(self.app.win, "Возвращено." if code == 0 else
                                         "Не получилось: %s" % out.strip()[-200:]),
                                     self.open_rollback()) and False)

    def back(self):
        """«←» from a subpage: back to this page (the touch page undoes
        what was not kept)."""
        name = self.app.stack.get_visible_child_name()
        if name == "helper/touch" and self.touch:
            self.touch.leave()
        if name and name.startswith("helper/"):
            self.app.show("helper")
            return True
        return False

    def closing(self):
        if self.touch:
            self.touch.leave()


def css_provider(css):
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    return provider


# --- updates ----------------------------------------------------------------
UPDATE = ["doas", "-n", "/usr/libexec/haltia/haltia-update"]
RESTART = "/usr/libexec/haltia/haltia-restart"


def session_started():
    """When the panel (the session) started, epoch seconds, or 0."""
    try:
        pid = int(subprocess.run(["pidof", "waybar"], capture_output=True, text=True,
                                 timeout=5).stdout.split()[0])
        with open("/proc/stat") as fh:
            btime = next(int(x.split()[1]) for x in fh if x.startswith("btime "))
        with open("/proc/%d/stat" % pid) as fh:
            stat = fh.read()
        ticks = int(stat[stat.rindex(")") + 2:].split()[19])
        return btime + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, StopIteration, subprocess.SubprocessError):
        return 0


def shell_updated_since_start(st):
    """The shell was updated (and not taken back) after this session began:
    its panel and session take the new version at the next start."""
    begun = session_started()
    return bool(begun) and any(
        entry.get("time", 0) > begun and any(p["name"] == "haltia-shell" and
                                             not p.get("rolled_back")
                                             for p in entry.get("programs", []))
        for entry in st.get("history", []))


def group(name):
    """The package a subpackage belongs to, as haltia-update counts them."""
    return re.sub(r"-(pyc|lang|doc|openrc|ru)$", "", name)


def restart_after(packages):
    """The updated programs take up their new versions; a question for
    those with a window (haltia-restart --ask)."""
    if packages and os.access(RESTART, os.X_OK):
        subprocess.Popen([RESTART, "--ask", *sorted(set(packages))], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
MONTHS = ("января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа",
          "сентября", "октября", "ноября", "декабря")
STAGES = {"index": "Узнаю, что вышло…", "snapshot": "Сохраняю прежние версии…",
          "install": "Скачиваю и устанавливаю…", "rollback": "Возвращаю прежнюю версию…"}
RESULTS = {
    "updated": "Готово.",
    "nothing to update": "Обновлять нечего.",
    "battery: charge it first": "Поставьте планшет на зарядку: заряд меньше 30 %.",
    "storage: not enough room": "Мало места для обновления.",
    "network: no repository": "Нет сети.",
    "busy: another update runs": "Обновление уже идёт.",
    "rolled back": "Прежняя версия возвращена. Эту версию автообновление пропустит.",
    "failed, going back": "Обновление не удалось, всё возвращено как было.",
}


def system_versions(packages):
    """System packages as the notes page lists them: "name old → new"."""
    return [("%s %s → %s" % tuple(p[:3]), "item") for p in packages] or \
        [("Список пакетов не сохранился.", "note")]


def run_async(args, done):
    """Runs a command in a thread; done(returncode, output) in the main loop."""
    import threading

    def work():
        try:
            res = subprocess.run(args, capture_output=True, text=True, timeout=1800)
            out = (res.stdout or "") + (res.stderr or "")
            code = res.returncode
        except (OSError, subprocess.SubprocessError) as exc:
            code, out = 1, str(exc)
        GLib.idle_add(done, code, out)
    threading.Thread(target=work, daemon=True).start()


def run_lines(args, on_line, done):
    """Runs a command; on_line(text) for each line of its output as it
    comes, then done(returncode, last line), all in the main loop."""
    proc = Gio.Subprocess.new(args, Gio.SubprocessFlags.STDOUT_PIPE |
                              Gio.SubprocessFlags.STDERR_MERGE)
    stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
    last = [""]

    def got(src, result):
        try:
            line, _len = src.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:
            proc.wait_async(None, lambda p, r: (p.wait_finish(r),
                                                done(p.get_exit_status(), last[0])))
            return
        if line.strip():
            last[0] = line.strip()
            on_line(line.strip())
        src.read_line_async(GLib.PRIORITY_DEFAULT, None, got)

    stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)


def when(stamp):
    """A moment as people say it: «сегодня в 10:15», «20 октября в 10:15»."""
    t = time.localtime(stamp)
    today = time.localtime()
    hm = time.strftime("%H:%M", t)
    if t[:3] == today[:3]:
        return "сегодня в %s" % hm
    if t[:3] == time.localtime(time.time() - 86400)[:3]:
        return "вчера в %s" % hm
    return "%d %s в %s" % (t.tm_mday, MONTHS[t.tm_mon - 1], hm)


def release_date(text):
    """2026-10-18 as «18 октября 2026»."""
    try:
        y, m, d = (int(x) for x in text.split("-")[:3])
        return "%d %s %d" % (d, MONTHS[m - 1], y)
    except (ValueError, IndexError):
        return text


def button(text, kind, on_click):
    b = Gtk.Button(label=text, valign=Gtk.Align.CENTER)
    b.get_style_context().add_class(kind)
    b.connect("clicked", lambda _b: on_click())
    return b


class Updates:
    """haltia-update: what can be updated, program by program or all, what
    is new in each (a page of its own), updating with a way back, updating
    by itself, and going back program by program."""

    title = "Обновления"

    def __init__(self, app):
        self.app = app
        self.busy = False
        self.st = {}
        self.old = []  # what still runs its old version
        self.polling = False
        self.watch = None
        self.restart_pkgs = ()
        self.notes_for = None
        # The list is the page; «Что нового» a page of its own in the window's
        # stack (subpages), as a stack inside the page showed black edges.
        self.widget, box = page_box()

        # The state of things, with «Проверить».
        top = Gtk.Box(spacing=16)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.headline = Gtk.Label(xalign=0, wrap=True)
        self.headline.get_style_context().add_class("headline")
        text.pack_start(self.headline, False, False, 0)
        self.state = Gtk.Label(xalign=0, wrap=True)
        self.state.get_style_context().add_class("note")
        text.pack_start(self.state, False, False, 0)
        top.pack_start(text, True, True, 0)
        self.check_btn = button("Проверить", "plain", self.check)
        top.pack_end(self.check_btn, False, False, 0)
        box.pack_start(top, False, False, 0)

        # What runs now.
        self.work = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.work_label = Gtk.Label(xalign=0, wrap=True)
        self.work_label.get_style_context().add_class("note")
        self.work.pack_start(self.work_label, False, False, 0)
        self.bar = Gtk.ProgressBar()
        self.work.pack_start(self.bar, False, False, 0)
        self.work.set_no_show_all(True)
        self.work_label.show()
        self.bar.show()
        box.pack_start(self.work, False, False, 0)

        # What can be updated.
        head = Gtk.Box(spacing=16)
        self.avail_title = section("Можно обновить")
        head.pack_start(self.avail_title, True, True, 0)
        self.all_btn = button("Обновить всё", "action", lambda: self.upgrade(None))
        head.pack_end(self.all_btn, False, False, 0)
        self.avail_head = head
        head.set_no_show_all(True)
        self.avail_title.show()
        self.all_btn.show()
        box.pack_start(head, False, False, 0)
        self.list = listbox(self.on_row)
        box.pack_start(self.list, False, False, 0)

        # Updating by itself.
        line = Gtk.Box(spacing=16)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        label = Gtk.Label(label="Обновлять автоматически", xalign=0)
        label.get_style_context().add_class("note")
        text.pack_start(label, False, False, 0)
        hint = Gtk.Label(label="Раз в день, когда экран погашен, а планшет на зарядке",
                         xalign=0, wrap=True)
        hint.get_style_context().add_class("sub")
        text.pack_start(hint, False, False, 0)
        line.pack_start(text, True, True, 0)
        self.auto = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.auto.connect("notify::active", self.on_auto)
        line.pack_end(self.auto, False, False, 0)
        box.pack_start(line, False, False, 0)

        # The past ones; going back from one is the helper's.
        box.pack_start(section("Прошлые обновления"), False, False, 0)
        self.history = listbox(self.on_history_row)
        box.pack_start(self.history, False, False, 0)
        self.back_btn = button("Откатить последнее обновление", "plain", self.rollback_last)
        self.back_btn.get_style_context().add_class("danger")
        self.back_btn.set_halign(Gtk.Align.START)
        # Only when there is an update to go back from (show_all leaves it).
        self.back_btn.set_no_show_all(True)
        box.pack_start(self.back_btn, False, False, 0)

        # «Что нового» of one program: its releases, then «Обновить».
        notes = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        notes.get_style_context().add_class("page")
        scroll, self.notes_view = reading_view()
        notes.pack_start(scroll, True, True, 0)
        bottom = Gtk.Box(spacing=16)
        bottom.set_border_width(16)
        self.notes_btn = button("Обновить", "action", lambda: self.upgrade(self.notes_for))
        bottom.pack_end(self.notes_btn, False, False, 0)
        notes.pack_end(bottom, False, False, 0)
        self.subpages = {"notes": notes}
        self.refresh()

    # --- state ---------------------------------------------------------------
    CACHE_FOR = 10  # s: the list's line and the page opened with it share one read
    _cache = None  # (time, result)
    _lock = None

    @classmethod
    def fetch(cls, fresh=False):
        """haltia-update state (a Python start through doas) and what has
        not taken up its new version yet (haltia-restart, the shell), in a
        worker thread. One read serves every caller within CACHE_FOR
        seconds (the section's line and the page as the window opens);
        fresh reads anew. Never raises: ({}, []) when it cannot be had."""
        import json
        import threading
        if cls._lock is None:
            cls._lock = threading.Lock()
        with cls._lock:
            if not fresh and cls._cache and time.monotonic() - cls._cache[0] < cls.CACHE_FOR:
                return cls._cache[1]
            try:
                try:
                    st = json.loads(run(*UPDATE, "state", timeout=30) or "{}")
                except ValueError:
                    st = {}
                old = [x for x in run(RESTART, "pending").splitlines() if x.strip()]
                if st and shell_updated_since_start(st):
                    old.append("оболочка (полностью — после перезапуска планшета)")
                result = (st, old)
            except Exception as exc:  # noqa: BLE001 - the page must not stay greyed
                sys.stderr.write("haltia-settings: updates: %s\n" % exc)
                result = ({}, [])
            cls._cache = (time.monotonic(), result)
            return result

    @staticmethod
    def text(st):
        n = len(st.get("programs", []))
        return "есть обновления: %d" % n if n else "всё обновлено"

    @classmethod
    def peek(cls):
        return cls.text(cls.fetch()[0])

    def line(self):
        """The list's line from the state the page read last; none while
        there is no state (not read yet, or no update service)."""
        return self.text(self.st) if self.st else ""

    def refresh(self, then=None, fresh=False):
        """The state read again in the background; then() after it shows."""
        def got(result):
            self.st, self.old = result
            self.show_state()
            self.app.update_entry("updates")
            if then:
                then()
        # A refresh with then (after an update: restarting what it changed)
        # must always end; a plain one gives way to a newer one.
        background(lambda: self.fetch(fresh), got, fallback=({}, []),
                   latest="updates" if then is None else None)

    def show_state(self):
        st = self.st
        self.auto.handler_block_by_func(self.on_auto)
        self.auto.set_active(bool(st.get("auto")))
        self.auto.handler_unblock_by_func(self.on_auto)
        if st.get("busy") and not self.busy:
            # An update runs without us (by itself, or a window before):
            # show its progress until it ends.
            self.show_progress(st.get("progress") or {})
            if self.watch is None:
                self.watch = GLib.timeout_add_seconds(2, self.poll)
        if self.busy or st.get("busy"):
            self.set_sensitive(False)
        else:
            self.set_sensitive(True)
            self.work.hide()
        self.fill_state()
        self.fill_list()
        self.fill_history()

    def poll(self):
        """Every 2 s while an update runs without us: its progress, read in
        the background (one read at a time)."""
        if self.polling:
            return True
        self.polling = True

        def got(result):
            self.polling = False
            st = result[0]
            if st.get("busy"):
                self.show_progress(st.get("progress") or {})
                return
            if self.watch is not None:
                GLib.source_remove(self.watch)
                self.watch = None
            self.st, self.old = result
            self.show_state()
            self.app.update_entry("updates")
        # Not a latest= call: its result must always come, or polling would
        # stay set and the page never read again.
        background(lambda: self.fetch(fresh=True), got, fallback=({}, []))
        return True

    def fill_state(self):
        st = self.st
        n = len(st.get("programs", []))
        if not st:
            self.headline.set_text("Обновления недоступны")
            self.state.set_text("Нет службы обновлений.")
            self.check_btn.set_sensitive(False)
            return
        self.headline.set_text("Есть обновления: %d" % n if n else "Всё обновлено")
        when_ = ("Проверено %s." % when(st["checked"])) if st.get("checked") else \
            "Ещё не проверяли."
        if st.get("pending"):
            when_ += " Последнее обновление проверяется."
        # What has not taken up its new version yet (haltia-restart).
        old = self.old
        if old:
            when_ += " Заработают после перезапуска: %s." % ", ".join(old)
        self.state.set_text(when_)

    def fill_list(self):
        for child in self.list.get_children():
            self.list.remove(child)
        programs = self.st.get("programs", [])
        for prog in programs:
            row = Gtk.ListBoxRow()
            line = Gtk.Box(spacing=16)
            if prog["name"] == "system":
                sub = "обновится пакетов: %d · что нового ›" % len(prog["packages"])
            else:
                sub = "%s → %s · что нового ›" % (prog.get("old", "?"), prog.get("new", "?"))
            line.pack_start(row_box(prog["label"], sub), True, True, 0)
            b = button("Обновить", "plain", lambda p=prog: self.upgrade(p))
            line.pack_end(b, False, False, 0)
            row.add(line)
            row.prog = prog
            row.button = b
            self.list.add(row)
        self.list.show_all()
        self.avail_head.set_visible(bool(programs))
        self.all_btn.set_visible(len(programs) > 1)
        self.list.set_visible(bool(programs))

    def fill_history(self):
        for child in self.history.get_children():
            self.history.remove(child)
        entries = self.st.get("history", [])
        for entry in entries:
            for prog in entry["programs"]:
                # A tap: what came with it («что вошло», a subpage).
                row = Gtk.ListBoxRow()
                row.entry, row.prog = entry, prog
                line = Gtk.Box(spacing=16)
                if prog["name"] == "system":
                    sub = "пакетов: %d, %s" % (len(prog["packages"]), when(entry["time"]))
                else:
                    sub = "%s → %s, %s" % (prog.get("old", "?"), prog.get("new", "?"),
                                           when(entry["time"]))
                if prog.get("rolled_back"):
                    sub += " · возвращена прежняя"
                line.pack_start(row_box(prog["label"], sub, "›"), True, True, 0)
                # Going back is the helper's (shown after the long press on
                # «О системе»): an older version is not for the person to pick.
                if not prog.get("rolled_back") and self.app.helper_open():
                    b = button("Вернуть прежнюю", "plain",
                               lambda e=entry, p=prog: self.rollback(e, p))
                    b.get_style_context().add_class("danger")
                    line.pack_end(b, False, False, 0)
                row.add(line)
                self.history.add(row)
        if not entries:
            row = Gtk.ListBoxRow(activatable=False)
            row.add(row_box("Обновлений ещё не было"))
            self.history.add(row)
        self.back_btn.set_visible(bool(entries) and self.app.helper_open())
        self.history.show_all()

    def set_sensitive(self, on):
        for w in (self.check_btn, self.all_btn, self.back_btn, self.list, self.history,
                  self.notes_btn):
            w.set_sensitive(on)

    # --- work ----------------------------------------------------------------
    def show_progress(self, prog):
        self.work.show()
        text = STAGES.get(prog.get("stage"), "Обновляю…")
        pct = prog.get("percent", 0)
        if prog.get("stage") == "install":
            text += " %d %%" % pct
            self.bar.set_fraction(pct / 100)
        else:
            self.bar.pulse()
        self.work_label.set_text(text)

    def mark(self, names, text):
        """The rows of these programs say what happens to them (their
        «Обновить» buttons show it)."""
        for row in self.list.get_children():
            if names is None or row.prog["name"] in names:
                row.button.set_label(text)

    def start(self, args, label, targets=(), packages=()):
        """Runs haltia-update with its progress shown; the state is read
        again when it ends. targets: the programs in the list it updates
        (None: all), marked as waiting, then as being updated."""
        self.targets = targets
        self.restart_pkgs = packages  # what to start again after; None: the newest update's
        if targets != ():
            self.mark(targets, "Ждёт…")
        self.busy = True
        self.set_sensitive(False)
        self.work.show()
        self.work_label.set_text(label)
        self.bar.set_fraction(0)
        self.stage = None
        run_lines(UPDATE + args, self.on_line, self.finished)

    def on_line(self, line):
        word, _sp, rest = line.partition(" ")
        if word == "stage":
            self.stage = rest
            self.show_progress({"stage": rest})
            if rest == "install" and self.targets != ():
                self.mark(self.targets, "Обновляю…")
        elif word == "progress" and rest.isdigit():
            self.show_progress({"stage": self.stage or "install", "percent": int(rest)})

    def finished(self, code, last):
        self.busy = False
        self.work.hide()
        self.leave_notes()
        packages_ = self.restart_pkgs
        self.restart_pkgs = ()

        def after():
            self.state.set_text(RESULTS.get(last, "Не получилось." if code else "Готово."))
            if code == 0 and last in ("updated", "rolled back"):
                packages = packages_
                if packages is None:  # everything: what the newest update changed
                    history = self.st.get("history", [])
                    packages = [n for p in (history[0]["programs"] if history else [])
                                for n in p["packages"]]
                restart_after([group(n) for n in packages])
        self.refresh(after, fresh=True)

    def check(self):
        self.start(["check"], "Ищу обновления…")

    def upgrade(self, prog):
        if prog is None:
            if dialogs and not dialogs.ask(self.app.win,
                                           "Обновить всё сейчас? Планшет не выключайте",
                                           "Обновить"):
                return
            self.start(["upgrade"], "Обновляю всё…", None, None)
            return
        names = sorted({p[0] for p in prog["packages"]})
        self.start(["upgrade"] + names, "Обновляю «%s»…" % prog["label"], {prog["name"]}, names)

    def rollback(self, entry, prog):
        what = "Вернуть прежние системные компоненты?" if prog["name"] == "system" else \
            "Вернуть «%s» версии %s?" % (prog["label"], prog.get("old", ""))
        if dialogs and not dialogs.ask(self.app.win, what, "Вернуть"):
            return
        self.start(["rollback", entry["id"]] + prog["packages"], "Возвращаю прежнюю версию…",
                   packages=prog["packages"])

    def rollback_last(self):
        if dialogs and not dialogs.ask(
                self.app.win, "Вернуть программы, какими они были до последнего обновления?",
                "Вернуть"):
            return
        self.start(["rollback"], "Возвращаю прежние версии…", packages=None)

    def on_auto(self, switch, _param):
        spawn(*UPDATE, "auto", "on" if switch.get_active() else "off")

    # --- «Что нового» ----------------------------------------------------------
    def on_row(self, _lb, row):
        prog = row.prog
        if self.busy:
            return
        self.notes_for = prog
        set_reading(self.notes_view, [("Узнаю, что нового…", "note")])
        self.notes_btn.set_label("Обновить «%s»" % prog["label"])
        self.notes_btn.set_sensitive(True)
        self.notes_btn.set_visible(True)
        self.subpages["notes"].show_all()
        self.app.open_subpage("updates/notes", "%s: что нового" % prog["label"])
        if prog["name"] == "system":
            # No release notes for system packages: their names and versions,
            # as a past update of them shows.
            set_reading(self.notes_view, system_versions(prog.get("packages", [])))
            return
        run_async(UPDATE + ["changes", prog["name"]], self.show_notes)

    def on_history_row(self, _lb, row):
        """A past update: what came with it, on the same subpage as «Что
        нового», without «Обновить». System packages bring no notes: their
        names and versions."""
        if not hasattr(row, "prog") or self.busy:
            return
        prog, entry = row.prog, row.entry
        self.notes_for = None
        self.notes_btn.set_visible(False)
        self.subpages["notes"].show_all()
        self.notes_btn.hide()
        self.app.open_subpage("updates/notes", "%s: что вошло" % prog["label"])
        if prog["name"] == "system":
            set_reading(self.notes_view, system_versions(prog.get("versions", [])))
            return
        set_reading(self.notes_view, [("Узнаю, что вошло…", "note")])
        run_async(UPDATE + ["past", entry["id"], prog["name"]], self.show_notes)

    def show_notes(self, code, out):
        if self.app.stack.get_visible_child_name() != "updates/notes":
            return False
        lines = [l for l in out.splitlines() if l.strip()]
        if not lines:
            set_reading(self.notes_view, [(
                "Не удалось узнать: нет сети?" if code else
                "Автор не описал, что изменилось в этой версии.", "note")])
            return False
        parts = []
        for line in lines:
            # haltia-update's "VERSION DATE" line starts a release.
            head = re.fullmatch(r"(\d+(?:\.\d+)+\S*)(?: (\d{4}-\d\d-\d\d)?)?", line)
            if head:
                text = "Версия %s" % head.group(1)
                if head.group(2):
                    text += " · %s" % release_date(head.group(2))
                parts.append((text, "head"))
            else:
                parts.append((line, "item"))
        set_reading(self.notes_view, parts)
        return False

    def back(self):
        """The header's «←»: from «Что нового» back to the list."""
        if self.app.stack.get_visible_child_name() == "updates/notes":
            self.leave_notes()
            return True
        return False

    def leave_notes(self):
        if self.app.stack.get_visible_child_name() == "updates/notes":
            self.app.show("updates")
        self.notes_for = None


# --- about ----------------------------------------------------------------
class About:
    """The device, the system, memory, storage, the battery, the address."""

    title = "О системе"

    def __init__(self, app):
        self.app = app
        self.widget, box = page_box()
        self.list = listbox(lambda *_a: None)
        box.pack_start(self.list, False, False, 0)
        self.refresh()

    def refresh(self):
        background(self.fetch, self.fill)

    @staticmethod
    def fetch():
        """[(name, value)] (in a worker thread: apk, free, df, nmcli)."""
        model = ""
        for path in ("/proc/device-tree/model", "/sys/class/dmi/id/product_name"):
            try:
                with open(path) as fh:
                    model = fh.read().strip("\0\n ")
                    break
            except OSError:
                pass
        shell = run("apk", "info", "-e", "-v", "haltia-shell").splitlines()
        mem = run("free", "-m").splitlines()
        disk = run("df", "-h", "/").splitlines()
        battery = run("/usr/libexec/haltia/haltia-meter", "battery-info")
        addr = run("nmcli", "-g", "IP4.ADDRESS", "device", "show", "wlan0").split("|")[0]
        items = [("Haltia", "Спокойная сенсорная среда, которая о вас заботится"),
                 ("Устройство", model or "—"),
                 ("Оболочка", shell[0].replace("haltia-shell-", "Haltia ") if shell else "—")]
        if len(mem) > 1:
            parts = mem[1].split()
            items.append(("Память", "занято %s из %s МБ" % (parts[2], parts[1])))
        if len(disk) > 1:
            parts = disk[1].split()
            items.append(("Место", "свободно %s из %s" % (parts[3], parts[1])))
        if battery:
            pct, state = battery.split()
            items.append(("Батарея", "%s %%%s" % (pct, {"charging": ", заряжается",
                                                       "full": ", заряжена"}.get(state, ""))))
        if addr:
            items.append(("Адрес в сети", addr.split("/")[0]))
        return items

    def fill(self, items):
        for child in self.list.get_children():
            self.list.remove(child)
        for name, value in items:
            row = Gtk.ListBoxRow(activatable=False)
            row.add(row_box(name, value))
            self.list.add(row)
        self.list.show_all()


# --- the window ---------------------------------------------------------------
SIDEBAR = 360  # px, the list of sections beside a page
NARROW = 1000  # px: a screen narrower than this (portrait) shows one at a time
SECTIONS = (("network", "Network"), ("sound", "Sound"), ("screen", "Screen"),
            ("places", "Places"), ("notify", "Notify"), ("time", "DateTime"),
            ("updates", "Updates"), ("about", "About"))


class Settings(Gtk.Application):
    """The sections on the left, the chosen one on the right; on a portrait
    screen the list, then a section in its place. A long press on «О
    системе» shows «Для помощника» until the window closes."""

    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.pages = {}
        self.current = None
        self.wide_sub = False
        self.narrow = False
        self.programs = None

    def do_command_line(self, line):
        args = line.get_arguments()[1:]
        page = None
        if len(args) == 2 and args[0] == "--page" and args[1] in PAGES:
            page = args[1]
        self.setup()
        self.show(page or self.current or ("network" if not self.narrow else None))
        self.win.present()
        return 0

    def setup(self):
        if self.win:
            return
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css_provider(CSS), Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.programs = Programs()
        self.win = Gtk.ApplicationWindow(application=self, title="Настройки")
        self.win.set_default_size(1160, 800)
        self.win.connect("delete-event", self.on_close)
        self.header = Gtk.HeaderBar(title="Настройки")
        # «←» is the action app.back, enabled while there is a step back:
        # the shell shows its home button in this place otherwise
        # (haltia-badges follows the action over org.gtk.Actions).
        self.back_action = Gio.SimpleAction.new("back", None)
        self.back_action.connect("activate", lambda *_a: self.go_back())
        self.back_action.set_enabled(False)
        self.add_action(self.back_action)
        self.back = Gtk.Button(label="←")
        self.back.set_action_name("app.back")
        self.back.set_no_show_all(True)
        self.header.pack_start(self.back)
        self.win.set_titlebar(self.header)

        body = Gtk.Box()
        body.get_style_context().add_class("page")
        self.side = Gtk.ScrolledWindow()
        self.side.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.side.set_size_request(SIDEBAR, -1)
        self.side.get_style_context().add_class("sidebar")
        self.menu = listbox(self.on_menu)
        self.menu.get_style_context().add_class("sidebar")
        self.side.add(self.menu)
        body.pack_start(self.side, False, False, 0)
        self.line = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        body.pack_start(self.line, False, False, 0)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        # Each page as wide as itself: the touch page's two columns would
        # keep every page from fitting a portrait screen.
        self.stack.set_hhomogeneous(False)
        self.stack.set_vhomogeneous(False)
        body.pack_start(self.stack, True, True, 0)
        self.win.add(body)
        self.entries = {}
        for key, _cls in SECTIONS:
            self.add_entry(key)
        # The long press that shows «Для помощника».
        self.press = Gtk.GestureLongPress.new(self.menu)
        self.press.connect("pressed", self.on_long_press)
        # One column on a narrow screen: decided by the screen, as the list
        # beside a page would keep the window itself from getting narrow.
        screen = Gdk.Screen.get_default()
        screen.connect("size-changed", lambda *_a: self.on_size())
        screen.connect("monitors-changed", lambda *_a: self.on_size())
        self.win.show_all()
        self.on_size()

    @staticmethod
    def section_class(key):
        return globals()[dict(SECTIONS + (("helper", "Helper"),))[key]]

    def add_entry(self, key):
        row = Gtk.ListBoxRow()
        # The class's title: the page itself is built when first opened.
        content = row_box(self.section_class(key).title, " ")
        row.add(content)
        row.key = key
        row.content = content
        self.menu.add(row)
        row.show_all()
        self.entries[key] = row
        self.update_entry(key)

    def update_entry(self, key):
        """The line under a section's name: its peek() in the background
        (none: no line)."""
        def show(text):
            sub = self.entries[key].content.sub
            sub.set_text(text)
            sub.set_visible(bool(text))
        page = self.pages.get(key)
        if page is not None and hasattr(page, "line"):
            show(page.line())  # from what the page has read already
            return
        peek = getattr(self.section_class(key), "peek", None)
        if peek is None:
            self.entries[key].content.sub.hide()
            return
        background(peek, show, serial=True)

    def page(self, key):
        if key not in self.pages:
            self.pages[key] = self.section_class(key)(self)
            self.stack.add_named(self.pages[key].widget, key)
            self.pages[key].widget.show_all()
            for name, widget in getattr(self.pages[key], "subpages", {}).items():
                self.stack.add_named(widget, "%s/%s" % (key, name))
                widget.show_all()  # a stack shows only a visible child
        return self.pages[key]

    # --- what shows ----------------------------------------------------------
    def show(self, key):
        """A section (None: the list alone, on a narrow window)."""
        self.wide_sub = False
        if self.current in self.entries and self.current != key:
            self.update_entry(self.current)  # what was changed there
        if key is None:
            self.current = None
            self.header.set_title("Настройки")
        else:
            built = key in self.pages
            page = self.page(key)
            if built:
                page.refresh()  # a new page has just read its state itself
            self.current = key
            self.stack.set_visible_child_name(key)
            self.header.set_title(page.title)
            self.menu.select_row(self.entries[key]) if key in self.entries else None
        for k, row in self.entries.items():
            ctx = row.get_style_context()
            (ctx.add_class if k == key else ctx.remove_class)("chosen")
        self.chrome()

    def open_subpage(self, name, title, wide=False):
        """A page inside a section (Обновления → «Что нового», Касания);
        wide: the whole window, without the list."""
        self.wide_sub = wide
        self.stack.set_visible_child_name(name)
        self.header.set_title(title)
        self.chrome()

    def chrome(self):
        """The list, the page and «←» as the window's width and the page
        ask: «←» on a subpage, and on a section of a narrow window."""
        sub = "/" in (self.stack.get_visible_child_name() or "")
        alone = self.narrow and self.current is None
        self.side.set_visible(alone or not (self.narrow or self.wide_sub))
        self.line.set_visible(not self.narrow and not self.wide_sub)
        self.stack.set_visible(not alone)
        can = sub or (self.narrow and self.current is not None)
        self.back_action.set_enabled(can)
        self.back.set_visible(can)
        # Alone, the list takes the whole width.
        for prop in ("expand", "fill"):
            self.side.get_parent().child_set_property(self.side, prop, alone)
        self.side.set_size_request(-1 if self.narrow else SIDEBAR, -1)

    def on_size(self):
        display = Gdk.Display.get_default()
        monitor = display.get_monitor_at_window(self.win.get_window()) \
            if self.win.get_window() else display.get_monitor(0)
        narrow = monitor is not None and monitor.get_geometry().width < NARROW
        if narrow != self.narrow:
            self.narrow = narrow
            GLib.idle_add(self.relayout)

    def relayout(self):
        # Wide again with only the list shown: the first section beside it.
        if not self.narrow and self.current is None:
            self.show("network")
        else:
            self.chrome()
        return False

    def go_back(self):
        """«←»: a section's own subpage first, then (narrow) the list."""
        name = self.stack.get_visible_child_name() or ""
        page = self.pages.get(name.split("/")[0])
        if "/" in name and page and getattr(page, "back", None) and page.back():
            self.chrome()
            return
        if "/" in name:
            self.show(name.split("/")[0])
            return
        self.show(None)

    def on_menu(self, _lb, row):
        self.show(row.key)

    def on_long_press(self, _gesture, _x, y):
        row = self.menu.get_row_at_y(int(y))
        if row is None or row.key != "about":
            return
        if "helper" not in self.entries:
            self.add_entry("helper")
            # The updates' «Вернуть прежнюю» are the helper's too.
            updates = self.pages.get("updates")
            if updates is not None and getattr(updates, "st", None) is not None:
                updates.fill_history()
        self.show("helper")

    def helper_open(self):
        return "helper" in self.entries

    def on_close(self, *_args):
        helper = self.pages.get("helper")
        if helper:
            helper.closing()
        return False

    def refresh_summaries(self):
        for key in self.entries:
            self.update_entry(key)


if __name__ == "__main__":
    sys.exit(Settings().run(sys.argv))
