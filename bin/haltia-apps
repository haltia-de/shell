#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""The programs of the shell and the panel, as the person has set them.

    haltia-apps            write the files below (haltia-launcher, at session start)
    haltia-apps reload     write them and apply them to the running session
    haltia-apps panel      write them for the screen's orientation now, without
                        applying them (haltia-rotate reloads waybar itself)
    haltia-apps list       the ids one can put on the panel
    haltia-apps pin ID     put a program on the panel (last), and reload
    haltia-apps unpin ID   take it off, and reload
    haltia-apps autostart  start the XDG autostart entries meant for this shell
                        (haltia-launcher, once per session)

Four sources, later ones winning:
  /usr/share/haltia/apps.conf  the system programs the shell shows
                                  (Firefox, the calculator, ...)
  ~/.config/haltia/apps.conf         one's own programs, or changes to the
                                  built-in ones (same fields)
  .desktop files with X-Haltia-Home=true  programs that bring their own
                                  .desktop file (ADR 0001), under its id
                                  (io.github.haltia_de.Messenger); X-Haltia-Replaces
                                  names the old shell id(s) it takes over,
                                  so a pinned button moves with it
  installed programs              any id with a .desktop file, e.g. "gimp"
                                  for /usr/share/applications/gimp.desktop,
                                  when pinned by that id
and the pinned buttons from top to bottom, one id per line:
~/.config/haltia/panel, or else /usr/share/haltia/panel. Every program is
on the home screen (haltia-home) anyway; under the pinned ones the panel has
slots for programs that are open but not pinned (haltia-launch slot N).

Written to $XDG_RUNTIME_DIR/haltia/:
  apps.conf    every program, with "signal" set from its place on the
               panel; haltia-launch, haltia-focus, haltia-ask and haltia-splash read
               this one when it is there
  waybar.json  the panel: /usr/share/haltia/waybar/config with these
               buttons; along the bottom edge, in one row, while the
               screen stands portrait ("portrait" in orientation, written
               by haltia-rotate), where it has no hide button
  style.css    /usr/share/haltia/waybar/style.css and each program's icon
  slots        the waybar signal of each slot, one per line (haltia-focus)
  aliases      "old new" per line: old shell ids taken over by .desktop
               programs (haltia-launch maps them)
"""
import configparser
import json
import os
import re
import signal
import subprocess
import sys

SYSTEM = "/usr/share/haltia/apps.conf"
SYSTEM_PANEL = "/usr/share/haltia/panel"


def user_file(name):
    """~/.config/haltia/<name>, or the old ~/.config/b8k one that
    haltia-launcher has not moved yet (until 3.0)."""
    new = os.path.expanduser("~/.config/haltia/" + name)
    old = os.path.expanduser("~/.config/b8k/" + name)
    return old if not os.path.exists(new) and os.path.exists(old) else new


USER_APPS = user_file("apps.conf")
USER_PANEL = user_file("panel")
# The shell's panel, in its own folder: /etc/xdg/waybar belongs to waybar.
WAYBAR_CONFIG = "/usr/share/haltia/waybar/config"
WAYBAR_STYLE = "/usr/share/haltia/waybar/style.css"
# The XDG data folders, one's own first: programs installed with a prefix of
# /usr/local (install.sh) or /usr (a package) are found alike.
DATA_DIRS = [os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")] + \
    [d for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
     if d]
DESKTOP_DIRS = tuple(os.path.join(d, "applications") for d in DATA_DIRS)
ICON_DIRS = tuple(os.path.join(d, "icons/hicolor", size, "apps") for d in DATA_DIRS
                  for size in ("scalable", "256x256", "128x128", "96x96", "64x64", "48x48")) + \
    ("/usr/share/pixmaps",)
# Programs without an icon of their own: tiles.
APP_ICON = "/usr/share/haltia/app.svg"
# waybar signals of the system modules (home 8, 9 once brightness, Wi-Fi
# and volume 10, battery 11); program buttons and slots get 1-7, then 12 up.
RESERVED = range(8, 12)
# Pinned buttons and slots together. Five fit at full size under the home
# button; more get shorter (write_style).
MAX_BUTTONS = 10
FULL_SIZE = 5
ICON = 54  # px, a program's icon on its button (style.css)
MARK = 24  # px, a mark in a corner of it (haltia-launch marks)
SHARE = "/usr/share/haltia"
# At least this many slots for open programs, even with a long panel.
MIN_SLOTS = 2
# The panel along the bottom edge of a portrait screen: its height, and the
# width its buttons share (800 px less the home button, the status card
# and the clock).
BOTTOM_HEIGHT = 100
BOTTOM_ROOM = 480
PORTRAIT_CSS = """
/* Written by haltia-apps: the screen stands portrait, the panel is one row
   along the bottom edge (haltia-rotate). */
.app { min-width: %dpx; margin: 2px; }
#custom-home { min-width: 76px; margin: 4px 2px 4px 4px; }
#custom-sep { min-height: 0; min-width: 3px; margin: 14px 5px; }
#custom-status { min-width: 116px; margin: 8px 4px; }
#custom-clock { padding: 0 10px 0 6px; }
"""
FIELDS = ("label", "icon", "app_ids", "exec", "env", "home")
ALIASES = {}  # old shell id -> the .desktop program that replaced it (build())
# Programs renamed with Haltia 2.0 (ADR 0004): a pin, a count or a play mark
# under the old id finds the new program until 3.0, even when its .desktop
# file does not say so itself.
RENAMED = dict([("io.github.trudenboy.%s" % n, "io.github.haltia_de.%s" % n)
                for n in ("Calendar", "Files", "Gallery", "Music", "News", "Paint", "Text",
                          "Video", "Weather")]
               + [("io.github.trudenboy.Max", "io.github.haltia_de.Messenger"),
                  ("max", "io.github.haltia_de.Messenger")])


def xkey(entry, name):
    """X-Haltia-<name>, or X-B8K-<name> (programs of shell 1.x) until 3.0."""
    value = entry.get("X-Haltia-" + name)
    return entry.get("X-B8K-" + name, "") if value is None else value


def out_dir():
    run = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    path = os.path.join(run, "haltia")
    os.makedirs(path, exist_ok=True)
    return path


def portrait():
    try:
        with open(os.path.join(out_dir(), "orientation")) as fh:
            return fh.read().strip() == "portrait"
    except OSError:
        return False


def read_conf(path):
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(path, encoding="utf-8")
    except configparser.Error as exc:
        sys.stderr.write("haltia-apps: %s: %s\n" % (path, exc))
    return conf


def find_icon(name):
    if not name:
        return ""
    if name.startswith("/"):
        return name if os.path.exists(name) else ""
    for d in ICON_DIRS:
        for ext in (".svg", ".png"):
            path = os.path.join(d, name + ext)
            if os.path.exists(path):
                return path
    return ""


def read_desktop(path):
    """The [Desktop Entry] keys of a .desktop file ({} if unreadable)."""
    entry = {}
    section = None
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("["):
                    section = line
                    continue
                if section != "[Desktop Entry]" or "=" not in line or line.startswith("#"):
                    continue
                key, value = line.split("=", 1)
                entry[key.strip()] = value.strip()
    except OSError:
        return {}
    return entry


def command_of(entry):
    """Exec without its field codes (%f, %U, ...), or ""."""
    return re.sub(r"\s%[a-zA-Z]", "", entry.get("Exec", "")).strip()


def fields_of(app_id, entry):
    command = command_of(entry)
    if not command or entry.get("Type", "Application") != "Application":
        return None
    binary = os.path.basename(command.split()[0])
    ids = [x for x in (entry.get("StartupWMClass"), app_id, binary) if x]
    # Windows of helper programs that belong to it (Видео: b8k-vplay).
    ids += [w for w in re.split(r"[;\s]+", xkey(entry, "Windows")) if w]
    return {
        "label": entry.get("Name[ru]") or entry.get("Name") or app_id,
        "icon": find_icon(entry.get("Icon", "")),
        "app_ids": " ".join(dict.fromkeys(ids)),
        "exec": command,
    }


def desktop_app(app_id):
    """A program's fields from its .desktop file, or None."""
    for d in DESKTOP_DIRS:
        path = os.path.join(d, app_id + ".desktop")
        if os.path.exists(path):
            return fields_of(app_id, read_desktop(path))
    return None


def is_true(value):
    return (value or "").strip().lower() == "true"


def desktop_programs():
    """{id: (fields, [old ids])} of the .desktop files that ask to be on the
    home screen (X-Haltia-Home=true, or X-B8K-Home); one's own folder wins over
    the system's. The old .desktop file a renamed program keeps for a while
    (NoDisplay=true) is not one."""
    found = {}
    for d in reversed(DESKTOP_DIRS):
        try:
            names = sorted(n for n in os.listdir(d) if n.endswith(".desktop"))
        except OSError:
            continue
        for name in names:
            app_id = name[:-len(".desktop")]
            if not re.fullmatch(r"[A-Za-z0-9._-]+", app_id):
                continue
            entry = read_desktop(os.path.join(d, name))
            if (not is_true(xkey(entry, "Home")) or is_true(entry.get("Hidden"))
                    or is_true(entry.get("NoDisplay"))):
                found.pop(app_id, None)
                continue
            fields = fields_of(app_id, entry)
            if fields:
                old = [w for w in re.split(r"[;\s]+", xkey(entry, "Replaces")) if w]
                old += [o for o, new in RENAMED.items() if new == app_id and o not in old]
                found[app_id] = (fields, old)
    return found


def programs():
    """{id: fields} from the system catalogue, then one's own file."""
    apps = {}
    order = []
    for path in (SYSTEM, USER_APPS):
        conf = read_conf(path)
        for sec in conf.sections():
            fields = apps.setdefault(sec, {})
            if sec not in order:
                order.append(sec)
            for key in FIELDS + ("signal",):
                if key in conf[sec]:
                    fields[key] = conf[sec][key]
            if path == USER_APPS:
                fields["mine"] = "yes"
    return apps, order


def read_panel(path):
    ids = []
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            word = line.split("#", 1)[0].strip()
            if word and word not in ids:
                ids.append(word)
    return ids


def panel_ids(apps, replaced=None):
    """The ids to pin, an old id a .desktop program replaces mapped to its
    new one."""
    replaced = replaced or {}
    if os.path.exists(USER_PANEL):
        return list(dict.fromkeys(replaced.get(i, i) for i in read_panel(USER_PANEL)))
    # The default panel: the shell's list, where a program not installed
    # is left out. Everything else is on the home screen.
    if os.path.exists(SYSTEM_PANEL):
        ids = [replaced.get(i, i) for i in read_panel(SYSTEM_PANEL)]
        return list(dict.fromkeys(i for i in ids if i in apps))
    return []


def css_class(app_id):
    """The class haltia-launch gives a slot showing this program."""
    return "id-" + re.sub(r"[^A-Za-z0-9_-]", "-", app_id)


def signals():
    n = 1
    while True:
        if n not in RESERVED:
            yield n
        n += 1


def build():
    apps, order = programs()
    replaced = {}
    found = desktop_programs()
    # An old program and its renamed one both installed: the new one only.
    gone_all = {g for _f, old in found.values() for g in old}
    for app_id, (fields, old) in found.items():
        if app_id in gone_all:
            continue
        for gone in old:  # the program left its old shell id behind
            replaced[gone] = app_id
            if gone in apps:
                apps.pop(gone)
                order.remove(gone)
        if app_id not in apps:
            apps[app_id] = fields
            order.append(app_id)
    wanted = panel_ids(apps, replaced)
    panel = []
    for app_id in wanted:
        if not re.fullmatch(r"[A-Za-z0-9._-]+", app_id):
            sys.stderr.write("haltia-apps: skipped %r: an id has letters, digits, . _ -\n" % app_id)
            continue
        if app_id not in apps:
            found = desktop_app(app_id)
            if not found:
                sys.stderr.write("haltia-apps: no program %r (not in apps.conf, no %s.desktop)\n"
                                 % (app_id, app_id))
                continue
            apps[app_id] = found
            order.append(app_id)
        fields = apps[app_id]
        if not fields.get("exec"):
            sys.stderr.write("haltia-apps: %r has no exec\n" % app_id)
            continue
        panel.append(app_id)
    if len(panel) > MAX_BUTTONS - MIN_SLOTS:
        sys.stderr.write("haltia-apps: only the first %d buttons fit\n"
                         % (MAX_BUTTONS - MIN_SLOTS))
        panel = panel[:MAX_BUTTONS - MIN_SLOTS]

    ALIASES.clear()
    ALIASES.update(replaced)
    gen = signals()
    for app_id in order:
        apps[app_id]["signal"] = "0"
        if not apps[app_id].get("icon"):
            apps[app_id]["icon"] = APP_ICON
    for app_id in panel:
        apps[app_id]["signal"] = str(next(gen))
    slots = [next(gen) for _ in range(max(MIN_SLOTS, FULL_SIZE - len(panel)))]
    return apps, order, panel, slots


def write_apps(path, apps, order):
    lines = ["# Written by haltia-apps from %s, %s/, %s and the panel; do not edit."
             % (SYSTEM, "the .desktop files", USER_APPS)]
    for app_id in order:
        lines.append("")
        lines.append("[%s]" % app_id)
        for key in FIELDS + ("signal",):
            value = apps[app_id].get(key)
            if value:
                lines.append("%s = %s" % (key, value.replace("\n", " ")))
    with open(path + ".new", "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    os.replace(path + ".new", path)


def strip_comments(text):
    return re.sub(r"^\s*//.*$", "", text, flags=re.M)


def write_waybar(path, apps, panel, slots):
    with open(WAYBAR_CONFIG, encoding="utf-8") as fh:
        conf = json.loads(strip_comments(fh.read()))
    for key in [k for k in conf if k.startswith("custom/") and k[7:] in apps]:
        del conf[key]
    # The home button stays first; the pinned buttons, then the slots.
    head = [m for m in conf.get("modules-left", []) if m == "custom/home"]
    conf["modules-left"] = (head + ["custom/" + i for i in panel] + ["custom/sep"]
                            + ["custom/slot%d" % (n + 1) for n in range(len(slots))])
    # The line above the slots shares the first slot's signal.
    conf["custom/sep"] = {
        "exec": "/usr/bin/haltia-launch sep",
        "return-type": "json",
        "format": "{text}",
        "signal": slots[0],
        "exec-on-event": False,
        "tooltip": False,
    }
    for n, sig in enumerate(slots, 1):
        conf["custom/slot%d" % n] = {
            "exec": "/usr/bin/haltia-launch slot %d" % n,
            "return-type": "json",
            "format": "{text}",
            "signal": sig,
            "exec-on-event": False,
            "on-click-release": "/usr/libexec/haltia/haltia-press slot%d %d; /usr/bin/haltia-launch tap-slot %d"
                        % (n, sig, n),
            "tooltip": False,
        }
    if portrait():
        # One row along the bottom: the status card and the clock on the
        # right, no hide button.
        conf["position"] = "bottom"
        conf.pop("width", None)
        conf["height"] = BOTTOM_HEIGHT
        conf["modules-right"] = ["custom/status", "custom/clock"]
    for app_id in panel:
        sig = apps[app_id]["signal"]
        conf["custom/" + app_id] = {
            "exec": "/usr/bin/haltia-launch status " + app_id,
            "return-type": "json",
            "format": "{text}",
            "signal": int(sig),
            "exec-on-event": False,
            "on-click-release": "/usr/libexec/haltia/haltia-press %s %s; /usr/bin/haltia-launch tap %s"
                        % (app_id, sig, app_id),
            "tooltip": False,
        }
    with open(path + ".new", "w", encoding="utf-8") as fh:
        json.dump(conf, fh, ensure_ascii=False, indent=2)
    os.replace(path + ".new", path)


def status_css():
    """The status's three icons (haltia-meter status gives one class of each
    kind) as background layers of the one module, so it is one button: a
    rule for every Wi-Fi, volume and battery state together."""
    wifi = ["w%d" % n for n in range(5)] + ["wx"]
    vol = ["v%d" % n for n in range(5)]
    bat = ["b%d" % n for n in range(5)] + ["c%d" % n for n in range(5)] + ["low", "none"]
    file = {"w": "wifi-p%s.svg", "v": "vol-%s.svg", "b": "bat-b%s.svg", "c": "bat-c%s.svg"}

    def icon(cls):
        if cls == "low":
            return "bat-low.svg"
        if cls == "wx":
            return "wifi-x.svg"
        return file[cls[0]] % cls[1:]
    rules = ["", "/* Written by haltia-apps: the status's icons. */"]
    for w in wifi:
        for v in vol:
            for b in bat:
                # none: no battery (a desktop), Wi-Fi and the speaker only.
                shown = (w, v) if b == "none" else (w, v, b)
                rules.append(
                    "#custom-status.%s.%s.%s { background-image: %s; }"
                    % (w, v, b, ", ".join('url("%s/%s")' % (SHARE, icon(c)) for c in shown)))
    # Left edge, middle, right edge: apart, whatever the width.
    rules.append("#custom-status { background-position: 0%% 50%%, 50%% 50%%, 100%% 50%%;"
                 " background-size: %s; }" % ", ".join(["34px 26px"] * 3))
    return rules


def write_style(path, apps, order, panel, slots):
    with open(WAYBAR_STYLE, encoding="utf-8") as fh:
        css = fh.read()
    extra = ["", "/* Written by haltia-apps: the icon of each program, for its pinned button"
                 " and for a slot that shows it. */"]
    extra += status_css()
    buttons = len(panel) + len(slots)
    # The icon's size: smaller when more buttons than fit at full size share
    # the column (below), or the row in portrait.
    size = ICON
    if not portrait() and buttons > FULL_SIZE:
        size = min(ICON, 500 // buttons - 4 - 18) - 4
    for app_id in order:
        icon = apps[app_id].get("icon", "").replace('"', "")
        # Dots and the like in an id (org.gnome.Settings) need escaping in CSS.
        selector = re.sub(r"([^A-Za-z0-9_-])", r"\\\1", app_id)
        sel = "#custom-%s%%s, .%s%%s" % (selector, css_class(app_id))
        extra.append('%s { background-image: url("%s"); }' % (sel % ("", ""), icon))
        # The marks (haltia-launch marks): play or pause in the top left
        # corner, an unread count in the top right one, over the icon's
        # corners and clear of the label.
        for play in ("", "play", "pause"):
            for count in [""] + ["count-%s" % n for n in list(range(1, 10)) + ["many"]]:
                if not play and not count:
                    continue
                layers = [("mark-%s.svg" % play, "4px 2px")] if play else []
                if count:
                    layers.append(("mark-%s.svg" % count, "100% 2px"))
                classes = "".join("." + c for c in (play, count) if c)
                extra.append(
                    "%s { background-image: %s, url(\"%s\"); background-position: %s, center 5px;"
                    " background-size: %s, %dpx %dpx; }"
                    % (sel % (classes, classes),
                       ", ".join('url("%s/%s")' % (SHARE, f) for f, _p in layers), icon,
                       ", ".join(p for _f, p in layers),
                       ", ".join("%dpx %dpx" % (MARK, MARK) for _l in layers), size, size))
    if portrait():
        # The buttons share the row's room; crowded, the labels get smaller.
        width = max(52, min(92, BOTTOM_ROOM // max(1, buttons) - 4))
        extra.append(PORTRAIT_CSS % width)
        if width < 80:
            extra.append(".app { font-size: 12px; }")
    elif buttons > FULL_SIZE:
        # More buttons than fit at full size: shorter ones, smaller icons.
        # The rest of the 800 px column (home button, the line above the
        # slots, the status card, two-line clock, hide button:
        # style.css) leaves 500 px; 4 px are margins and 18 px the label.
        extra.append(".app { padding-top: %dpx; background-size: %dpx %dpx; min-height: 18px; }"
                     % (size + 4, size, size))
    with open(path + ".new", "w", encoding="utf-8") as fh:
        fh.write(css + "\n".join(extra) + "\n")
    os.replace(path + ".new", path)


def reload_session(uid):
    """Apply the files: waybar rereads its config, haltia-focus starts again."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.stat("/proc/" + pid).st_uid != uid:
                continue
            with open("/proc/%s/cmdline" % pid, "rb") as fh:
                args = fh.read().split(b"\0")
        except OSError:
            continue
        if args[0].endswith(b"waybar"):
            os.kill(int(pid), signal.SIGUSR2)
        elif len(args) > 2 and args[1].endswith(b"haltia-focus") and args[2] == b"watch":
            os.kill(int(pid), signal.SIGTERM)
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    log = open(os.path.join(run, "haltia/focus-watch.log"), "a") if run else subprocess.DEVNULL
    subprocess.Popen(["/usr/bin/haltia-focus", "watch"], stdout=log, stderr=log,
                     start_new_session=True)


def pin(app_id, on):
    """Put a program on the panel or take it off, in ~/.config/haltia/panel."""
    apps, _order, panel, _slots = build()
    if app_id not in apps:
        sys.stderr.write("haltia-apps: no program %r\n" % app_id)
        return False
    ids = [i for i in panel if i != app_id]
    if on:
        ids.append(app_id)
    os.makedirs(os.path.dirname(USER_PANEL), exist_ok=True)
    with open(USER_PANEL + ".new", "w", encoding="utf-8") as fh:
        fh.write("# The pinned panel buttons, top to bottom (haltia-apps).\n")
        fh.write("".join(i + "\n" for i in ids))
    os.replace(USER_PANEL + ".new", USER_PANEL)
    return True


AUTOSTART_DIRS = ("/etc/xdg/autostart", os.path.expanduser("~/.config/autostart"))


def autostart_entries():
    """{file name: entry} to start: one's own ~/.config/autostart entries,
    and the system's that carry X-Haltia-Autostart=true (the rest there are a
    full desktop's helpers this shell does without); one's own file of the
    same name wins, and Hidden=true switches an entry off."""
    chosen = {}
    for d in AUTOSTART_DIRS:
        mine = d.startswith(os.path.expanduser("~"))
        try:
            names = sorted(n for n in os.listdir(d) if n.endswith(".desktop"))
        except OSError:
            continue
        for name in names:
            entry = read_desktop(os.path.join(d, name))
            if is_true(entry.get("Hidden")) or not (mine or is_true(xkey(entry, "Autostart"))):
                chosen.pop(name, None)
                continue
            if entry.get("Type", "Application") == "Application" and command_of(entry):
                chosen[name] = entry
    return chosen


def autostart():
    import shlex

    run = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    for name, entry in autostart_entries().items():
        try:
            argv = shlex.split(command_of(entry))
        except ValueError:
            continue
        log = os.path.join(run, "haltia/autostart-%s.log" % name[:-len(".desktop")])
        try:
            with open(log, "w") as out:
                subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=out,
                                 start_new_session=True)
            print("autostart: %s" % name)
        except OSError as exc:
            sys.stderr.write("haltia-apps: autostart %s: %s\n" % (name, exc))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "autostart":
        autostart()
        return 0
    if cmd in ("pin", "unpin") and len(sys.argv) > 2:
        if not pin(sys.argv[2], cmd == "pin"):
            return 1
        cmd = "reload"
    if cmd not in ("", "reload", "list", "panel"):
        sys.stderr.write(__doc__)
        return 2
    apps, order, panel, slots = build()
    if cmd == "list":
        for app_id in order:
            mark = "*" if app_id in panel else " "
            print("%s %-12s %s" % (mark, app_id, apps[app_id].get("label", "")))
        return 0
    d = out_dir()
    write_apps(os.path.join(d, "apps.conf"), apps, order)
    write_waybar(os.path.join(d, "waybar.json"), apps, panel, slots)
    write_style(os.path.join(d, "style.css"), apps, order, panel, slots)
    with open(os.path.join(d, "aliases.new"), "w", encoding="utf-8") as fh:
        fh.write("".join("%s %s\n" % kv for kv in sorted(ALIASES.items())))
    os.replace(os.path.join(d, "aliases.new"), os.path.join(d, "aliases"))
    with open(os.path.join(d, "slots.new"), "w", encoding="utf-8") as fh:
        fh.write("".join("%d\n" % sig for sig in slots))
    os.replace(os.path.join(d, "slots.new"), os.path.join(d, "slots"))
    if cmd == "reload":
        reload_session(os.getuid())
        print("Панель: " + ", ".join(apps[i].get("label", i) for i in panel))
    return 0


if __name__ == "__main__":
    sys.exit(main())
