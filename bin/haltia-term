#!/bin/sh
# The terminal (Настройки → «Для помощника») runs a root shell (haltia-rootsh). The device
# may allow it without a password by a doas rule (install.sh writes one
# unless HALTIA_DOAS says otherwise); without that rule doas asks for the
# password, and when that fails too (no rule for this user, or no password
# given) the user's own login shell opens, so PATH still has the sbin
# directories.
if doas -n /usr/libexec/haltia/haltia-rootsh --check 2>/dev/null; then
	exec doas -n /usr/libexec/haltia/haltia-rootsh
fi
echo "Терминал администратора: пароль (Ctrl+C — обычный терминал)"
doas /usr/libexec/haltia/haltia-rootsh && exit 0
exec /bin/sh -l
