#!/bin/sh
# A tap focuses that program's window, or starts one copy.
# A program that is not open yet shows a blank loading screen until its window appears.
# status only reads the file the window watcher already wrote.
# It always prints the same label, so a button cannot disappear.
set -u
# Per-user runtime files. /tmp is shared, so another user could plant
# the web-app request or point a log at one of our files.
run=${XDG_RUNTIME_DIR:-$HOME/.cache}
dir="$run/haltia/launch"
mkdir -p "$dir"

# Every program and its fields live in apps.conf: the copy haltia-apps writes
# for this session (one's own programs and the panel included), else the
# built-in one.
APPS=/usr/share/haltia/apps.conf
# A session started by shell 1.x keeps its copy in $run/b8k until it restarts.
for a in "$run/haltia/apps.conf" "$run/b8k/apps.conf"; do
	[ -f "$a" ] && APPS=$a && break
done

# The simple file chooser (haltia-launcher): the helper's switch in
# Настройки reaches every program started from now on.
if [ -e "$run/haltia/portal" ]; then
	case $(sed -n 's/^[ \t]*simple[ \t]*=[ \t]*//p' "$HOME/.config/haltia/chooser.conf" 2>/dev/null | tail -1) in
	no | false | off | 0) unset GTK_USE_PORTAL ;;
	*) export GTK_USE_PORTAL=1 ;;
	esac
fi

# field ID KEY prints that key of the program, or fails when it has none.
field() {
	awk -v id="$1" -v key="$2" '
		/^[ \t]*[#;]/ { next }
		/^[ \t]*\[/ { sec = $0; gsub(/[][ \t]/, "", sec); next }
		sec == id {
			k = $0
			sub(/[ \t]*=.*/, "", k)
			gsub(/^[ \t]+/, "", k)
			if (k == key) {
				v = $0
				sub(/^[^=]*=[ \t]*/, "", v)
				sub(/[ \t]+$/, "", v)
				if (v != "") { print v; found = 1 }
				exit
			}
		}
		END { exit !found }' "$APPS"
}

# alive NAME: a live process of that name. pidof also lists zombies, and
# programs the panel started become zombies when they exit, because waybar
# does not reap them; a zombie Firefox kept web apps from starting it again.
alive() {
	for pid in $(pidof "$1" 2>/dev/null); do
		state=$(awk '/^State:/ { print $2; exit }' /proc/"$pid"/status 2>/dev/null || true)
		[ -n "$state" ] && [ "$state" != Z ] && return 0
	done
	return 1
}

# slot_id N: the Nth open program without a pinned button (signal 0): the
# one in front first, so it always has a slot, then the rest in apps.conf
# order. The panel shows these in its slots under the pinned ones.
slot_id() {
	[ -f "$dir/state" ] || return 1
	awk -v n="$1" '
		FNR == NR {
			if ($0 ~ /^[ \t]*\[/) { sec = $0; gsub(/[][ \t]/, "", sec); ids[++k] = sec; sig[sec] = 0; next }
			if ($0 ~ /^[ \t]*signal[ \t]*=/) { v = $0; sub(/^[^=]*=[ \t]*/, "", v); sig[sec] = v + 0 }
			next
		}
		$2 == "running" || $2 == "active" { open[$1] = 1 }
		$2 == "active" { front = $1 }
		END {
			if (front != "" && sig[front] == 0 && ++m == n) { print front; exit 0 }
			for (i = 1; i <= k; i++)
				if (open[ids[i]] && ids[i] != front && sig[ids[i]] == 0 && ++m == n) {
					print ids[i]; exit 0
				}
			exit 1
		}' "$APPS" "$dir/state"
}

label_of() { field "$1" label | json_text; }

# json_text: stdin made safe for waybar's JSON and its Pango markup. A label
# from another program's .desktop Name (a quote, a backslash, an ampersand)
# blanked the button or worse.
json_text() {
	sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
		-e 's/\\/\\\\/g' -e 's/"/\\"/g'
}
# A web app opens the site in its own Firefox window, without tabs or an address bar.
bin_of() { field "$1" exec; }
aliases_of() { field "$1" app_ids; }

# marks ID: the classes of the marks on the program's button, which the
# style haltia-apps writes draws in its corners, clear of the label: play or
# pause while its media player plays or is paused (haltia-badges follows
# MPRIS players into $run/haltia/play/<id>), and count-N (1-9, or many) for
# an unread count ($run/haltia/badge/<id>). Printed as ,"class" items.
marks() {
	state= badge=
	[ -f "$run/haltia/play/$1" ] && read -r state _ <"$run/haltia/play/$1" 2>/dev/null
	case $state in
	Playing) printf ',"play"' ;;
	Paused) printf ',"pause"' ;;
	esac
	[ -f "$run/haltia/badge/$1" ] && read -r badge <"$run/haltia/badge/$1" 2>/dev/null
	case $badge in
	'' | 0 | *[!0-9]*) ;;
	[1-9]) printf ',"count-%s"' "$badge" ;;
	*) printf ',"count-many"' ;;
	esac
}

# Firefox reads these from the profile, so they must be there before the
# first start: otherwise the large buttons only came with the second one.
install_firefox_chrome() {
	home=${HOME:-/home/user}
	# The profiles: haltia-firefox's large toolbar and prefs, with room for
	# the close button in the corner (--shell); b8k-firefox-profile was its
	# command before haltia-firefox 2.0.
	if command -v haltia-firefox-profile >/dev/null; then
		haltia-firefox-profile --shell || true
	elif command -v b8k-firefox-profile >/dev/null; then
		b8k-firefox-profile --shell || true
	fi
	root=$home/.config/mozilla/firefox
	# Firefox passes over a profile it did not make itself and makes its own
	# default-release, unless it keeps to the profiles.ini default. Only for
	# the profile made here: an older one stays as Firefox chose it.
	if [ -f "$root/profiles.ini" ] && ! grep -q '^\[Install' "$root/profiles.ini"; then
		export MOZ_LEGACY_PROFILES=1
	fi
}

# An old shell id a program with a .desktop file took over (haltia-apps writes
# "old new" lines: X-Haltia-Replaces), so the clock, the home screen and
# anyone's own settings still reach it by the old id.
if [ -n "${2:-}" ] && [ -f "$run/haltia/aliases" ]; then
	new=$(awk -v id="$2" '$1 == id { print $2; exit }' "$run/haltia/aliases")
	if [ -n "$new" ]; then
		cmd=$1
		shift 2
		set -- "$cmd" "$new" "$@"
	fi
fi

case ${1:-} in
status)
	id=${2:-}
	label=$(label_of "$id" || true)
	[ -n "$label" ] || label="$id"
	[ -n "$label" ] || label="*"
	class=idle
	if [ -f "$dir/state" ]; then
		found=$(awk -v id="$id" '$1 == id { print $2; exit }' "$dir/state" 2>/dev/null || true)
		case $found in
			active|running) class=$found ;;
		esac
	fi
	# haltia-press marks a tap for 300 ms; waybar ignores :active on touch.
	[ -e "$run/haltia/press/$id" ] && class=pressed
	printf '{"text":"%s","class":["app","%s"%s]}\n' "$label" "$class" "$(marks "$id")"
	exit 0
	;;
slot)
	# A slot shows the open program it holds, or nothing (waybar hides an
	# empty module).
	n=${2:-0}
	id=$(slot_id "$n" || true)
	if [ -z "$id" ]; then
		printf '{"text":""}\n'
		exit 0
	fi
	label=$(label_of "$id" || true)
	[ -n "$label" ] || label="$id"
	class=$(awk -v id="$id" '$1 == id { print $2; exit }' "$dir/state" 2>/dev/null || true)
	[ -e "$run/haltia/press/slot$n" ] && class=pressed
	cls=id-$(printf '%s' "$id" | tr -c 'A-Za-z0-9_-' '-')
	printf '{"text":"%s","class":["app","slot","%s","%s"%s]}\n' "$label" "${class:-running}" "$cls" \
		"$(marks "$id")"
	exit 0
	;;
sep)
	# The line between the pinned buttons and the slots: there while slot 1
	# holds a program.
	if slot_id 1 >/dev/null; then
		printf '{"text":" ","class":"sep"}\n'
	else
		printf '{"text":""}\n'
	fi
	exit 0
	;;
tap-slot)
	id=$(slot_id "${2:-0}" || true)
	[ -n "$id" ] || exit 0
	exec "$0" tap "$id"
	;;
home)
	# The shell's «⇤» at the top left (haltia-close): the home screen comes up
	# over the program, which stays open, and the program's panel button
	# flashes as pressed, so the person sees where it went and how to get
	# it back. An unpinned program in front always holds slot 1.
	/usr/libexec/haltia/haltia-home show
	front=$(awk '$2 == "active" { print $1; exit }' "$dir/state" 2>/dev/null || true)
	[ -n "$front" ] || exit 0
	sig=$(field "$front" signal || echo 0)
	case $sig in
	'' | *[!0-9]*) sig=0 ;;
	esac
	if [ "$sig" -gt 0 ]; then
		exec /usr/libexec/haltia/haltia-press "$front" "$sig"
	fi
	[ "$(slot_id 1 || true)" = "$front" ] || exit 0
	sig=$(sed -n 1p "$run/haltia/slots" 2>/dev/null)
	exec /usr/libexec/haltia/haltia-press slot1 ${sig:+"$sig"}
	;;
start)
	id=${2:-}
	if ! aliases_of "$id" >/dev/null; then
		# An entry with no windows of its own (a menu such as the old «Служебные») is
		# run as it is, without a curtain to wait under.
		bin=$(bin_of "$id") || exit 1
		# shellcheck disable=SC2086 # exec is split on spaces (apps.conf)
		setsid $bin </dev/null >"$run"/haltia/launch-"$id".log 2>&1 &
		exit 0
	fi
	setsid "$0" open "$id" </dev/null >"$run"/haltia/launch-"$id".log 2>&1 &
	exit 0
	;;
tap)
	# The front program asks before it closes. Any other tap still switches or starts.
	id=${2:-}
	# Over the home screen a tap means "go to it": lower the home screen,
	# never ask to close.
	if [ -e "$run/haltia/home.raised" ]; then
		/usr/libexec/haltia/haltia-home hide
		exec "$0" start "$id"
	fi
	aliases_of "$id" >/dev/null || exec "$0" start "$id"
	class=idle
	if [ -f "$dir/state" ]; then
		found=$(awk -v id="$id" '$1 == id { print $2; exit }' "$dir/state" 2>/dev/null || true)
		case $found in
			active|running) class=$found ;;
		esac
	fi
	# The program in front stays: closing is the "✕" in the corner
	# (haltia-close) for every program alike. One that plays or is paused
	# offers pause and stop instead (waybar has no long press).
	if [ "$class" = active ]; then
		[ -f "$run/haltia/play/$id" ] && exec /usr/bin/haltia-ask media "$id"
		exit 0
	fi
	exec "$0" start "$id"
	;;
url)
	# A link from a program (news: "open in the browser"). Firefox can take
	# 20 s to start cold, so the splash shows meanwhile, taps while it
	# starts are ignored, and the same link again within 15 s only raises
	# Firefox: repeated taps used to open the same page in several tabs.
	url=${2:-}
	case $url in
		https://* | http://*) ;;
		*) exit 2 ;;
	esac
	exec 9>"$dir/url.lock"
	if ! flock -n 9; then
		exit 0
	fi
	names=$(aliases_of firefox)
	last="$dir/last-url"
	if [ -f "$last" ] && [ "$(cat "$last")" = "$url" ] &&
		[ $(($(date +%s) - $(stat -c %Y "$last"))) -lt 15 ]; then
		/usr/bin/haltia-focus activate $names >/dev/null 2>&1
		exit 0
	fi
	printf '%s\n' "$url" >"$last"
	if alive firefox; then
		firefox "$url" >"$run"/haltia/app-firefox.log 2>&1 9>&- &
		i=0
		while [ "$i" -lt 10 ]; do
			sleep 0.5
			/usr/bin/haltia-focus activate $names >/dev/null 2>&1 && exit 0
			i=$((i + 1))
		done
		exit 0
	fi
	install_firefox_chrome
	splash_pid=
	if [ -x /usr/libexec/haltia/haltia-splash ]; then
		/usr/libexec/haltia/haltia-splash firefox >"$run"/haltia/splash.log 2>&1 9>&- &
		splash_pid=$!
	fi
	trap '[ -n "$splash_pid" ] && kill "$splash_pid" 2>/dev/null' EXIT
	firefox "$url" >"$run"/haltia/app-firefox.log 2>&1 9>&- &
	i=0
	while [ "$i" -lt 80 ]; do
		if /usr/bin/haltia-focus has $names >/dev/null 2>&1; then
			exit 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	exit 0
	;;
open)
	id=${2:-}
	exec 9>"$dir/$id.lock"
	if ! flock -n 9; then
		exit 0
	fi
	names=$(aliases_of "$id") || exit 0
	if /usr/bin/haltia-focus activate $names >/dev/null 2>&1; then
		exit 0
	fi
	bin=$(bin_of "$id") || exit 0
	if [ "$id" = firefox ]; then
		install_firefox_chrome
	fi
	# The app must not inherit the lock fd. While it holds that fd,
	# every later tap fails the lock and the window never switches.
	splash_pid=
	stop_splash() {
		if [ -n "$splash_pid" ]; then
			kill "$splash_pid" 2>/dev/null || true
			splash_pid=
		fi
		# No longer starting: the close button (haltia-close) looks again.
		rm -f "$dir/starting"
		/usr/libexec/haltia/haltia-close update 2>/dev/null || true
	}
	trap stop_splash EXIT
	if [ -x /usr/libexec/haltia/haltia-splash ]; then
		/usr/libexec/haltia/haltia-splash "$id" >"$run"/haltia/splash.log 2>&1 9>&- &
		splash_pid=$!
	fi
	env=$(field "$id" env || true)
	if [ -n "$env" ]; then
		export "$env"
	fi
	# exec may carry arguments; apps.conf has no quoting, so plain splitting.
	# HALTIA_LAUNCH_ARGS adds some for this start (haltia-ask status opens
	# Settings at its Wi-Fi page).
	# shellcheck disable=SC2086
	$bin ${HALTIA_LAUNCH_ARGS:-} >"$run"/haltia/app-"$id".log 2>&1 9>&- &
	# The program's process, for haltia-stop when it hangs and «✕» cannot
	# close it: the pid and its start time (field 22 of /proc/PID/stat),
	# which haltia-stop compares, as the file outlives the program and the
	# pid may be another process's by then.
	pid=$!
	start=$(sed 's/.*) //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f20)
	mkdir -p "$dir/pid" && echo "$pid ${start:-0}" >"$dir/pid/$id"
	# While it starts, the close button stops it (haltia-ask close-front kills
	# the pid and the curtain, and removes this file) and the home button
	# takes the curtain away (haltia-home).
	echo "$id $pid ${splash_pid:-0}" >"$dir/starting"
	/usr/libexec/haltia/haltia-close update 2>/dev/null || true
	i=0
	while [ "$i" -lt 40 ] && [ -e "$dir/starting" ]; do
		if /usr/bin/haltia-focus has $names >/dev/null 2>&1; then
			exit 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	;;
*)
	ids=$(awk '/^[ \t]*\[/ { s = $0; gsub(/[][ \t]/, "", s); printf "%s%s", sep, s; sep = "|" }' "$APPS")
	echo "usage: haltia-launch status|start|tap <$ids> | haltia-launch url <link>" >&2
	exit 2
	;;
esac
