#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""Counts on panel buttons from the standard programs use on any desktop.

A program sets the number on its launcher with the Unity LauncherEntry
signal (what GNOME's Dash to Dock, KDE's task manager and Plank read):

    com.canonical.Unity.LauncherEntry.Update(
        "application://io.github.trudenboy.Max.desktop",
        {"count": <int64 4>, "count-visible": <true>})

b8k-badges (started by b8k-launcher) hears it on the session bus and hands
the number to the panel: $XDG_RUNTIME_DIR/b8k-badge/<id>, which
b8k-launch status shows on the button, then the button is told (badge()). The program is found in the session's
apps.conf by its id, or by an app_ids word, which is how a program still
under its old shell id (max, with app_ids b8k.Max) is found. A count that
is not visible, or a program leaving the bus, clears the number.

It also follows the media players on the bus (MPRIS: any
org.mpris.MediaPlayer2.* name, found by its DesktopEntry): a player that
plays or is paused writes "Playing <bus name>" or "Paused <bus name>" to
$XDG_RUNTIME_DIR/b8k-play/<id>, which b8k-launch status marks on the
button (▶ or ‖) and b8k-ask media uses to pause or stop it; stopped, or
gone from the bus, removes the file.
"""
import configparser
import glob
import os
import signal

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

SHARE = "/usr/share/b8k"
WAYBAR = "/usr/bin/waybar"


def apps_conf():
    """The session's apps.conf (b8k-apps), else the built-in one."""
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    session = os.path.join(run, "b8k", "apps.conf")
    return session if run and os.path.exists(session) else os.path.join(SHARE, "apps.conf")


def panel_signal(app_id):
    """The program's waybar signal (b8k-apps numbers the buttons by their
    place on the panel); 0 when it has no button."""
    try:
        with open(apps_conf(), encoding="utf-8") as fh:
            inside = False
            for line in fh:
                line = line.strip()
                if line.startswith("["):
                    inside = line == "[%s]" % app_id
                elif inside and line.replace(" ", "").startswith("signal="):
                    return int(line.split("=", 1)[1])
    except (OSError, ValueError):
        pass
    return 0


def slot_signals():
    """The signals of the panel's slots (b8k-apps writes them): an open
    program without a button of its own shows in one of them."""
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        with open(os.path.join(run, "b8k", "slots")) as fh:
            return [int(l) for l in fh if l.strip().isdigit()]
    except OSError:
        return []


def badge(app_id, count):
    """Write the number b8k-launch shows on the program's button, then tell
    waybar to redraw it."""
    run = os.environ.get("XDG_RUNTIME_DIR")
    if not run:
        return
    folder = os.path.join(run, "b8k-badge")
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        path = os.path.join(folder, app_id)
        with open(path + ".new", "w") as fh:
            fh.write("%d\n" % count)
        os.replace(path + ".new", path)
    except OSError:
        return
    redraw(panel_signal(app_id))


def redraw(*sigs):
    """Tell waybar to redraw the modules on these signals. An uncaught
    real-time signal would kill the bar, and the whole session with it, so
    only a waybar that catches it gets one."""
    for sig in sigs:
        if sig > 0:
            send(signal.SIGRTMIN + sig)


def send(signum):
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.readlink("/proc/%s/exe" % pid) != WAYBAR:
                continue
            if os.stat("/proc/" + pid).st_uid != os.getuid():
                continue
            with open("/proc/%s/status" % pid) as fh:
                caught = next((int(l.split()[1], 16) for l in fh if l.startswith("SigCgt:")), 0)
            if caught >> (signum - 1) & 1:
                os.kill(int(pid), signum)
        except (OSError, ValueError):
            continue


shown = {}  # bus name -> the ids it set a count for


def program_of(desktop_id):
    """The apps.conf section for a .desktop id, or None."""
    conf = configparser.ConfigParser(interpolation=None)
    try:
        conf.read(apps_conf(), encoding="utf-8")
    except configparser.Error:
        return None
    if conf.has_section(desktop_id):
        return desktop_id
    for sec in conf.sections():
        if desktop_id in conf[sec].get("app_ids", "").split():
            return sec
    return None


def on_update(_bus, sender, _path, _iface, _signal, params, _data):
    try:
        uri, props = params.unpack()
    except (TypeError, ValueError):
        return
    if not uri.startswith("application://") or not uri.endswith(".desktop"):
        return
    desktop_id = uri[len("application://"):-len(".desktop")]
    if not desktop_id or "/" in desktop_id:
        return
    app = program_of(desktop_id)
    if app is None:
        return
    count = props.get("count", 0) if props.get("count-visible", False) else 0
    try:
        count = max(0, min(int(count), 9999))
    except (TypeError, ValueError):
        count = 0
    badge(app, count)
    shown.setdefault(sender, set()).add(app)


def on_owner(_bus, _sender, _path, _iface, _signal, params, _data):
    name, _old, new = params.unpack()
    if new or name not in shown:
        return
    for app in shown.pop(name):  # the program left the bus: no count from it now
        badge(app, 0)


MPRIS = "org.mpris.MediaPlayer2"
players = {}  # unique bus name -> [well-known name, apps.conf id or None]


def play_mark(app_id, status, name):
    """The player's state for the panel: a file while it plays or is
    paused, none when stopped; then its button and the slots redraw."""
    run = os.environ.get("XDG_RUNTIME_DIR")
    if not run or not app_id:
        return
    folder = os.path.join(run, "b8k-play")
    path = os.path.join(folder, app_id)
    try:
        if status in ("Playing", "Paused"):
            os.makedirs(folder, mode=0o700, exist_ok=True)
            with open(path + ".new", "w") as fh:
                fh.write("%s %s\n" % (status, name))
            os.replace(path + ".new", path)
        elif os.path.exists(path):
            os.unlink(path)
        else:
            return
    except OSError:
        return
    redraw(panel_signal(app_id), *slot_signals())


def player_prop(bus, name, iface, prop):
    try:
        res = bus.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties",
                            "Get", GLib.Variant("(ss)", (iface, prop)),
                            GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 2000, None)
        return res.unpack()[0]
    except GLib.Error:
        return None


def add_player(bus, name, unique):
    """A player came onto the bus: whose it is (DesktopEntry, else the
    end of its bus name) and how it plays now."""
    entry = player_prop(bus, name, MPRIS, "DesktopEntry") or name[len(MPRIS) + 1:]
    app = program_of(entry)
    players[unique] = [name, app]
    play_mark(app, player_prop(bus, name, MPRIS + ".Player", "PlaybackStatus"), name)


def on_props(_bus, sender, _path, _iface, _signal, params, _data):
    try:
        iface, changed, _gone = params.unpack()
    except (TypeError, ValueError):
        return
    if iface != MPRIS + ".Player" or "PlaybackStatus" not in changed:
        return
    player = players.get(sender)
    if player:
        play_mark(player[1], changed["PlaybackStatus"], player[0])


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def on_player_owner(_bus, _sender, _path, _iface, _signal, params, _data):
        name, old, new = params.unpack()
        if not name.startswith(MPRIS + "."):
            return
        if old and old in players:
            gone = players.pop(old)
            play_mark(gone[1], "Stopped", gone[0])
        if new:
            add_player(bus, name, new)

    bus.signal_subscribe(None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         "/org/mpris/MediaPlayer2", None, Gio.DBusSignalFlags.NONE, on_props,
                         None)
    bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                         "/org/freedesktop/DBus", None, Gio.DBusSignalFlags.NONE,
                         on_player_owner, None)
    # Players already on the bus (b8k-badges restarted with the session).
    run = os.environ.get("XDG_RUNTIME_DIR")
    if run:
        for old in glob.glob(os.path.join(run, "b8k-play", "*")):
            try:
                os.unlink(old)
            except OSError:
                pass
    names = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "ListNames", None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE,
                          -1, None).unpack()[0]
    for name in names:
        if name.startswith(MPRIS + "."):
            try:
                unique = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                       "org.freedesktop.DBus", "GetNameOwner",
                                       GLib.Variant("(s)", (name,)), GLib.VariantType("(s)"),
                                       Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
            except GLib.Error:
                continue
            add_player(bus, name, unique)
    bus.signal_subscribe(None, "com.canonical.Unity.LauncherEntry", "Update", None, None,
                         Gio.DBusSignalFlags.NONE, on_update, None)
    bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                         "/org/freedesktop/DBus", None, Gio.DBusSignalFlags.NONE, on_owner,
                         None)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
