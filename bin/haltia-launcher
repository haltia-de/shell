#!/bin/sh
# Haltia's session (the device's session loop runs it under phoc).
# Program buttons, a Wi-Fi icon, a battery icon and a clock.
# A tap on Wi-Fi opens Settings. A tap on the battery opens the power menu.
# One window watcher updates a button only when its state changes.
# The keyboard stays hidden until a text field is focused.
run=${XDG_RUNTIME_DIR:-$HOME/.cache}
mkdir -p "$run/haltia"
# Seconds since boot at each step, in $run/haltia/start.log: what a slow
# start spent its time on.
stamp() {
	read -r up _ </proc/uptime
	echo "$up $1" >>"$run/haltia/start.log"
}
: >"$run/haltia/start.log"
stamp start
# The shell's own settings move from ~/.config/b8k (shell 1.x) to
# ~/.config/haltia, file by file: the programs move theirs (haltia-kit).
mkdir -p "$HOME/.config/haltia"
for f in panel apps.conf brightness rotate filechooser-1; do
	if [ -e "$HOME/.config/b8k/$f" ] && [ ! -L "$HOME/.config/b8k/$f" ] &&
		[ ! -e "$HOME/.config/haltia/$f" ]; then
		mv "$HOME/.config/b8k/$f" "$HOME/.config/haltia/$f"
	fi
done
# No screen reader runs here. Without these GTK starts the at-spi bus and
# its registry for every session.
export NO_AT_BRIDGE=1 GTK_A11Y=none
# The shell's GTK theme (themes/Haltia): tall headers with room for «✕», large
# questions. A program with a theme of its own (env= in apps.conf) keeps it.
if [ -f /usr/share/themes/Haltia/gtk-3.0/gtk.css ]; then
	export GTK_THEME=Haltia
fi
# The programs and the panel as set in ~/.config/haltia (haltia-apps): the
# session's apps.conf, read by everything started below, and the panel's
# config and style. Without them, the built-in ones.
panel=
# phoc starts with the screen in landscape; haltia-rotate writes portrait.
# No program in front yet: taps buzz (haltia-focus marks quiet-taps). No
# home screen raised and no program starting either: marks a session that
# ended uncleanly left would hide «✕».
rm -f "$run"/haltia/apps.conf "$run"/haltia/orientation "$run"/haltia/rotation "$run"/haltia/quiet-taps \
	"$run"/haltia/home.raised "$run"/haltia/launch/starting
if [ -x /usr/bin/haltia-apps ] && /usr/bin/haltia-apps >"$run"/haltia/apps.log 2>&1 &&
	[ -s "$run"/haltia/waybar.json ] && [ -s "$run"/haltia/style.css ]; then
	panel=yes
fi
stamp apps
# The keepers of an earlier session (haltia-keep) end first, and their
# daemons with them: one that outlived its compositor would otherwise start
# a daemon of this session it does not watch over.
for d in /proc/[0-9]*; do
	[ -O "$d" ] || continue
	case $(tr '\0' '\n' <"$d/cmdline" 2>/dev/null | sed -n 2p) in
	/usr/libexec/haltia/haltia-keep) kill "${d#/proc/}" 2>/dev/null ;;
	esac
done
# The home screen: every program as a tile, on the background layer right
# of the panel; the panel's home button raises it over the windows. It and
# the daemons below run under haltia-keep, which starts one that ends
# again (a few times a minute at most) until the session ends.
if [ -x /usr/libexec/haltia/haltia-home ]; then
	setsid /usr/libexec/haltia/haltia-keep --session /usr/libexec/haltia/haltia-home >"$run"/haltia/home.log 2>&1 &
fi
# The "✕" in the top right corner that closes the program in front.
if [ -x /usr/libexec/haltia/haltia-close ]; then
	setsid /usr/libexec/haltia/haltia-keep --session /usr/libexec/haltia/haltia-close >"$run"/haltia/close.log 2>&1 &
fi
# The file chooser's places (MAX's «Сохранить как», Firefox): the usual
# folders that exist, added once each; one's own bookmarks stay.
marks="$HOME/.config/gtk-3.0/bookmarks"
mkdir -p "${marks%/*}"
for d in Загрузки Downloads Документы Изображения Музыка Видео Изображения/Раскраски; do
	[ -d "$HOME/$d" ] || continue
	uri="file://$HOME/$d"
	awk -v u="$uri" '$1 == u { f = 1 } END { exit !f }' "$marks" 2>/dev/null ||
		printf '%s %s\n' "$uri" "${d##*/}" >>"$marks"
done
# The chooser writes all its settings to dconf whenever it closes, so the
# shell's defaults (91-haltia-shell.gschema.override) reach one who used it
# before only through a reset: once, then one's own choices stay.
if [ ! -e "$HOME/.config/haltia/filechooser-1" ] && command -v gsettings >/dev/null; then
	for k in startup-mode sort-directories-first show-size-column show-type-column \
		sidebar-width window-size window-position; do
		gsettings reset org.gtk.Settings.FileChooser "$k" 2>/dev/null
	done
	mkdir -p "$HOME/.config/haltia" && : >"$HOME/.config/haltia/filechooser-1"
fi
# The simple file chooser (haltia-files --portal) for every program: GTK 3
# and Firefox ask the portal for it once GTK_USE_PORTAL=1. A real
# xdg-desktop-portal calls it (haltia-portals.conf); without one,
# haltia-portal stands in, started here and, should it end, again by D-Bus
# from the session's own service folder (never one beside a real portal's
# file). $run/haltia/portal says a portal is there; the switch in Настройки →
# «Для помощника» (~/.config/haltia/chooser.conf, simple = no) leaves
# GTK_USE_PORTAL out, here and in haltia-launch for programs started later.
rm -f "$run/dbus-1/services/org.freedesktop.portal.Desktop.service" "$run/haltia/portal"
chooser=
for d in /usr/share /usr/local/share; do
	[ -f "$d/dbus-1/services/org.freedesktop.impl.portal.desktop.haltia.service" ] && chooser=yes
done
if [ -n "$chooser" ]; then
	if [ -f /usr/share/dbus-1/services/org.freedesktop.portal.Desktop.service ]; then
		: >"$run/haltia/portal"
	elif [ -x /usr/libexec/haltia/haltia-portal ]; then
		mkdir -p "$run/dbus-1/services"
		printf '[D-BUS Service]\nName=org.freedesktop.portal.Desktop\nExec=/usr/libexec/haltia/haltia-portal\n' \
			>"$run/dbus-1/services/org.freedesktop.portal.Desktop.service"
		: >"$run/haltia/portal"
	fi
fi
if [ -e "$run/haltia/portal" ]; then
	case $(sed -n 's/^[ \t]*simple[ \t]*=[ \t]*//p' "$HOME/.config/haltia/chooser.conf" 2>/dev/null | tail -1) in
	no | false | off | 0) ;;
	*) export GTK_USE_PORTAL=1 ;;
	esac
fi
# The calculator's large display and keys (share/galculator.conf, in
# /etc/skel). A home made without skel, or galculator run before the shell
# came, has galculator's own small defaults (40 px keys, its button font
# off): those give way to the shell's; a file one changed stays.
galc="$HOME/.config/galculator/galculator.conf"
if [ -f /etc/skel/.config/galculator/galculator.conf ] && { [ ! -e "$galc" ] ||
	{ grep -qx 'button_width=40' "$galc" && grep -qx 'custom_button_font=false' "$galc"; }; }; then
	mkdir -p "${galc%/*}" && cp /etc/skel/.config/galculator/galculator.conf "$galc"
fi
# GTK 4 and libadwaita programs (GNOME Settings) take no GTK theme, only a
# user style sheet: the shell's header for them, unless one has a style
# sheet of one's own; no window buttons (the shell's «✕» closes).
gtk4="$HOME/.config/gtk-4.0"
mkdir -p "$gtk4"
[ -e "$gtk4/gtk.css" ] ||
	printf '/* Haltia (haltia-launcher): remove the line below to style GTK 4 yourself. */\n@import url("file:///usr/share/haltia/gtk-4.0.css");\n' >"$gtk4/gtk.css"
[ -e "$gtk4/settings.ini" ] ||
	printf '[Settings]\ngtk-decoration-layout=:\n' >"$gtk4/settings.ini"
# The brightness chosen last time (haltia-brightness keeps it). In the
# background: its GTK import takes 1.5-3 s here, and the panel waits for
# nothing it does.
/usr/bin/haltia-brightness --restore >"$run"/haltia/brightness.log 2>&1 &
# Settings, the portals (xdg-desktop-portal: gtk, wlr) and feedbackd start
# through D-Bus activation and take the bus environment.
dbus-update-activation-environment NO_AT_BRIDGE GTK_A11Y ${GTK_THEME:+GTK_THEME} \
	${GTK_USE_PORTAL:+GTK_USE_PORTAL} WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null
# Helpers that need no display outlive the session that started them
# (setsid): one of each, or a volume key steps two or three times. So does
# the sound server each session's first client spawns: a new one starts on
# the next pactl. Their keepers (haltia-keep, whose command line ends with
# the helper's) go too. (busybox's pkill has no -u: ps, for this user only.)
for pid in $(ps -o pid,user,args | awk -v u="$(id -un)" '$2 == u &&
	($NF ~ /\/(haltia|b8k)-(volume|rotate|portal|badges)$/ || $3 == "/usr/bin/pulseaudio") { print $1 }'); do
	kill "$pid" 2>/dev/null
done
if [ -x /usr/bin/haltia-focus ]; then
	setsid /usr/libexec/haltia/haltia-keep --session /usr/bin/haltia-focus watch >"$run"/haltia/focus-watch.log 2>&1 &
fi
# Notifications (org.freedesktop.Notifications): large cards at the top
# that buzz once; a tap opens what they are about.
if command -v mako >/dev/null && ! pgrep -x -u "$(id -u)" mako >/dev/null; then
	# The shell's notifications as Настройки set them (haltia-mako).
	mako_conf=/usr/share/haltia/mako.conf
	/usr/libexec/haltia/haltia-mako config && mako_conf=$run/haltia/mako.conf
	setsid mako -c "$mako_conf" >"$run"/mako.log 2>&1 &
fi
# Wi-Fi passwords: NetworkManager asks a secret agent, which GNOME keeps
# in its shell. Without one, a tap on a protected network in Settings
# does nothing. The session restarts with waybar; one agent is enough.
if command -v nm-applet >/dev/null && ! pgrep -x -u "$(id -u)" nm-applet >/dev/null; then
	setsid nm-applet >"$run"/nm-applet.log 2>&1 &
fi
if [ -x /usr/libexec/haltia/haltia-keyboard ]; then
	# Under haltia-keep: a keyboard that crashed left no way to type a
	# Wi-Fi password or a message until the session restarted. Only one
	# may run, and the keeper starts it again only after it has ended.
	pidof haltia-wvkbd >/dev/null 2>&1 || \
		setsid /usr/libexec/haltia/haltia-keep --session /usr/libexec/haltia/haltia-keyboard \
			>"$run"/haltia/keyboard.log 2>&1 &
elif [ -x /usr/bin/squeekboard ]; then
	squeekboard >"$run"/squeekboard.log 2>&1 &
fi
# Gestures from the screen's edges (lisgd): a swipe from the left edge
# brings a hidden panel back.
/usr/libexec/haltia/haltia-gestures normal
# Updates (haltia-update): a session that keeps restarting after an update
# rolls it back. Counted before the panel, which may be what fails; only
# while an update waits for its good mark (pending.json), as a Python start
# through doas costs half a second.
if [ -x /usr/libexec/haltia/haltia-update ] && [ -e /var/lib/haltia/update/pending.json ]; then
	doas -n /usr/libexec/haltia/haltia-update session-start >"$run"/haltia/update.log 2>&1
fi
# What the panel need not wait for starts once it is up: each of these is
# Python with GObject, 1-3 s of a core and the flash after a boot, which
# the panel's own start had to share. The launcher becomes waybar (exec
# below), so its comm says when the panel is starting; two more seconds let
# it draw first.
after_panel() {
	while [ "$(cat /proc/$$/comm 2>/dev/null)" != waybar ]; do
		[ -d /proc/$$ ] || return
		sleep 0.2
	done
	stamp panel
	sleep 2
	# The portal's stand-in, after the one of the last session has gone (it
	# held the bus name): with this session's environment.
	if [ -f "$run/dbus-1/services/org.freedesktop.portal.Desktop.service" ]; then
		setsid /usr/libexec/haltia/haltia-portal >"$run"/haltia/portal.log 2>&1 &
	fi
	# Volume keys. Without this nothing handles them, and a muted sink at 0%
	# has no way back.
	if [ -x /usr/libexec/haltia/haltia-volume ]; then
		setsid /usr/libexec/haltia/haltia-keep --session /usr/libexec/haltia/haltia-volume >"$run"/haltia/volume.log 2>&1 &
	fi
	# The screen follows the tablet: portrait on its side, turned over upside
	# down (off in Настройки → Экран).
	if [ -x /usr/bin/haltia-rotate ] && command -v wlr-randr >/dev/null; then
		setsid /usr/libexec/haltia/haltia-keep --session /usr/bin/haltia-rotate >"$run"/haltia/rotate.log 2>&1 &
	fi
	# Counts on buttons from programs' Unity LauncherEntry signals.
	if [ -x /usr/libexec/haltia/haltia-badges ]; then
		setsid /usr/libexec/haltia/haltia-keep --session /usr/libexec/haltia/haltia-badges >"$run"/haltia/badges.log 2>&1 &
	fi
	# Diagnostic reports for the helper: what goes wrong is noticed and, when
	# Настройки → «Для помощника» set an address, mailed through «Почта».
	if [ -x /usr/libexec/haltia/haltia-report ]; then
		setsid /usr/libexec/haltia/haltia-keep --session /usr/libexec/haltia/haltia-report watch >"$run"/haltia/report.log 2>&1 &
	fi
	# Сообщения (MAX) live in the background: messages buzz and the button
	# counts them with no window open. (Until the program brings an XDG
	# autostart file of its own; haltia-messenger was b8k-max.)
	max=
	for m in /usr/bin/haltia-messenger /usr/bin/b8k-max /usr/local/bin/b8k-max; do
		[ -x "$m" ] && max=$m && break
	done
	if [ -n "$max" ] && { [ -s "$HOME/.local/share/haltia-messenger/web.db" ] ||
		[ -s "$HOME/.local/share/b8k-max/web.db" ]; } &&
		[ ! -e /etc/xdg/autostart/io.github.haltia_de.Messenger.desktop ] &&
		[ ! -e /etc/xdg/autostart/io.github.trudenboy.Max.desktop ]; then
		setsid "$max" --background >"$run"/haltia/messenger.log 2>&1 &
	fi
	# Programs started in the background the standard way: XDG autostart
	# entries marked X-Haltia-Autostart=true, and one's own ~/.config/autostart.
	if [ -x /usr/bin/haltia-apps ]; then
		/usr/bin/haltia-apps autostart >"$run"/haltia/autostart.log 2>&1
	fi
	# A session that has run a minute marks an update good, once the checks
	# in /etc/haltia/health pass; then what haltia-update did by itself
	# (going back at boot or just now, updating while the screen was off)
	# as notifications that open «Обновления».
	if [ -x /usr/libexec/haltia/haltia-update ]; then
		(sleep 60; doas -n /usr/libexec/haltia/haltia-update health
			/usr/libexec/haltia/haltia-update-notify) >>"$run"/haltia/update.log 2>&1 &
		/usr/libexec/haltia/haltia-update-notify >>"$run"/haltia/update.log 2>&1 &
	fi
}
after_panel </dev/null >/dev/null 2>&1 &
# What the device or the person adds at session start (haltia-hook).
/usr/libexec/haltia/haltia-hook session-start
stamp waybar
# Firefox starts only from its button: running without a window it held
# 300-500 MB, and once its WebExtensions process filled the swap and froze
# the session.
if [ -n "$panel" ]; then
	exec waybar -c "$run"/haltia/waybar.json -s "$run"/haltia/style.css
fi
exec waybar -c /usr/share/haltia/waybar/config -s /usr/share/haltia/waybar/style.css
