#!/bin/sh
# Large questions: the power menu (a one-second hold of the power key) and
# "close this program?" (a tap on the program already in front).
#
#   haltia-ask power
#   haltia-ask screenshot        (the power menu's «Снимок экрана»: the screen
#                             into Изображения/Снимки экрана, then offered to
#                             the programs that take pictures)
#   haltia-ask close <id>
#   haltia-ask close-front       (the "✕" of haltia-close: the window in front)
#   haltia-ask pin <id>          (a long press on a home screen tile)
#   haltia-ask media <id>        (a tap on the button of a program in front
#                             that plays: pause or go on, stop)
#   haltia-ask restart <label>   (haltia-restart after an update: start the
#                             program again now? exit 0 for yes)
#   haltia-ask status            (the status card on the panel: the network,
#                             brightness and volume, sound off or on)
#   haltia-ask service           (the old «Служебные» tile, gone with 2.6: Settings, the touch
#                             settings, brightness, sound off or on,
#                             turning with the tablet on or off, the
#                             terminal)
#
# The question is a fuzzel menu (C, Wayland only) on the overlay layer: it
# shows in about 0.3 s, where the GTK version in Python took 2.3 s, and it
# is always on top, so nothing has to raise it. fuzzel takes taps as well
# as keys. A choice buzzes like the panel (haltia-press without a signal).
set -u
run=${XDG_RUNTIME_DIR:-$HOME/.cache}
APPS=/usr/share/haltia/apps.conf
# A session started by shell 1.x keeps its copy in $run/b8k until it restarts.
for a in "$run/haltia/apps.conf" "$run/b8k/apps.conf"; do
	[ -f "$a" ] && APPS=$a && break
done

# One question at a time; a second tap while one is open does nothing. The
# question after an update waits its turn instead: it must not count as yes.
exec 9>"$run/haltia/ask.lock" || exit 1
if [ "${1:-}" = restart ]; then
	flock 9 || exit 1
else
	flock -n 9 || exit 0
fi

# A value of one section of apps.conf.
conf() {
	awk -v sec="[$1]" -v key="$2" '
		/^\[/ { inside = ($0 == sec); next }
		inside && $0 ~ "^" key "[ \t]*=" {
			sub("^[^=]*=[ \t]*", ""); print; exit
		}' "$APPS"
}

# ask TITLE ITEM... -- prints the index of the chosen item, nothing on cancel.
# The last item, Отмена, is the one highlighted, so Enter never does harm.
# ASK_LINE (pt) overrides the config's line height, for a longer list.
ask() {
	title=$1
	shift
	printf '%s\n' "$@" | fuzzel --config /usr/share/haltia/fuzzel-ask.ini \
		${ASK_LINE:+--line-height=$ASK_LINE} --lines=$# \
		--dmenu --index --mesg "$title" --cache /dev/null --select-index $(($# - 1)) 2>/dev/null
}

chosen() {
	/usr/libexec/haltia/haltia-press ask >/dev/null 2>&1
}

# windows NAME...: how many windows have one of these app ids.
windows() {
	/usr/bin/haltia-focus list 2>/dev/null | awk -v names=" $* " 'index(names, " " $0 " ") { n++ } END { print n + 0 }'
}

# close_program ID LABEL APP_ID...: close a program that the person chose to
# close. The window is asked to close (the program may save first) under a
# curtain «Закрываю «…»…», so the tap shows at once. A program that has not
# closed within five seconds hangs: haltia-stop stops it, and it starts
# again in the background if it lives there. A new window of the program
# instead (a question such as «Сохранить?») means it answers: the curtain
# goes and the question is the person's.
close_program() {
	cid=$1 clabel=$2
	shift 2
	before=$(windows "$@")
	splash=
	if [ -x /usr/libexec/haltia/haltia-splash ]; then
		/usr/libexec/haltia/haltia-splash "$cid" "Закрываю «$clabel»…" >/dev/null 2>&1 &
		splash=$!
	fi
	/usr/bin/haltia-focus close "$@"
	end=$(($(date +%s) + 5))
	state=hangs
	while [ "$(date +%s)" -lt "$end" ]; do
		# Fewer windows: the one asked has closed (another window of the
		# program, Firefox's second one, may stay).
		n=$(windows "$@")
		if [ "$n" -lt "$before" ]; then
			state=closed
			break
		fi
		if [ "$n" -gt "$before" ]; then
			state=asks
			break
		fi
		sleep 0.3
	done
	if [ "$state" = hangs ]; then
		/usr/libexec/haltia/haltia-stop "$cid" "$@" >>"$run/haltia/stop.log" 2>&1
	fi
	[ -n "$splash" ] && kill "$splash" 2>/dev/null
	return 0
}

# pictures: the person's pictures folder (XDG_PICTURES_DIR of
# ~/.config/user-dirs.dirs, else ~/Изображения or ~/Pictures, whichever is
# there; Изображения for a new one).
pictures() {
	dir=$(sed -n 's/^XDG_PICTURES_DIR="\(.*\)"$/\1/p' "$HOME/.config/user-dirs.dirs" 2>/dev/null | tail -1)
	dir=$(printf '%s' "$dir" | sed "s|^\\\$HOME|$HOME|")
	if [ -z "$dir" ] || [ "$dir" = "$HOME" ]; then
		dir=$HOME/Изображения
		[ -d "$dir" ] || [ ! -d "$HOME/Pictures" ] || dir=$HOME/Pictures
	fi
	printf '%s\n' "$dir"
}

# screenshot: the screen now (the question that asked has gone: a moment for
# the compositor to draw without it) into the pictures folder's «Снимки
# экрана», then where to: a program that takes it, or done.
screenshot() {
	sleep 0.5
	dir=$(pictures)/Снимки\ экрана
	mkdir -p "$dir" || exit 1
	base=$dir/Снимок\ $(date +%Y-%m-%d\ %H-%M-%S)
	# Two in one second: «… (2).png», never over the first.
	file=$base.png n=2
	while [ -e "$file" ]; do
		file="$base ($n).png" n=$((n + 1))
	done
	if ! grim "$file" 2>/dev/null; then
		ask "Снимок экрана не получился" "Готово" >/dev/null
		exit 1
	fi
	/usr/libexec/haltia/haltia-press ask >/dev/null 2>&1
	# haltia-share: haltia_kit.share's rules (its own code when kit is there).
	targets=$(/usr/libexec/haltia/haltia-share targets "$file" 2>/dev/null)
	set --
	while IFS="$(printf '\t')" read -r _f name; do
		[ -n "$name" ] && set -- "$@" "Отправить: $name"
	done <<EOT
$targets
EOT
	pick=$(ask "Снимок сохранён в «${dir#"$HOME"/}»" "$@" "Готово")
	case $pick in
	'' | *[!0-9]*) exit 0 ;;
	esac
	[ "$pick" -lt $# ] || exit 0
	chosen
	id=$(printf '%s\n' "$targets" | sed -n "$((pick + 1))p" | cut -f1)
	# Started with the file's URI, as kit's share does: «Сообщения» opens
	# «Кому отправить?».
	/usr/libexec/haltia/haltia-share send "$id" "$file" >/dev/null 2>&1 9>&- &
}

# player ID: sets state (Playing or Paused) and bus (its MPRIS name) from
# haltia-badges' file, or fails when the program's player is not playing.
player() {
	state= bus=
	read -r state bus <"$run/haltia/play/$1" 2>/dev/null
	[ -n "$bus" ]
}

# power off|reboot: through the shell's doas rule, else logind (without
# that rule, on a system whose logind lets the session do it).
power() {
	doas -n /usr/libexec/haltia/haltia-poweroff "$1" 2>/dev/null && return
	case $1 in
	off) loginctl poweroff ;;
	*) loginctl reboot ;;
	esac
}

# mpris BUS METHOD: Play, Pause, PlayPause or Stop on that player.
mpris() {
	gdbus call --session --dest "$1" --object-path /org/mpris/MediaPlayer2 \
		--method "org.mpris.MediaPlayer2.Player.$2" >/dev/null 2>&1
}

# play_items: "Пауза" or "Продолжить", then "Стоп", for a program that plays.
play_items() {
	case $state in
	Playing) echo Пауза ;;
	*) echo Продолжить ;;
	esac
	echo Стоп
}

case ${1:-} in
power)
	# «USB: клавиатура» moved to Настройки → USB.
	case $(ask "Питание" "Выключить" "Перезагрузить" "Снимок экрана" "Отмена") in
	0) chosen; power off ;;
	1) chosen; power reboot ;;
	2) screenshot ;;
	esac
	;;
screenshot)
	screenshot
	;;
close)
	id=${2:-}
	[ -n "$id" ] || exit 2
	label=$(conf "$id" label)
	[ "$(ask "Закрыть «${label:-$id}»?" "Закрыть" "Отмена")" = 0 ] || exit 0
	chosen
	ids=$(conf "$id" app_ids)
	# shellcheck disable=SC2086 # the app_ids are separate words
	close_program "$id" "${label:-$id}" ${ids:-$id}
	;;
close-front)
	# A program still starting under its curtain is stopped at once: there
	# is nothing of it to lose yet.
	if read -r sid spid cpid <"$run/haltia/launch/starting" 2>/dev/null; then
		rm -f "$run/haltia/launch/starting"
		kill "$spid" "$cpid" 2>/dev/null
		/usr/libexec/haltia/haltia-close update 2>/dev/null
		exit 0
	fi
	# The window in front by its app id; its program's label when one of
	# apps.conf has that app id.
	app=$(cat "$run/haltia/launch/front" 2>/dev/null)
	[ -n "$app" ] || exit 0
	# The file chooser (haltia-files --portal): «✕» is its Отмена, nothing
	# to lose, so no question.
	if [ "$app" = io.github.haltia_de.FileChooser ]; then
		chosen
		/usr/bin/haltia-focus close "$app"
		exit 0
	fi
	id=$(awk -v app="$app" '
		/^\[/ { sec = $0; gsub(/[][ \t]/, "", sec); next }
		/^[ \t]*app_ids[ \t]*=/ {
			v = $0; sub(/^[^=]*=/, "", v); n = split(v, a, " ")
			for (i = 1; i <= n; i++) if (a[i] == app) { print sec; exit }
		}' "$APPS")
	label=
	[ -n "$id" ] && label=$(conf "$id" label)
	# Настройки → «Для помощника» may switch the question off
	# (~/.config/haltia/close.conf, ask = no): «✕» then closes at once, its
	# own tap having buzzed already.
	case $(sed -n 's/^[ \t]*ask[ \t]*=[ \t]*//p' "$HOME/.config/haltia/close.conf" 2>/dev/null | tail -1) in
	no | false | off | 0) ;;
	*)
		[ "$(ask "Закрыть «${label:-$app}»?" "Закрыть" "Отмена")" = 0 ] || exit 0
		chosen
		;;
	esac
	# Only the window in front is asked to close (a program's other
	# windows stay), but a hang stops the whole program.
	close_program "${id:-$app}" "${label:-$app}" "$app"
	;;
restart)
	[ "$(ask "Вышла новая версия «${2:-}». Перезапустить сейчас?" "Перезапустить" "Потом")" = 0 ] || exit 1
	chosen
	;;
media)
	id=${2:-}
	player "$id" || exit 0
	label=$(conf "$id" label)
	case $(ask "«${label:-$id}»" $(play_items) "Отмена") in
	0) chosen; mpris "$bus" PlayPause ;;
	1) chosen; mpris "$bus" Stop ;;
	esac
	;;
status)
	# The status card on the panel: the charge in the question, the network
	# by name, brightness and volume on one card, sound off or on.
	title="Состояние"
	info=$(/usr/libexec/haltia/haltia-meter battery-info)
	if [ -n "$info" ]; then
		title="Заряд ${info%% *} %"
		case ${info#* } in
		charging) title="$title, заряжается" ;;
		full) title="$title, заряжен" ;;
		esac
	fi
	net=$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null |
		awk -F: '$2 ~ /wireless/ { print $1; exit }')
	case $(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{ print $2 }') in
	yes | да) sound="Включить звук" ;;
	*) sound="Выключить звук" ;;
	esac
	case $(ask "$title" "Сеть: ${net:-нет}" "Яркость и громкость" "$sound" "Отмена") in
	0)
		chosen
		# Настройки at their network page: a running one turns to it (one
		# instance, GApplication), a new one starts there.
		if /usr/bin/haltia-focus has io.github.haltia_de.Settings >/dev/null 2>&1; then
			/usr/bin/haltia-settings --page network >/dev/null 2>&1 9>&- &
		fi
		HALTIA_LAUNCH_ARGS="--page network" /usr/bin/haltia-launch tap settings 9>&-
		;;

	1) chosen; /usr/bin/haltia-brightness 9>&- & ;;
	2)
		chosen
		pactl set-sink-mute @DEFAULT_SINK@ toggle
		/usr/bin/haltia-panel-signal 10 2>/dev/null
		;;
	esac
	;;
service)
	# What the person rarely needs, in one place: each opens over the home
	# screen like a tile does (haltia-launch tap lowers it).
	set -- settings touch brightness sound rotate term
	command -v wlr-randr >/dev/null && [ -x /usr/bin/haltia-rotate ] || set -- settings touch brightness sound term
	case $(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{ print $2 }') in
	yes | да) sound="Включить звук" ;;
	*) sound="Выключить звук" ;;
	esac
	case $(/usr/bin/haltia-rotate status 2>/dev/null) in
	off) rotate="Включить поворот" ;;
	*) rotate="Выключить поворот" ;;
	esac
	labels=
	for id in "$@"; do
		case $id in
		brightness) l="Яркость и громкость" ;;
		sound) l=$sound ;;
		rotate) l=$rotate ;;
		*) l=$(conf "$id" label) ;;
		esac
		labels="$labels${labels:+
}${l:-$id}"
	done
	IFS='
'
	# shellcheck disable=SC2086 # one label per line
	# Up to seven rows: closer than the power menu's, to fit 800 px.
	n=$(ASK_LINE=$((46 - 6 * ($# > 5))) ask "Служебные" $labels "Отмена")
	unset IFS
	[ -n "$n" ] && [ "$n" -lt $# ] || exit 0
	shift "$n"
	chosen
	case $1 in
	brightness) /usr/bin/haltia-brightness 9>&- & ;;
	sound)
		pactl set-sink-mute @DEFAULT_SINK@ toggle
		/usr/bin/haltia-panel-signal 10 2>/dev/null
		;;
	rotate) /usr/bin/haltia-rotate toggle ;;
	*) /usr/bin/haltia-launch tap "$1" 9>&- ;;
	esac
	;;
pin)
	id=${2:-}
	[ -n "$id" ] || exit 2
	label=$(conf "$id" label)
	sig=$(conf "$id" signal)
	if [ "${sig:-0}" -gt 0 ] 2>/dev/null; then
		item="Убрать с панели" verb=unpin
	else
		item="Закрепить на панели" verb=pin
	fi
	if player "$id"; then
		# A program that plays: its pause and stop come first.
		case $(ask "«${label:-$id}»" $(play_items) "$item" "Отмена") in
		0) chosen; mpris "$bus" PlayPause ;;
		1) chosen; mpris "$bus" Stop ;;
		2) chosen; /usr/bin/haltia-apps "$verb" "$id" >/dev/null ;;
		esac
		exit 0
	fi
	[ "$(ask "«${label:-$id}»" "$item" "Отмена")" = 0 ] || exit 0
	chosen
	/usr/bin/haltia-apps "$verb" "$id" >/dev/null
	;;
*)
	echo "usage: haltia-ask power | status | service | haltia-ask close|pin|media <id>" >&2
	exit 2
	;;
esac
