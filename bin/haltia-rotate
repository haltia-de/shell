#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""The screen follows the tablet: turned on its side it goes portrait,
turned over it turns over too.

    haltia-rotate                 watch the accelerometer (haltia-launcher runs it)
    haltia-rotate on|off|toggle   turn following on or off (Настройки → Экран)
    haltia-rotate status          print on or off

It asks iio-sensor-proxy (net.hadess.SensorProxy on the system bus, as
Phosh and GNOME do) a few times a second which way the tablet stands. Where
that service is missing or will not let this session claim the sensor, it
reads the accelerometer of the IIO subsystem itself (the first device with
in_accel_x_raw, or accelerometer=<name> in /etc/haltia/device.conf) and
puts it into the screen's frame with the device's in_mount_matrix. It turns
the output (the first one wlr-randr lists, or
output=<name> there) through wlr-output-management (wlr-randr) once the
tablet has stood the new way for a second. Lying flat, or half way between
two ways, it keeps what it has. With the screen off it reads seldom.

Between landscape and portrait it moves the panel too: it writes the
orientation to $XDG_RUNTIME_DIR/haltia/orientation, haltia-apps writes the
panel's files for it (along the bottom edge in portrait), and waybar
rereads them on SIGUSR2, sent only once waybar catches it (an uncaught
SIGUSR2 would end waybar, and with it the session). A panel hidden by
haltia-tab comes back first.

"off" (kept in ~/.config/haltia/rotate) turns the screen back to normal and
leaves it there.
"""
import math
import os
import signal
import subprocess
import sys


_panel = None


def panel():
    """haltia-panel-signal as a module (loaded on first use): signalling
    the panel, the one way."""
    global _panel
    if _panel is None:
        import importlib.machinery
        import importlib.util
        here = os.path.dirname(os.path.realpath(__file__))
        for path in (os.path.join(here, "haltia-panel-signal"),
                     os.path.join(here, "..", "bin", "haltia-panel-signal"),
                     "/usr/bin/haltia-panel-signal"):
            if os.path.exists(path):
                loader = importlib.machinery.SourceFileLoader("haltia_panel_signal", path)
                spec = importlib.util.spec_from_loader("haltia_panel_signal", loader)
                _panel = importlib.util.module_from_spec(spec)
                loader.exec_module(_panel)
                break
        else:
            raise OSError("haltia-panel-signal is missing")
    return _panel
import time

DEVICE_CONF = "/etc/haltia/device.conf"
SAVED = os.path.join(os.path.expanduser("~"), ".config", "haltia", "rotate")
RUN = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
PIDFILE = os.path.join(RUN, "haltia/rotate.pid")
IIO = "/sys/bus/iio/devices"
PERIOD = 0.3      # seconds between readings with the screen on
DARK_PERIOD = 2.0  # and with it off
STEADY = 1.0      # seconds the tablet stands the new way before the turn
FLAT = 0.45       # g: less than this in the screen's plane is lying flat
CLEAR = 1.4       # one axis this many times the other, or it is half way
G = 9.80665

# The way the tablet stands -> the output's transform that keeps the
# picture upright (wlr-randr --transform). Measured on the B8000-H: upright
# in landscape the screen's y reads -1 g, as iio-sensor-proxy expects.
TRANSFORMS = {"normal": "normal", "left-up": "90", "bottom-up": "180", "right-up": "270"}
ORIENTATION = os.path.join(RUN, "haltia", "orientation")
# The output's transform as it is now (normal, 90, 180, 270), for programs
# that turn a camera's picture with the screen (calls, «Камера»): GTK 3 does
# not tell them. Written on start and after every turn.
ROTATION = os.path.join(RUN, "haltia", "rotation")


def log(msg):
    print("haltia-rotate: " + msg, flush=True)


def device_conf(key):
    try:
        with open(DEVICE_CONF) as fh:
            for line in fh:
                name, sep, val = line.partition("=")
                if sep and name.strip() == key:
                    return val.strip()
    except OSError:
        pass
    return ""


def read(path, default=None):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def find_accel():
    want = device_conf("accelerometer")
    try:
        nodes = sorted(os.listdir(IIO))
    except OSError:
        return None
    for node in nodes:
        path = os.path.join(IIO, node)
        if not os.path.exists(os.path.join(path, "in_accel_x_raw")):
            continue
        if want and read(os.path.join(path, "name")) != want:
            continue
        return path
    return None


def mount_matrix(path):
    """The rows of in_mount_matrix ("a, b, c; d, e, f; g, h, i"), the
    identity when the device has none."""
    raw = read(os.path.join(path, "in_mount_matrix")) or read(os.path.join(path, "mount_matrix"))
    try:
        rows = [[float(v) for v in row.split(",")] for row in raw.split(";")]
        if len(rows) == 3 and all(len(r) == 3 for r in rows):
            return rows
    except (AttributeError, ValueError):
        pass
    return [[1, 0, 0], [0, 1, 0], [0, 0, 1]]


def gravity(path, matrix):
    """The acceleration in the screen's frame, in g, or None."""
    try:
        scale = float(read(os.path.join(path, "in_accel_scale"), "1"))
        raw = [float(read(os.path.join(path, "in_accel_%s_raw" % a))) for a in "xyz"]
    except (TypeError, ValueError):
        return None
    v = [sum(m * r for m, r in zip(row, raw)) * scale / G for row in matrix]
    return v


def classify(v):
    """The way the tablet stands, or None while it lies flat or is half way."""
    x, y = v[0], v[1]
    if math.hypot(x, y) < FLAT:
        return None
    if abs(y) > CLEAR * abs(x):
        return "normal" if y < 0 else "bottom-up"
    if abs(x) > CLEAR * abs(y):
        return "left-up" if x > 0 else "right-up"
    return None


def backlight_dark():
    root = "/sys/class/backlight"
    name = device_conf("backlight")
    if not name:
        try:
            name = sorted(os.listdir(root))[0]
        except (OSError, IndexError):
            return False
    return read(os.path.join(root, name, "brightness"), "1") == "0"


def output_name():
    name = device_conf("output")
    if name:
        return name
    try:
        out = subprocess.run(["wlr-randr"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        if line and not line[0].isspace():
            return line.split()[0]
    return None


def current_transform(output):
    """The output's transform from wlr-randr ("normal", "90"...), or None."""
    try:
        out = subprocess.run(["wlr-randr"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    mine = False
    for line in out.splitlines():
        if line and not line[0].isspace():
            mine = line.split()[0] == output
        elif mine and line.strip().startswith("Transform:"):
            return line.split(":", 1)[1].strip()
    return None


def write_rotation(transform):
    """ROTATION, one word, replaced at once (a program watching it reads it
    whole)."""
    if transform not in TRANSFORMS.values():
        return
    try:
        os.makedirs(os.path.dirname(ROTATION), exist_ok=True)
        with open(ROTATION + ".new", "w") as fh:
            fh.write(transform + "\n")
        os.replace(ROTATION + ".new", ROTATION)
    except OSError as exc:
        log("rotation: %s" % exc)


def turn(output, way):
    try:
        res = subprocess.run(["wlr-randr", "--output", output, "--transform", transform_of(way)],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        log("wlr-randr: %s" % exc)
        return False
    if res.returncode:
        log("wlr-randr: %s" % (res.stderr.strip() or res.returncode))
        return False
    log("turned %s" % way)
    write_rotation(transform_of(way))
    # The edge gestures follow the picture.
    subprocess.call(["/usr/libexec/haltia/haltia-gestures", transform_of(way)])
    return True


def transform_of(way):
    """The output transform for a way the tablet stands. transform_offset=
    in /etc/haltia/device.conf (degrees, default 0) is added for a panel
    that does not scan out in the tablet's landscape: the Tab P11's is
    portrait, so it says 270."""
    try:
        offset = int(device_conf("transform_offset") or 0)
    except ValueError:
        offset = 0
    degrees = {"normal": 0, "left-up": 90, "bottom-up": 180, "right-up": 270}[way]
    turned = (degrees + offset) % 360
    return "normal" if turned == 0 else str(turned)


def orientation_of(way):
    return "portrait" if way in ("left-up", "right-up") else "landscape"


def pids_of(name):
    """The processes running /usr/bin/<name> (C) or python3 with it."""
    found = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as fh:
                args = fh.read().split(b"\0")
        except OSError:
            continue
        if any(os.path.basename(a) == name.encode() for a in args[:2]):
            found.append(int(pid))
    return found


def move_panel(orientation):
    """Writes the panel's files for the orientation; True when done."""
    os.makedirs(os.path.dirname(ORIENTATION), exist_ok=True)
    with open(ORIENTATION + ".new", "w") as fh:
        fh.write(orientation + "\n")
    os.replace(ORIENTATION + ".new", ORIENTATION)
    for pid in pids_of("haltia-tab"):
        try:
            os.kill(pid, signal.SIGTERM)  # it shows the panel as it ends
        except OSError:
            pass
    try:
        res = subprocess.run(["/usr/bin/haltia-apps", "panel"], capture_output=True, text=True,
                             timeout=30)
    except (OSError, subprocess.SubprocessError) as exc:
        log("haltia-apps: %s" % exc)
        return False
    if res.returncode:
        log("haltia-apps: %s" % (res.stderr.strip() or res.returncode))
        return False
    log("panel for %s" % orientation)
    subprocess.call(["/usr/libexec/haltia/haltia-hook", "orientation", orientation])
    # The home button's arrow points at the panel: left, or down in portrait.
    try:
        subprocess.call(["/usr/libexec/haltia/haltia-close", "update"])
    except OSError:
        pass
    return True


def reload_panel():
    """SIGUSR2 to waybar, once it catches it; False to try again later."""
    try:
        return panel().reload()
    except OSError:
        return False


def enabled():
    return read(SAVED, "on") != "off"


class SensorProxy:
    """The way the tablet stands from iio-sensor-proxy, or None where it is
    not to be had (no service, no accelerometer, the claim refused)."""
    WAYS = ("normal", "bottom-up", "left-up", "right-up")

    def __init__(self):
        self.bus = None
        try:
            import gi
            gi.require_version("Gio", "2.0")
            from gi.repository import Gio, GLib
            self.GLib = GLib
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            if not self.get(bus, "HasAccelerometer"):
                return
            bus.call_sync("net.hadess.SensorProxy", "/net/hadess/SensorProxy",
                          "net.hadess.SensorProxy", "ClaimAccelerometer", None, None,
                          Gio.DBusCallFlags.NONE, 3000, None)
            self.bus = bus
        except Exception as exc:  # ImportError, GLib.Error
            log("iio-sensor-proxy: %s" % getattr(exc, "message", exc))

    def get(self, bus, name):
        v = bus.call_sync("net.hadess.SensorProxy", "/net/hadess/SensorProxy",
                          "org.freedesktop.DBus.Properties", "Get",
                          self.GLib.Variant("(ss)", ("net.hadess.SensorProxy", name)),
                          None, 0, 3000, None)
        return v.unpack()[0]

    def way(self):
        try:
            w = self.get(self.bus, "AccelerometerOrientation")
        except Exception:
            return None
        return w if w in self.WAYS else None


def watch():
    output = output_name()
    if not output:
        log("no output (wlr-randr)")
        return 0
    write_rotation(current_transform(output) or "normal")
    proxy = SensorProxy()
    accel = matrix = None
    if proxy.bus:
        log("iio-sensor-proxy, output %s" % output)
    else:
        accel = find_accel()
        if not accel:
            log("no accelerometer")
            return 0
        matrix = mount_matrix(accel)
        log("%s (%s), output %s" % (accel, read(os.path.join(accel, "name")), output))
    with open(PIDFILE, "w") as fh:
        fh.write("%d\n" % os.getpid())
    changed = [True]
    signal.signal(signal.SIGUSR1, lambda *_a: changed.__setitem__(0, True))
    signal.signal(signal.SIGTERM, lambda *_a: sys.exit(0))
    shown, candidate, since, on = None, None, 0.0, None
    panel, reload = "landscape", False  # haltia-launcher starts with landscape
    while True:
        if changed[0]:
            changed[0] = False
            on = enabled()
            if not on and shown != "normal":
                shown = "normal" if turn(output, "normal") else shown
            candidate = None
        if shown and orientation_of(shown) != panel and move_panel(orientation_of(shown)):
            panel, reload = orientation_of(shown), True
        if reload:
            reload = not reload_panel()
        if not on:
            time.sleep(DARK_PERIOD)
            continue
        if backlight_dark():
            candidate = None
            time.sleep(DARK_PERIOD)
            continue
        if proxy.bus:
            way = proxy.way()
        else:
            v = gravity(accel, matrix)
            way = classify(v) if v else None
        now = time.monotonic()
        if way is None or way == shown:
            candidate = None
        elif way != candidate:
            candidate, since = way, now
        elif now - since >= STEADY:
            if turn(output, way):
                shown = way
            candidate = None
        time.sleep(PERIOD)


def tell():
    try:
        with open(PIDFILE) as fh:
            os.kill(int(fh.read().strip()), signal.SIGUSR1)
    except (OSError, ValueError):
        pass


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "watch"
    if arg == "watch":
        return watch()
    if arg == "status":
        print("on" if enabled() else "off")
        return 0
    if arg in ("on", "off", "toggle"):
        state = ("off" if enabled() else "on") if arg == "toggle" else arg
        os.makedirs(os.path.dirname(SAVED), exist_ok=True)
        with open(SAVED + ".new", "w") as fh:
            fh.write(state + "\n")
        os.replace(SAVED + ".new", SAVED)
        tell()
        return 0
    sys.stderr.write("usage: haltia-rotate [watch | on | off | toggle | status]\n")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
