#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
# Brightness and volume: two large sliders on one card, opened from the
# panel's status card («Состояние»); Настройки → Экран has the same slider.
# The chosen level is kept in ~/.config/haltia/brightness; --restore sets it
# again at session start (haltia-launcher) without opening the window.
# The level goes through logind (Session.SetBrightness), so no root is
# needed; the dialog redraws while the slider moves, and that frame is
# what makes the BLS take the new duty at once. The volume goes to the
# PulseAudio default sink (pactl, at most 100 %, unmuted when moved), and
# the panel's speaker is told (haltia-panel-signal 10).
# The dialog is a card on the overlay layer (gtk-layer-shell), drawn like
# the questions of haltia-ask: always on top, so nothing has to raise it.
import fcntl
import os
import struct
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, Gio, GLib, GObject, Gtk, GtkLayerShell  # noqa: E402

DEVICE_CONF = "/etc/haltia/device.conf"


def backlight_name():
    """The device's lamp: backlight= in /etc/haltia/device.conf, else the
    first one in /sys/class/backlight (haltia-sleep looks it up alike)."""
    try:
        with open(DEVICE_CONF) as fh:
            for line in fh:
                key, sep, val = line.partition("=")
                if sep and key.strip() == "backlight" and val.strip():
                    return val.strip()
    except OSError:
        pass
    try:
        return sorted(os.listdir("/sys/class/backlight"))[0]
    except (OSError, IndexError):
        return ""


BACKLIGHT = backlight_name()
SYSFS = "/sys/class/backlight/%s" % BACKLIGHT
LOWEST = 10  # never black: the slider must stay visible
SAVED = os.path.join(os.path.expanduser("~"), ".config", "haltia", "brightness")

CSS = b"""
window { background-color: transparent; }
.card {
  background-color: #242424;
  border: 2px solid #3a3a3a;
  border-radius: 16px;
}
label { color: #9a9996; font-size: 35px; }
button label { color: #ffffff; }
scale trough {
  min-height: 24px;
  border-radius: 12px;
  background-color: #3a3a3a;
  border: none;
}
scale highlight { background-color: #3584e4; border-radius: 12px; border: none; }
scale slider {
  min-width: 64px;
  min-height: 64px;
  border-radius: 32px;
  background-color: #ffffff;
  border: none;
  box-shadow: none;
}
button {
  font-size: 35px;
  min-height: 80px;
  border-radius: 12px;
  background: #3a3a3a;
  color: #ffffff;
  border: none;
  box-shadow: none;
}
"""


class Buzz:
    # struct ff_effect is 44 bytes with 32-bit longs, 48 with 64-bit ones.
    SIZE = 0x2C if struct.calcsize("l") == 4 else 0x30
    EVIOCSFF = 0x40000000 | (SIZE << 16) | (ord("E") << 8) | 0x80

    def __init__(self, ms=70):
        self.fd = -1
        try:
            for node in sorted(os.listdir("/sys/class/input")):
                if not node.startswith("event"):
                    continue
                with open("/sys/class/input/%s/device/name" % node) as fh:
                    if fh.read().strip() != "regulator-haptic":
                        continue
                self.fd = os.open("/dev/input/" + node, os.O_RDWR | os.O_CLOEXEC)
                buf = bytearray(struct.pack("<HhHHHHHHH", 0x50, -1, 0, 0, 0, ms, 0,
                                            0xFFFF, 0xFFFF))
                buf += bytes(self.SIZE - len(buf))
                fcntl.ioctl(self.fd, self.EVIOCSFF, buf)
                self.effect = struct.unpack_from("<h", buf, 2)[0]
                break
        except OSError:
            self.fd = -1

    def __call__(self, *_args):
        if self.fd >= 0:
            try:
                os.write(self.fd, struct.pack("llHHi", 0, 0, 0x15, self.effect, 1))
            except OSError:
                pass
        return True


def read_int(path, default):
    try:
        with open(path) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return default


def volume():
    """The default sink's volume in percent, or None without PulseAudio."""
    try:
        out = subprocess.run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"],
                             capture_output=True, text=True, timeout=5).stdout
        return int(out.split("/")[1].strip().rstrip("%"))
    except (OSError, subprocess.SubprocessError, IndexError, ValueError):
        return None


def set_volume(level):
    for args in (["set-sink-volume", "@DEFAULT_SINK@", "%d%%" % level],
                 ["set-sink-mute", "@DEFAULT_SINK@", "0" if level > 0 else "1"]):
        subprocess.call(["pactl"] + args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.call(["/usr/bin/haltia-panel-signal", "10"], stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)


def save(level):
    try:
        os.makedirs(os.path.dirname(SAVED), exist_ok=True)
        tmp = SAVED + ".new"
        with open(tmp, "w") as fh:
            fh.write("%d\n" % level)
        os.replace(tmp, SAVED)
    except OSError as exc:
        sys.stderr.write("haltia-brightness: cannot save: %s\n" % exc)


def session_paths():
    yield "/org/freedesktop/login1/session/auto"
    sid = os.environ.get("XDG_SESSION_ID")
    if sid:
        # Object paths escape every byte that is not [A-Za-z0-9] as _xx.
        esc = "".join(c if c.isalnum() else "_%02x" % ord(c) for c in sid)
        yield "/org/freedesktop/login1/session/" + esc


class Brightness:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.path = None
        self.pending = None

    def set(self, level):
        args = GLib.Variant("(ssu)", ("backlight", BACKLIGHT, int(level)))
        paths = [self.path] if self.path else list(session_paths())
        for path in paths:
            try:
                self.bus.call_sync("org.freedesktop.login1", path,
                                   "org.freedesktop.login1.Session",
                                   "SetBrightness", args, None,
                                   Gio.DBusCallFlags.NONE, -1, None)
                self.path = path
                return
            except GLib.Error as exc:
                sys.stderr.write("haltia-brightness: %s: %s\n" % (path, exc.message))


DARK = "/run/haltia/screen-dark"


def restore():
    """The kept level, at a session start. Not while haltia-sleep keeps the
    screen off (a session restarted at night): a lit screen with the touch
    still grabbed ignored every finger until the power key."""
    if not BACKLIGHT or os.path.exists(DARK):
        return 0
    level = read_int(SAVED, 0)
    if level >= LOWEST:
        Brightness().set(min(level, read_int(SYSFS + "/max_brightness", 255)))
    return 0


def main():
    GLib.set_prgname("io.github.haltia_de.Shell")
    if sys.argv[1:] == ["--restore"]:
        return restore()
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                             "haltia/brightness.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # already open, and on top

    sound = volume()
    if not BACKLIGHT and sound is None:
        sys.stderr.write("haltia-brightness: no backlight and no sound\n")
        return 1
    top = read_int(SYSFS + "/max_brightness", 255)
    now = read_int(SYSFS + "/brightness", top // 2)
    light = Brightness()

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    buzz = Buzz()
    Gtk.Button()  # the "pressed" signal exists once the class is set up
    GObject.add_emission_hook(Gtk.Button, "pressed", buzz)

    win = Gtk.Window(title="Яркость и громкость")
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)  # round corners over whatever is below
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_namespace(win, "haltia-brightness")
    # 800 px, or less when the screen stands portrait (haltia-rotate).
    try:
        room = win.get_display().get_monitor(0).get_geometry().width - 160
    except AttributeError:
        room = 800
    win.set_size_request(max(400, min(800, room)), -1)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28)
    box.get_style_context().add_class("card")
    for side in ("start", "end", "top", "bottom"):
        getattr(box, "set_margin_" + side)(0)
    inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28)
    inner.set_margin_top(28)
    inner.set_margin_bottom(28)
    inner.set_margin_start(32)
    inner.set_margin_end(32)
    box.pack_start(inner, True, True, 0)
    def slider(label, lo, hi, value):
        inner.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
        s.set_draw_value(False)
        s.set_value(value)
        s.connect("button-press-event", lambda *_a: buzz() and False)
        inner.pack_start(s, True, True, 0)
        return s

    scale = slider("Яркость", LOWEST, top, max(LOWEST, now)) if BACKLIGHT else None
    loud = slider("Громкость", 0, 100, sound) if sound is not None else None
    loud_pending = [None]

    def apply_volume():
        set_volume(int(loud.get_value()))
        loud_pending[0] = None
        return False

    def volume_changed(_scale):
        if loud_pending[0] is None:
            loud_pending[0] = GLib.timeout_add(120, apply_volume)

    if loud:
        loud.connect("value-changed", volume_changed)

    def apply():
        light.set(scale.get_value())
        save(int(scale.get_value()))
        light.pending = None
        return False

    def changed(_scale):
        # Coalesce a drag into one call every 60 ms.
        if light.pending is None:
            light.pending = GLib.timeout_add(60, apply)

    if scale:
        scale.connect("value-changed", changed)

    done = Gtk.Button(label="Готово")
    done.connect("clicked", lambda _b: Gtk.main_quit())
    inner.pack_start(done, False, False, 0)

    win.connect("destroy", Gtk.main_quit)
    win.add(box)
    win.show_all()
    Gtk.main()
    if light.pending is not None:
        apply()
    if loud_pending[0] is not None:
        apply_volume()
    return 0


if __name__ == "__main__":
    sys.exit(main())
